// ---- Operators (formula plan, part 1; Snips' Compute.arith, compare, concat) ----
//
// On numbers as a spreadsheet: / by 0 is #DIV/0!, % takes the divisor's sign (-1 % 3 is 2, as
// Excel's MOD), ^ is a power. Where a matrix is in it, linear algebra's rules: + and - take two
// of one shape, item by item; * of two is their product (A's columns as many as B's rows), and
// of a matrix and a number scales it; / takes a matrix and a number; ^ a square matrix and a
// whole number from 0; anything else is #VALUE!. An error on either side is the result.
// Comparisons: where either side is text that is not a number, as text without regard to case,
// a number before any word and empty as ""; else as numbers, equal within 10^-12 of the larger
// (so 0.1 + 0.2 = 0.3). & joins the two as they are shown.

fun __fxArith(op : string, a : FormulaValue, b : FormulaValue) : FormulaValue {
  if (a is ErrorValue) { return a }
  if (b is ErrorValue) { return b }
  if (a is MatrixValue or b is MatrixValue) { return __fxMatrixArith(op, a, b) }
  return __fxScalarArith(op, a, b)
}

fun __fxScalarArith(op : string, a : FormulaValue, b : FormulaValue) : FormulaValue {
  try {
    val x = __fxNumber(a)
    val y = __fxNumber(b)
    return when (op) {
      "+" -> NumberValue(x + y)
      "-" -> NumberValue(x - y)
      "*" -> NumberValue(x * y)
      "^" -> NumberValue(Math.pow(x, y).toFloat())
      "/" -> y == 0.0 ? ErrorValue.divideByZero() : NumberValue(x / y)
      "%" -> y == 0.0 ? ErrorValue.divideByZero() : NumberValue(((x % y) + y) % y)
      else -> ErrorValue.syntax()
    }
  } catch (e : FormulaException) {
    return e.error
  }
}

fun __fxMatrixArith(op : string, a : FormulaValue, b : FormulaValue) : FormulaValue {
  val am = a is MatrixValue ? a as MatrixValue : null
  val bm = b is MatrixValue ? b as MatrixValue : null
  if (op == "+" or op == "-") {
    if (am != null and bm != null and am!!.rowCount == bm!!.rowCount and am!!.columnCount == bm!!.columnCount) {
      return __fxBroadcast(a, b) { x, y -> __fxScalarArith(op, x, y) }
    }
    return ErrorValue.value()
  }
  if (op == "*") {
    if (am != null and bm != null) { return am!!.columnCount == bm!!.rowCount ? __fxMatrixProduct(am!!, bm!!) : ErrorValue.value() }
    return __fxBroadcast(a, b) { x, y -> __fxScalarArith("*", x, y) }
  }
  if (op == "/") {
    if (am != null and bm == null) { return __fxBroadcast(a, b) { x, y -> __fxScalarArith("/", x, y) } }
    return ErrorValue.value()
  }
  if (op == "^") {
    if (am != null and bm == null) { return __fxMatrixPower(am!!, __fxNumber(b)) }
    return ErrorValue.value()
  }
  return ErrorValue.value()
}

fun __fxBroadcast(a : FormulaValue, b : FormulaValue, f : (FormulaValue, FormulaValue) -> FormulaValue) : FormulaValue {
  if (a is MatrixValue and b is MatrixValue) {
    val am = a as MatrixValue
    val bm = b as MatrixValue
    if (am.rowCount != bm.rowCount or am.columnCount != bm.columnCount) { return ErrorValue.value() }
    val rows : open List<List<FormulaValue>> = []
    for (i in 0 ..< am.rows.size) {
      val row : open List<FormulaValue> = []
      for (j in 0 ..< am.rows[i].size) { row.add(f(am.rows[i][j], bm.rows[i][j])) }
      rows.add(row)
    }
    return MatrixValue(rows)
  }
  if (a is MatrixValue) { return MatrixValue((a as MatrixValue).rows.map { row -> row.map { f(it, b) } }) }
  if (b is MatrixValue) { return MatrixValue((b as MatrixValue).rows.map { row -> row.map { f(a, it) } }) }
  return f(a, b)
}

// The product of two matrices; #VALUE! where a's columns are not as many as b's rows. An item
// that is no number is a FormulaException.
fun __fxMatrixProduct(a : MatrixValue, b : MatrixValue) : FormulaValue {
  if (a.columnCount != b.rowCount) { return ErrorValue.value() }
  val rows : open List<List<FormulaValue>> = []
  for (i in 0 ..< a.rowCount) {
    val row : open List<FormulaValue> = []
    for (j in 0 ..< b.columnCount) {
      var s = 0.0
      for (k in 0 ..< a.columnCount) { s += __fxNumber(a.rows[i][k]) * __fxNumber(b.rows[k][j]) }
      row.add(NumberValue(s))
    }
    rows.add(row)
  }
  return MatrixValue(rows)
}

// A square matrix to a whole power from 0: the identity times it, that many times.
fun __fxMatrixPower(m : MatrixValue, p : float) : FormulaValue {
  if (m.rowCount != m.columnCount) { return ErrorValue.value() }
  if (p != __fxFloor(p) or p < 0.0) { return ErrorValue.value() }
  val identity : open List<List<FormulaValue>> = []
  for (i in 0 ..< m.rowCount) {
    val row : open List<FormulaValue> = []
    for (j in 0 ..< m.rowCount) { row.add(NumberValue(i == j ? 1.0 : 0.0)) }
    identity.add(row)
  }
  var result : FormulaValue = MatrixValue(identity)
  for (i in 0 ..< p.toInt()) { result = __fxMatrixProduct(result as MatrixValue, m) }
  return result
}

fun __fxConcat(a : FormulaValue, b : FormulaValue) : FormulaValue {
  if (a is ErrorValue) { return a }
  if (b is ErrorValue) { return b }
  return TextValue(a.toString() + b.toString())
}

fun __fxCompare(op : string, a : FormulaValue, b : FormulaValue) : FormulaValue {
  if (a is ErrorValue) { return a }
  if (b is ErrorValue) { return b }
  val order = __fxTextOrder(a, b)
  if (order != null) {
    val c = order!!
    return when (op) {
      "=" -> BoolValue(c == 0)
      "≠" -> BoolValue(c != 0)
      "<" -> BoolValue(c < 0)
      ">" -> BoolValue(c > 0)
      "≤" -> BoolValue(c <= 0)
      "≥" -> BoolValue(c >= 0)
      else -> ErrorValue.syntax()
    }
  }
  try {
    val x = __fxNumber(a)
    val y = __fxNumber(b)
    val equal = __fxNearlyEqual(x, y)
    return when (op) {
      "=" -> BoolValue(equal)
      "≠" -> BoolValue(!equal)
      "<" -> BoolValue(x < y and !equal)
      ">" -> BoolValue(x > y and !equal)
      "≤" -> BoolValue(x < y or equal)
      "≥" -> BoolValue(x > y or equal)
      else -> ErrorValue.syntax()
    }
  } catch (e : FormulaException) {
    return e.error
  }
}

// How a compares with b where either is text that is not a number; null to compare them as
// numbers.
fun __fxTextOrder(a : FormulaValue, b : FormulaValue) : int? {
  val ta = a is TextValue and __fxJavaDouble((a as TextValue).value) == null ? (a as TextValue).value : null
  val tb = b is TextValue and __fxJavaDouble((b as TextValue).value) == null ? (b as TextValue).value : null
  if (ta == null and tb == null) { return null }
  if (ta != null and tb != null) { return ta!!.compareTo(tb!!, true) }
  if (ta != null) { return b == EmptyValue ? ta!!.compareTo("", true) : 1 }
  return a == EmptyValue ? "".compareTo(tb!!, true) : -1
}

// Equal within 10^-12 of the larger (or of 1), so rounding's noise is not a difference.
fun __fxNearlyEqual(x : float, y : float) : bool {
  if (x == y) { return true }
  return Math.abs(x - y) <= 1.0e-12 * Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)))
}

// A function's result that is not a finite number is #NUM!, so IFERROR and ISERROR see it.
fun __fxFinite(v : FormulaValue) : FormulaValue {
  if (v is NumberValue) {
    val n = (v as NumberValue).value
    if (n.isNaN() or n == 1.0 / 0.0 or n == -1.0 / 0.0) { return ErrorValue("#NUM!", "not a finite number") }
  }
  return v
}

// The largest whole number not over x, as a float (Math.floor gives an int, which ends at 2^63).
fun __fxFloor(x : float) : float {
  if (x.isNaN() or Math.abs(x) >= 4503599627370496.0) { return x }
  val t = Math.trunc(x)
  return t > x ? t - 1.0 : t
}
