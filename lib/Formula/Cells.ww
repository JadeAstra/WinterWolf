// ---- Cell references (formula plan, part 1; Snips' Cells.kt) ----
//
//   CellRef.columnIndex("AA")      // 26
//   CellRef.columnName(26)         // "AA"
//   CellRef.parse("$B$4")          // CellRef(1, 3, true, true)
//   CellRef.parse("A")             // a whole column: CellRef(0, null)
//   CellRef.parse("c1r1")          // A1, in Snips' hint form
//
// A reference written in a formula: a column and a row, counted from 0, either of which may be
// left open (A is the whole column A, r5 the whole row 5, filled in from the sheet's size), and
// whether each was written absolute with $ (which matters only when a formula is moved). The
// forms: A1; a column or a row alone (A, A4 with the row, 5 alone is not one); $ before either
// part ($A$1, $A1, A$1), and $$ before both ($$A1); and Snips' hint forms, where a lowercase c
// or r brings in a column or row by its number from 1 or its letters (c5 is column E, r5 row 5,
// c1r1 is A1, ArC is A3). Column letters are upper case: a1 and b4 are not references, which
// keeps c1 and r1 meaning one thing.
data CellRef(val column : int?, val row : int?, val columnAbsolute : bool = false, val rowAbsolute : bool = false) {
  // As written with its $: "$A$1", "B4"; a part left open is left out.
  override fun toString() : string =>
    (column == null ? "" : (columnAbsolute ? "$" : "") + CellRef.columnName(column!!)) +
    (row == null ? "" : (rowAbsolute ? "$" : "") + (row!! + 1).toString())

  static {
    // Column letters as an index from 0: A is 0, Z 25, AA 26 (letters in either case). An
    // IllegalArgumentException for anything but letters.
    fun columnIndex(letters : string) : int {
      var index = 0
      for (c in letters.upper()) {
        if (c < 'A' or c > 'Z') { throw IllegalArgumentException("Bad column: $letters") }
        index = index * 26 + (c.code - 'A'.code + 1)
      }
      return index - 1
    }

    // An index from 0 as column letters: 0 is A, 25 Z, 26 AA.
    fun columnName(index : int) : string {
      if (index < 0) { throw IllegalArgumentException("Bad column index: $index") }
      var n = index + 1
      val out = StringBuilder()
      while (n > 0) {
        val rest = (n - 1) % 26
        out.append(('A'.code + rest).char)
        n = (n - 1) / 26
      }
      return out.toString().reversed()
    }

    // A cell written in full ("A1", "$B$4", "b4" too: Snips reads a plain cell in either case
    // here) as its column and row from 0, or null.
    fun parseCell(text : string) : Pair<int, int>? {
      val s = text.trim()
      var i = 0
      if (i < s.size and s[i] == '$') { i += 1 }
      val letters = i
      while (i < s.size and s[i].isLetter() and s[i].code < 128) { i += 1 }
      if (i == letters) { return null }
      val column = CellRef.columnIndex(s[letters..<i])
      if (i < s.size and s[i] == '$') { i += 1 }
      val digits = i
      while (i < s.size and s[i] >= '0' and s[i] <= '9') { i += 1 }
      if (i == digits or i != s.size) { return null }
      val row = (s[digits..].toIntOrNull() ?: return null) - 1
      if (row < 0) { return null }
      return Pair(column, row)
    }

    // A reference in any of the forms above, or null where `text` is none (a word as "sum",
    // "Total", "rate" is none).
    fun parse(text : string) : CellRef? {
      var s = text.trim()
      if (s.isEmpty()) { return null }
      var both = false
      if (s.startsWith("$$")) {
        both = true
        s = s[2..]
      }
      var i = 0
      var column : int? = null
      var row : int? = null
      var columnAbsolute = false
      var rowAbsolute = false
      var dollar = false
      while (i < s.size) {
        val c = s[i]
        if (c == '$') {
          dollar = true
          i += 1
        } else if (c >= 'A' and c <= 'Z') {
          if (column != null) { return null }
          val start = i
          while (i < s.size and s[i] >= 'A' and s[i] <= 'Z') { i += 1 }
          column = CellRef.columnIndex(s[start..<i])
          columnAbsolute = columnAbsolute or dollar
          dollar = false
        } else if (c >= '0' and c <= '9') {
          if (row != null) { return null }
          val start = i
          while (i < s.size and s[i] >= '0' and s[i] <= '9') { i += 1 }
          val v = (s[start..<i].toIntOrNull() ?: return null) - 1
          if (v < 0) { return null }
          row = v
          rowAbsolute = rowAbsolute or dollar
          dollar = false
        } else if (c == 'c') {
          if (column != null) { return null }
          val spec = __fxHintSpec(s, i + 1) ?: return null
          column = spec.first
          i = spec.second
          columnAbsolute = columnAbsolute or dollar
          dollar = false
        } else if (c == 'r') {
          if (row != null) { return null }
          val spec = __fxHintSpec(s, i + 1) ?: return null
          row = spec.first
          i = spec.second
          rowAbsolute = rowAbsolute or dollar
          dollar = false
        } else {
          return null
        }
      }
      if (column == null and row == null) { return null }
      if (both) {
        columnAbsolute = true
        rowAbsolute = true
      }
      return CellRef(column, row, columnAbsolute, rowAbsolute)
    }
  }
}

// What follows a hint's c or r: digits (a number from 1) or upper-case letters (A is 1), as
// an index from 0, and where it ends. Lower-case letters are not a spec, so words as "rate" and
// "count" are not taken for references.
fun __fxHintSpec(s : string, start : int) : Pair<int, int>? {
  var i = start
  if (i < s.size and s[i] >= '0' and s[i] <= '9') {
    while (i < s.size and s[i] >= '0' and s[i] <= '9') { i += 1 }
    val n = s[start..<i].toIntOrNull() ?: return null
    return Pair(n - 1, i)
  }
  if (i < s.size and s[i] >= 'A' and s[i] <= 'Z') {
    while (i < s.size and s[i] >= 'A' and s[i] <= 'Z') { i += 1 }
    return Pair(CellRef.columnIndex(s[start..<i]), i)
  }
  return null
}
