  __fxInfo("choose", "Lookup", "CHOOSE(n, a, b, …)", "The nth argument (1-based)."),
  // Conditional aggregates
  __fxInfo("sumif", "Conditional aggregates", "SUMIF(range, criterion)", "The total of the range's cells that meet the criterion.", [], "SUMIF(A1:A9, \">100\")"),
  __fxInfo("countif", "Conditional aggregates", "COUNTIF(range, criterion)", "How many of the range's cells meet the criterion."),
  __fxInfo("averageif", "Conditional aggregates", "AVERAGEIF(range, criterion)", "The mean of the range's cells that meet the criterion."),
