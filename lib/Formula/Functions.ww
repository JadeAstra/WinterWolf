  // Lookup
  __fxInfo("vlookup", "Lookup", "VLOOKUP(key, table, colIndex)", "Find `key` in the first column; return that row's colIndex.", [], "VLOOKUP(\"apple\", A1:C9, 3)"),
  __fxInfo("hlookup", "Lookup", "HLOOKUP(key, table, rowIndex)", "Find `key` in the first row; return that column's rowIndex."),
  __fxInfo("xlookup", "Lookup", "XLOOKUP(key, lookup, result, ifMissing)", "Find `key` in `lookup`; return the aligned `result`."),
  __fxInfo("match", "Lookup", "MATCH(value, range)", "The 1-based position of the value within the range."),
