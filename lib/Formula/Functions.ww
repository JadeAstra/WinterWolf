  __fxInfo("acos", "Math", "ACOS(x)", "The arccosine of x, in radians."),
  __fxInfo("atan", "Math", "ATAN(x)", "The arctangent of x, in radians."),
  __fxInfo("sign", "Math", "SIGN(x)", "-1, 0 or 1 according to the sign of x."),
  __fxInfo("int", "Math", "INT(x)", "x rounded down to the nearest integer."),
  // Rounding
  __fxInfo("round", "Rounding", "ROUND(x, digits=0)", "x rounded to the given number of decimal places."),
  __fxInfo("roundup", "Rounding", "ROUNDUP(x, digits=0)", "x rounded away from zero."),
  __fxInfo("rounddown", "Rounding", "ROUNDDOWN(x, digits=0)", "x rounded toward zero."),
  __fxInfo("trunc", "Rounding", "TRUNC(x, digits=0)", "x truncated toward zero (drops the fraction)."),
  __fxInfo("floor", "Rounding", "FLOOR(x)", "The largest integer not greater than x."),
  __fxInfo("ceil", "Rounding", "CEIL(x)", "The smallest integer not less than x.", ["ceiling"]),
  // Aggregates
  __fxInfo("average", "Aggregates", "AVERAGE(a, b, …)", "The mean of the numbers.", ["avg", "mean"]),
  __fxInfo("min", "Aggregates", "MIN(a, b, …)", "The smallest of the numbers."),
  __fxInfo("max", "Aggregates", "MAX(a, b, …)", "The largest of the numbers."),
  __fxInfo("count", "Aggregates", "COUNT(a, b, …)", "How many of the values are numbers."),
  __fxInfo("counta", "Aggregates", "COUNTA(a, b, …)", "How many of the values are non-empty."),
  __fxInfo("countblank", "Aggregates", "COUNTBLANK(a, b, …)", "How many of the values are empty."),
  __fxInfo("median", "Aggregates", "MEDIAN(a, b, …)", "The middle value of the numbers."),
  __fxInfo("mode", "Aggregates", "MODE(a, b, …)", "The most frequent of the numbers."),
  __fxInfo("clip", "Aggregates", "CLIP(x, lo, hi)", "x limited to the range lo..hi.", ["clamp"]),
  // Statistics
  __fxInfo("var", "Statistics", "VAR(a, b, …)", "The sample variance of the numbers."),
  __fxInfo("varp", "Statistics", "VARP(a, b, …)", "The population variance of the numbers."),
  __fxInfo("stdev", "Statistics", "STDEV(a, b, …)", "The sample standard deviation."),
  __fxInfo("stdevp", "Statistics", "STDEVP(a, b, …)", "The population standard deviation."),
  __fxInfo("rand", "Statistics", "RAND()", "A random number in [0, 1)."),
  __fxInfo("randbetween", "Statistics", "RANDBETWEEN(lo, hi)", "A random integer between lo and hi, inclusive."),
  // Logical
  __fxInfo("if", "Logical", "IF(test, then, else)", "`then` when the test is true, otherwise `else`.", [], "IF(A1 > 10, \"big\", \"small\")"),
  __fxInfo("ifs", "Logical", "IFS(test1, val1, test2, val2, …)", "The value for the first true test."),
