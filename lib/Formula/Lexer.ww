// ---- A formula's tokens (formula plan, part 1; Snips' Lexer.kt) ----
//
// Numbers (12, 1.5, .5, and 1e3 or 2.5e-4: an exponent after a lower-case e, which Snips read
// as 1 times e3; 2E3 is still 2 times the cell E3), names (letters, digits, _ and $, so $A$1 is
// one token; and #v, a name of a program's own), text in double quotes with no escapes, and
// symbols, one character each but <=, >= and <>, which become ≤, ≥ and ≠.

val __fxNumberToken = 0
val __fxNameToken = 1
val __fxStringToken = 2
val __fxSymbolToken = 3
val __fxEndToken = 4

data __FxToken(val kind : int, val text : string, val number : float = 0.0) {
  fun isSymbol(c : string) : bool => kind == __fxSymbolToken and text == c
}

// The tokens of `s`, ending with an end token; a FormulaException with #ERR! for a number
// that is none (1.2.3).
fun __fxTokenize(s : string) : List<__FxToken> {
  val tokens : open List<__FxToken> = []
  var i = 0
  while (i < s.size) {
    val c = s[i]
    if (c.isWhitespace()) {
      i += 1
    } else if (c.isDigit() or (c == '.' and i + 1 < s.size and s[i + 1].isDigit())) {
      val start = i
      while (i < s.size and (s[i].isDigit() or s[i] == '.')) { i += 1 }
      // An exponent: e, then digits or a sign and digits.
      if (i < s.size and s[i] == 'e') {
        var j = i + 1
        if (j < s.size and (s[j] == '+' or s[j] == '-')) { j += 1 }
        if (j < s.size and s[j] >= '0' and s[j] <= '9') {
          while (j < s.size and s[j] >= '0' and s[j] <= '9') { j += 1 }
          i = j
        }
      }
      val text = s[start..<i]
      val n = __fxJavaDouble(text)
      if (n == null or text.trim() != text) { throw FormulaException(ErrorValue("#ERR!", "'$text' is not a number")) }
      tokens.add(__FxToken(__fxNumberToken, text, n!!))
    } else if (c.isLetter() or c == '_' or c == '$') {
      val start = i
      while (i < s.size and (s[i].isLetterOrDigit() or s[i] == '_' or s[i] == '$')) { i += 1 }
      tokens.add(__FxToken(__fxNameToken, s[start..<i]))
    } else if (c == '"') {
      i += 1
      val start = i
      while (i < s.size and s[i] != '"') { i += 1 }
      tokens.add(__FxToken(__fxStringToken, s[start..<i]))
      i += 1
    } else if (c == '<' or c == '>') {
      if (i + 1 < s.size and (s[i + 1] == '=' or (c == '<' and s[i + 1] == '>'))) {
        tokens.add(__FxToken(__fxSymbolToken, s[i + 1] == '>' ? "≠" : c == '<' ? "≤" : "≥"))
        i += 2
      } else {
        tokens.add(__FxToken(__fxSymbolToken, "$c"))
        i += 1
      }
    } else if (c == '#') {
      val start = i
      i += 1
      while (i < s.size and (s[i].isLetterOrDigit() or s[i] == '_')) { i += 1 }
      tokens.add(__FxToken(__fxNameToken, s[start..<i]))
    } else {
      tokens.add(__FxToken(__fxSymbolToken, "$c"))
      i += 1
    }
  }
  tokens.add(__FxToken(__fxEndToken, ""))
  return tokens
}
