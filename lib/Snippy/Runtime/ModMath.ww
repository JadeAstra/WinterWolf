import Snippy.Text.*
// math (the Snippy plan, part 5.3, step 2), in WinterWolf (the user, 2026-11-21): Python's
// functions with CPython's results and messages. Where CPython rounds exactly (fsum, hypot,
// dist, sumprod, fmod, remainder, fma, ldexp), the exact value is worked out with BigInts and
// rounded once; gamma and lgamma follow the Lanczos approximation as CPython computes it; erf
// and erfc are worked out to more bits than a float has, then rounded.

// ---- Floats as exact numbers ----

// A finite float as m * 2**e, m a BigInt (its sign the float's).
fun pyFloatExact(x : float) : Pair<BigInt, int> {
  val b = Bytes(8)
  b.putFloat64(0, x)
  val bits = b.int64(0)
  val field = ((bits >>> 52) & 0x7FF).toInt()
  var mant = bits & 0xFFFFFFFFFFFFF
  var e = -1074
  if (field != 0) {
    mant = mant | (1 << 52)
    e = field - 1075
  }
  val m = BigInt.of(mant)
  return Pair(bits < 0 ? -m : m, e)
}

internal fun __pyTwoTo(k : int) : float {
  // 2.0 ** k exactly, k from -1074 to 1023, in two steps where one would leave the range.
  if (k < -1022) { return 2.0.pow(k + 60) / 2.0.pow(60) }
  return 2.0.pow(k)
}

// m * 2**e as the nearest float, ties to even; infinity past the largest.
fun pyExactToFloat(m0 : BigInt, e : int) : float {
  if (m0.isZero) { return 0.0 }
  val negative = m0 < 0
  val m = m0.abs()
  val top = m.bitLength + e
  if (top > 1024) { return negative ? -pyInf : pyInf }
  var lsb = top - 53
  if (lsb < -1074) { lsb = -1074 }
  val shift = lsb - e
  var r = m
  if (shift > 0) {
    r = m >> shift
    val rest = m - (r << shift)
    val half = BigInt.of(1) << (shift - 1)
    if (rest > half or (rest == half and r.testBit(0))) { r = r + 1 }
  } else if (shift < 0) {
    r = m << (-shift)
  }
  // r has 54 bits at most: exact as a float, and its product with a power of two exact.
  var f = r.toFloat()
  var k = lsb
  if (k > 900) { f = f * __pyTwoTo(900); k -= 900 }
  f = f * __pyTwoTo(k)
  return negative ? -f : f
}

// Exact values added: a list of (m, e), as one (m, e).
internal fun __pyExactSum(parts : List<Pair<BigInt, int>>) : Pair<BigInt, int> {
  if (parts.isEmpty()) { return Pair(BigInt.of(0), 0) }
  var low = parts[0].second
  for p in parts { if (p.second < low) { low = p.second } }
  var total = BigInt.of(0)
  for p in parts { total = total + (p.first << (p.second - low)) }
  return Pair(total, low)
}

// ---- Arguments ----

// A real number as a float, as CPython's math functions take one.
fun pyRealArg(x : any?) : float {
  if (x is float) { return x as float }
  if (x is int) { return (x as int).toFloat() }
  if (x is bool) { return (x as bool) ? 1.0 : 0.0 }
  if (x is BigInt) {
    val f = (x as BigInt).toFloat()
    if (f.isInfinite()) { throw pyOverflowError("int too large to convert to float") }
    return f
  }
  if (x is PyObject) {
    val cls = (x as PyObject).cls
    if (cls.lookup("__float__") !== pyUnbound or cls.lookup("__index__") !== pyUnbound or cls.layout >= 5) {
      return pyToFloat(pyFloatOf1(x))
    }
  }
  throw pyTypeError("must be real number, not ${pyTypeName(x)}")
}

internal fun __pyRangeError() : PyError => pyOverflowError("math range error")
internal fun __pyDomainError() : PyError => pyValueError("math domain error")
internal fun __pyFloatText(x : float) : string => pyReprFloat(x)

// A one-argument function of floats, as CPython's math_1: what it gives for a finite argument
// that is past its range an OverflowError, a NaN from a number a ValueError (`domain` saying how).
internal fun __pyMath1(x0 : any?, f : (float) -> float, canOverflow : bool, domain : ((float) -> string?)?) : any? {
  val x = pyRealArg(x0)
  if (domain != null) {
    val why = domain!!(x)
    if (why != null) { throw pyValueError(why!!) }
  }
  val r = f(x)
  if (r.isNaN() and !x.isNaN()) { throw __pyDomainError() }
  if (r.isInfinite() and !x.isInfinite() and canOverflow) { throw __pyRangeError() }
  return r
}

// ---- log of ints of any size ----

// x's natural log, or its log2 or log10 (`which` 0, 2, 10), for an int or a float, as CPython's
// loghelper: an int too large for a float through its top 53 bits and a power of two.
internal fun __pyLog(x : any?, which : int) : float {
  fun one(v : float) : float => which == 0 ? Math.ln(v) : which == 2 ? Math.log2(v) : Math.log10(v)
  if (pyIsInt(x)) {
    val n = pyBig(pyIndexValue(x))
    if (n <= 0) { throw pyValueError("expected a positive input") }
    val bits = n.bitLength
    if (bits <= 1000) { return one(n.toFloat()) }
    // n = m * 2**e with m in [0.5, 1).
    val m = pyExactToFloat(n, -bits)
    return one(m) + (which == 2 ? bits.toFloat() : one(2.0) * bits.toFloat())
  }
  val v = pyRealArg(x)
  if (v.isNaN()) { return v }
  if (v <= 0.0) { throw pyValueError("expected a positive input") }
  return one(v)
}

// ---- gamma and lgamma, after CPython's m_tgamma and m_lgamma (the Lanczos approximation) ----

internal val __pyLanczosG = 6.024680040776729583740234375
internal val __pyLanczosGMinusHalf = 5.524680040776729583740234375
internal val __pyLanczosNum = [23531376880.410759688572007674451636754734846804940, 42919803642.649098768957899047001988850926355848959,
  35711959237.355668049440185451547166705960488635843, 17921034426.037209699919755754458931112671403265390,
  6039542586.3520280050642916443072979210699388420708, 1439720407.3117216736632230727949123939715485786772,
  248874557.86205415651146038641322942321632125127801, 31426415.585400194380614231628318205362874684987640,
  2876370.6289353724412254090516208496135991145378768, 186056.26539522349504029498971604569928220784236328,
  8071.6720023658162106380029022722506138218516325024, 210.82427775157934587250973392071336271166969580291,
  2.5066282746310002701649081771338373386264310793408]
internal val __pyLanczosDen = [0.0, 39916800.0, 120543840.0, 150917976.0, 105258076.0, 45995730.0, 13339535.0, 2637558.0,
  357423.0, 32670.0, 1925.0, 66.0, 1.0]
internal val __pyGammaIntegral = [1.0, 1.0, 2.0, 6.0, 24.0, 120.0, 720.0, 5040.0, 40320.0, 362880.0, 3628800.0, 39916800.0,
  479001600.0, 6227020800.0, 87178291200.0, 1307674368000.0, 20922789888000.0, 355687428096000.0, 6402373705728000.0,
  121645100408832000.0, 2432902008176640000.0, 51090942171709440000.0, 1124000727777607680000.0]
internal val __pyLogPi = 1.144729885849400174143427351353058711647

internal fun __pyLanczosSum(x : float) : float {
  var num = 0.0
  var den = 0.0
  if (x < 5.0) {
    for i in 12 downTo 0 {
      num = num * x + __pyLanczosNum[i]
      den = den * x + __pyLanczosDen[i]
    }
  } else {
    for i in 0..<13 {
      num = num / x + __pyLanczosNum[i]
      den = den / x + __pyLanczosDen[i]
    }
  }
  return num / den
}

internal fun __pySinPi(x : float) : float {
  val y = __pyFmodFloat(Math.abs(x), 2.0)
  val n = Math.round(2.0 * y)
  val r = when (n) {
    0 -> Math.sin(Math.pi * y)
    1 -> Math.cos(Math.pi * (y - 0.5))
    2 -> Math.sin(Math.pi * (1.0 - y))
    3 -> -Math.cos(Math.pi * (y - 1.5))
    else -> Math.sin(Math.pi * (y - 2.0))
  }
  return pyCopySign(1.0, x) * r
}

fun pyGamma(x : float) : float {
  if (x.isNaN() or (x.isInfinite() and x > 0.0)) { return x }
  if (x.isInfinite() or (x == __pyFloorF(x) and x <= 0.0)) {
    throw pyValueError("expected a noninteger or positive integer, got ${__pyFloatText(x)}")
  }
  if (x == __pyFloorF(x) and x <= 23.0) { return __pyGammaIntegral[x.toInt() - 1] }
  val absx = Math.abs(x)
  if (absx < 1e-20) {
    val r = 1.0 / x
    if (r.isInfinite()) { throw __pyRangeError() }
    return r
  }
  if (absx > 200.0) {
    if (x < 0.0) { return 0.0 / __pySinPi(x) }
    throw __pyRangeError()
  }
  val y = absx + __pyLanczosGMinusHalf
  var z = 0.0
  if (absx > __pyLanczosGMinusHalf) {
    val q = y - absx
    z = q - __pyLanczosGMinusHalf
  } else {
    val q = y - __pyLanczosGMinusHalf
    z = q - absx
  }
  z = z * __pyLanczosG / y
  var r = 0.0
  if (x < 0.0) {
    r = -Math.pi / __pySinPi(absx) / absx * Math.exp(y) / __pyLanczosSum(absx)
    r -= z * r
    if (absx < 140.0) { r /= y.pow(absx - 0.5) } else {
      val sqrtpow = y.pow(absx / 2.0 - 0.25)
      r /= sqrtpow
      r /= sqrtpow
    }
  } else {
    r = __pyLanczosSum(absx) / Math.exp(y)
    r += z * r
    if (absx < 140.0) { r *= y.pow(absx - 0.5) } else {
      val sqrtpow = y.pow(absx / 2.0 - 0.25)
      r *= sqrtpow
      r *= sqrtpow
    }
  }
  if (r.isInfinite()) { throw __pyRangeError() }
  return r
}

fun pyLgamma(x : float) : float {
  if (x.isNaN()) { return x }
  if (x.isInfinite()) { return pyInf }
  if (x == __pyFloorF(x) and x <= 2.0) {
    if (x <= 0.0) { throw pyValueError("expected a noninteger or positive integer, got ${__pyFloatText(x)}") }
    return 0.0
  }
  val absx = Math.abs(x)
  if (absx < 1e-20) { return -Math.ln(absx) }
  var r = Math.ln(__pyLanczosSum(absx)) - __pyLanczosG
  r += (absx - 0.5) * (Math.ln(absx + __pyLanczosG - 0.5) - 1.0)
  if (x < 0.0) { r = __pyLogPi - Math.ln(Math.abs(__pySinPi(absx))) - Math.ln(absx) - r }
  if (r.isInfinite()) { throw __pyRangeError() }
  return r
}

// ---- erf and erfc, to 160 bits and rounded ----

// erf(x) or erfc(x) for a finite x: the Taylor series of erf, or for x past 3 the continued
// fraction of erfc, in fixed point of `bits` bits after the point, then rounded to a float.
internal fun __pyErfExact(x : float, complement : bool) : float {
  if (x == 0.0) { return complement ? 1.0 : x }
  val negative = x < 0.0
  val ax = Math.abs(x)
  if (!complement and ax >= 6.0) { return negative ? -1.0 : 1.0 }
  if (complement and x >= 27.3) { return 0.0 }
  if (complement and x <= -6.0) { return 2.0 }
  val bits = 200 + (ax * ax * 1.5).toInt()
  val one = BigInt.of(1) << bits
  val px = pyFloatExact(ax)
  // x in fixed point.
  val fx = px.second + bits >= 0 ? px.first << (px.second + bits) : px.first >> -(px.second + bits)
  val x2 = (fx * fx) >> bits
  // 2 / sqrt(pi) in fixed point, from pi worked out here.
  val twoOverSqrtPi = __pyTwoOverSqrtPi(bits)
  var erfc : BigInt? = null
  var erf : BigInt? = null
  if (ax < 3.0 or !complement) {
    // erf(x) = 2/sqrt(pi) * sum (-1)^n x^(2n+1) / (n! (2n+1))
    var term = fx
    var sum = fx
    var n = 0
    while (true) {
      n += 1
      term = -((term * x2) >> bits) / n
      val add = term / (2 * n + 1)
      if (add.isZero) { break }
      sum = sum + add
    }
    erf = (sum * twoOverSqrtPi) >> bits
  } else {
    // erfc(x) = exp(-x^2) / sqrt(pi) * 1 / (x + 1/2 / (x + 1 / (x + 3/2 / (x + ...)))), from the far end.
    var depth = 400
    var cf = fx
    for k in depth downTo 1 {
      val half = (BigInt.of(k) << bits) / 2
      cf = fx + (half << bits) / cf
    }
    val expNeg = __pyExpFixed(-x2, bits)
    erfc = (((expNeg * twoOverSqrtPi) >> bits) / 2 << bits) / cf
  }
  var value = complement ? (erfc != null ? erfc!! : one - erf!!) : (erf != null ? erf!! : one - erfc!!)
  if (negative) { value = complement ? (one + one) - value : -value }
  return pyExactToFloat(value, -bits)
}

// exp(v) for v in fixed point (v <= 0), by halving it until small, a Taylor series, and squaring back.
internal fun __pyExpFixed(v : BigInt, bits : int) : BigInt {
  val one = BigInt.of(1) << bits
  var halvings = 0
  var w = v
  while (w.abs() > (one >> 4)) { w = w / 2; halvings += 1 }
  var term = one
  var sum = one
  var n = 0
  while (true) {
    n += 1
    term = ((term * w) >> bits) / n
    if (term.isZero) { break }
    sum = sum + term
  }
  for i in 0..<halvings { sum = (sum * sum) >> bits }
  return sum
}

// 2 / sqrt(pi) in fixed point of `bits` bits: pi by Machin's formula, its square root, divided into 2.
internal fun __pyTwoOverSqrtPi(bits : int) : BigInt {
  val guard = bits + 20
  val one = BigInt.of(1) << guard
  fun arctanInverse(k : int) : BigInt {
    var power = one / k
    var sum = power
    var n = 1
    val k2 = k * k
    while (!power.isZero) {
      power = power / k2
      val term = power / (2 * n + 1)
      sum = n % 2 == 1 ? sum - term : sum + term
      n += 1
    }
    return sum
  }
  val pi = (arctanInverse(5) * 16) - (arctanInverse(239) * 4)
  val sqrtPi = (pi << guard).sqrt()
  return ((one << guard) * 2 / sqrtPi) >> 20
}

// ---- Exact float operations ----

fun pyCopySign(x : float, y : float) : float {
  val b = Bytes(8)
  b.putFloat64(0, x)
  val xb = b.int64(0)
  b.putFloat64(0, y)
  val yb = b.int64(0)
  b.putInt64(0, (xb & 0x7FFFFFFFFFFFFFFF) | (yb & (1 << 63)))
  return b.float64(0)
}

internal fun __pySignBit(x : float) : bool {
  val b = Bytes(8)
  b.putFloat64(0, x)
  return b.int64(0) < 0
}

// fmod as C's: exact, the sign of x.
internal fun __pyFmodFloat(x : float, y : float) : float {
  if (x.isNaN() or y.isNaN()) { return x + y }
  if (x.isInfinite() or y == 0.0) { return 0.0 / 0.0 }
  if (y.isInfinite()) { return x }
  val px = pyFloatExact(Math.abs(x))
  val py = pyFloatExact(Math.abs(y))
  val e = px.second < py.second ? px.second : py.second
  val r = (px.first << (px.second - e)) % (py.first << (py.second - e))
  return pyCopySign(pyExactToFloat(r, e), x)
}

// IEEE remainder: x - n*y, n the nearest integer to x/y, ties to even; exact.
internal fun __pyRemainder(x : float, y : float) : float {
  if (x.isNaN() or y.isNaN()) { return x + y }
  if (x.isInfinite() or y == 0.0) { throw __pyDomainError() }
  if (y.isInfinite()) { return x }
  val px = pyFloatExact(Math.abs(x))
  val py = pyFloatExact(Math.abs(y))
  val e = px.second < py.second ? px.second : py.second
  val bx = px.first << (px.second - e)
  val by = py.first << (py.second - e)
  val q = bx / by
  var r = bx - q * by
  val twice = r * 2
  if (twice > by or (twice == by and q.testBit(0))) { r = r - by }
  val f = pyExactToFloat(r, e)
  return f == 0.0 ? pyCopySign(0.0, x) : (__pySignBit(x) ? -f : f)
}

// The square root of m * 2**e (m >= 0), the nearest float.
internal fun __pyExactSqrt(m0 : BigInt, e0 : int) : float {
  if (m0.isZero) { return 0.0 }
  var m = m0
  var e = e0
  if (e % 2 != 0) { m = m << 1; e -= 1 }
  // Enough bits that the root has 60 at least, and a bit below them for anything left over.
  var k = 0
  val need = 124 - m.bitLength
  if (need > 0) { k = (need + 1) / 2 }
  val scaled = m << (2 * k)
  val r = scaled.sqrt()
  val exact = r * r == scaled
  return pyExactToFloat((r << 1) + (exact ? 0 : 1), e / 2 - k - 1)
}

// The length of a vector of floats, as CPython's vector_norm gives it: nearest the true value.
internal fun __pyNorm(values : List<float>) : float {
  var anyNan = false
  for v in values {
    if (v.isInfinite()) { return pyInf }
    if (v.isNaN()) { anyNan = true }
  }
  if (anyNan) { return 0.0 / 0.0 }
  val squares : open List<Pair<BigInt, int>> = []
  for v in values {
    val p = pyFloatExact(Math.abs(v))
    squares.add(Pair(p.first * p.first, p.second * 2))
  }
  val sum = __pyExactSum(squares)
  return __pyExactSqrt(sum.first, sum.second)
}

internal fun __pyFloats(x : any?) : List<float> => pyIterable(x).map { pyRealArg(it) }

// ---- floor, ceil, trunc ----

// A float made an int, toward minus infinity, plus infinity or zero (`way` -1, 1, 0).
fun pyFloatToInt(f : float, way : int) : any? {
  if (f.isNaN()) { throw pyValueError("cannot convert float NaN to integer") }
  if (f.isInfinite()) { throw pyOverflowError("cannot convert float infinity to integer") }
  val t = way < 0 ? __pyFloorF(f) : way > 0 ? __pyCeilF(f) : Math.trunc(f)
  if (t > -9.0e18 and t < 9.0e18) { return t.toInt() }
  return pyNorm(BigInt.of(t))
}

internal fun __pyRound(x : any?, dunder : string, way : int) : any? {
  if (pyIsInt(x)) { return pyIndexValue(x) }
  if (x is PyObject) {
    val m = (x as PyObject).cls.lookup(dunder)
    if (m !== pyUnbound and m != null) { return __pyCall1Special(m, x) }
  }
  if (!(x is float)) {
    if (x is PyObject or x is string or x is Complex or !pyIsNumber(x)) {
      if (dunder == "__trunc__") { throw pyTypeError("type ${pyTypeName(x)} doesn't define __trunc__ method") }
    }
  }
  return pyFloatToInt(pyRealArg(x), way)
}

// ---- Ints ----

internal fun __pyIntArg(x : any?) : BigInt {
  if (x is float) { throw pyTypeError("'float' object cannot be interpreted as an integer") }
  return pyBig(pyIndexValue(x))
}

// n! by splitting the product in halves, so that the numbers multiplied stay of a size.
internal fun __pyProductRange(low : int, high : int) : BigInt {
  if (high < low) { return BigInt.of(1) }
  if (high - low < 8) {
    var p = BigInt.of(low)
    for i in (low + 1)..high { p = p * i }
    return p
  }
  val mid = (low + high) / 2
  return __pyProductRange(low, mid) * __pyProductRange(mid + 1, high)
}

internal fun __pyComb(n : BigInt, k0 : BigInt) : BigInt {
  if (k0 > n) { return BigInt.of(0) }
  var k = k0
  if (k > n - k) { k = n - k }
  val kk = k.toIntOrNull()
  if (kk == null) { throw pyOverflowError("min(n - k, k) must not exceed 9223372036854775807") }
  var r = BigInt.of(1)
  for i in 1..kk!! { r = r * (n - kk!! + i) / i }
  return r
}

// ---- The module ----

fun pyMathModule() : PyModule {
  val m : open Map<string, any?> = {:}
  m["pi"] = Math.pi
  m["e"] = Math.e
  m["tau"] = 2.0 * Math.pi
  m["inf"] = pyInf
  m["nan"] = pyNaN
  fun one(name : string, f : (float) -> float, canOverflow : bool = false, domain : ((float) -> string?)? = null) {
    m[name] = __pyB(name) { a ->
      __pyCheckCount(name, a, 1, 1)
      __pyMath1(a.pos[0], f, canOverflow, domain)
    }
  }
  fun finite(x : float) : string? => x.isInfinite() ? "expected a finite input, got ${__pyFloatText(x)}" : null
  fun unit(x : float) : string? => x > 1.0 or x < -1.0 ? "expected a number in range from -1 up to 1, got ${__pyFloatText(x)}" : null
  one("sqrt", { x -> Math.sqrt(x) }, false, { x -> x < 0.0 ? "expected a nonnegative input, got ${__pyFloatText(x)}" : null })
  one("cbrt", { x -> pyCbrt(x) })
  one("exp", { x -> Math.exp(x) }, true)
  one("exp2", { x -> 2.0.pow(x) }, true)
  one("expm1", { x -> Math.expm1(x) }, true)
  one("log1p", { x -> Math.log1p(x) }, false, { x -> x <= -1.0 ? "expected argument value > -1, got ${__pyFloatText(x)}" : null })
  one("sin", { x -> Math.sin(x) }, false, finite)
  one("cos", { x -> Math.cos(x) }, false, finite)
  one("tan", { x -> Math.tan(x) }, false, finite)
  one("asin", { x -> Math.asin(x) }, false, unit)
  one("acos", { x -> Math.acos(x) }, false, unit)
  one("atan", { x -> Math.atan(x) })
  one("sinh", { x -> Math.sinh(x) }, true)
  one("cosh", { x -> Math.cosh(x) }, true)
  one("tanh", { x -> Math.tanh(x) })
  one("asinh", { x -> Math.asinh(x) })
  one("acosh", { x -> Math.acosh(x) }, false, { x -> x < 1.0 ? "expected argument value not less than 1, got ${__pyFloatText(x)}" : null })
  one("atanh", { x -> Math.atanh(x) }, false, { x -> x >= 1.0 or x <= -1.0 ? "expected a number between -1 and 1, got ${__pyFloatText(x)}" : null })
  one("fabs", { x -> Math.abs(x) })
  one("erf", { x -> x.isNaN() ? x : x.isInfinite() ? (x > 0.0 ? 1.0 : -1.0) : __pyErfExact(x, false) })
  one("erfc", { x -> x.isNaN() ? x : x.isInfinite() ? (x > 0.0 ? 0.0 : 2.0) : __pyErfExact(x, true) })
  m["gamma"] = __pyB("gamma") { a -> pyGamma(pyRealArg(a.pos[0])) }
  m["lgamma"] = __pyB("lgamma") { a -> pyLgamma(pyRealArg(a.pos[0])) }
  m["degrees"] = __pyB("degrees") { a -> pyRealArg(a.pos[0]) * (180.0 / Math.pi) }
