import Snippy.Text.*
// math (the Snippy plan, part 5.3, step 2): Python's names, argument checks and messages over
// ww's own functions (docs/math-plan.html, 0.9.5078): Math (cbrt, gamma, lnGamma, erf, erfc, fma,
// ieeeRemainder, hypot and distance of lists, toDegrees, toRadians), the floats' withSign,
// nextTowards and ulp, lists' exactSum and exactDot, and BigInt's factorial, binomial,
// permutations and lcm. Nothing of the math is Snippy's own.

// ---- Floats as exact numbers ----

// A finite float as m * 2**e, m a BigInt (its sign the float's).
fun pyFloatExact(x : float) : Pair<BigInt, int> {
  val b = Bytes(8)
  b.putFloat64(0, x)
  val bits = b.int64(0)
  val field = ((bits >>> 52) & 0x7FF).toInt()
  var mant = bits & 0xFFFFFFFFFFFFF
  var e = -1074
  if (field != 0) {
    mant = mant | (1 << 52)
    e = field - 1075
  }
  val m = BigInt.of(mant)
  return Pair(bits < 0 ? -m : m, e)
}

internal fun __pyTwoTo(k : int) : float {
  // 2.0 ** k exactly, k from -1074 to 1023, in two steps where one would leave the range.
  if (k < -1022) { return 2.0.pow(k + 60) / 2.0.pow(60) }
  return 2.0.pow(k)
}

// m * 2**e as the nearest float, ties to even; infinity past the largest.
fun pyExactToFloat(m0 : BigInt, e : int) : float {
  if (m0.isZero) { return 0.0 }
  val negative = m0 < 0
  val m = m0.abs()
  val top = m.bitLength + e
  if (top > 1024) { return negative ? -pyInf : pyInf }
  var lsb = top - 53
  if (lsb < -1074) { lsb = -1074 }
  val shift = lsb - e
  var r = m
  if (shift > 0) {
    r = m >> shift
    val rest = m - (r << shift)
    val half = BigInt.of(1) << (shift - 1)
    if (rest > half or (rest == half and r.testBit(0))) { r = r + 1 }
  } else if (shift < 0) {
    r = m << (-shift)
  }
  // r has 54 bits at most: exact as a float, and its product with a power of two exact.
  var f = r.toFloat()
  var k = lsb
  if (k > 900) { f = f * __pyTwoTo(900); k -= 900 }
  f = f * __pyTwoTo(k)
  return negative ? -f : f
}

// ---- Arguments ----

// A real number as a float, as CPython's math functions take one.
fun pyRealArg(x : any?) : float {
  if (x is float) { return x as float }
  if (x is int) { return (x as int).toFloat() }
  if (x is bool) { return (x as bool) ? 1.0 : 0.0 }
  if (x is BigInt) {
    val f = (x as BigInt).toFloat()
    if (f.isInfinite()) { throw pyOverflowError("int too large to convert to float") }
    return f
  }
  if (x is PyObject) {
    val cls = (x as PyObject).cls
    if (cls.lookup("__float__") !== pyUnbound or cls.lookup("__index__") !== pyUnbound or cls.layout >= 5) {
      return pyToFloat(pyFloatOf1(x))
    }
  }
  throw pyTypeError("must be real number, not ${pyTypeName(x)}")
}

internal fun __pyRangeError() : PyError => pyOverflowError("math range error")
internal fun __pyDomainError() : PyError => pyValueError("math domain error")
internal fun __pyFloatText(x : float) : string => pyReprFloat(x)

// A one-argument function of floats, as CPython's math_1: what it gives for a finite argument
// that is past its range an OverflowError, a NaN from a number a ValueError (`domain` saying how).
internal fun __pyMath1(x0 : any?, f : (float) -> float, canOverflow : bool, domain : ((float) -> string?)?) : any? {
  val x = pyRealArg(x0)
  if (domain != null) {
    val why = domain!!(x)
    if (why != null) { throw pyValueError(why!!) }
  }
  val r = f(x)
  if (r.isNaN() and !x.isNaN()) { throw __pyDomainError() }
  if (r.isInfinite() and !x.isInfinite() and canOverflow) { throw __pyRangeError() }
  return r
}

// ---- log of ints of any size ----

// x's natural log, or its log2 or log10 (`which` 0, 2, 10), for an int or a float, as CPython's
// loghelper: an int too large for a float through its top 53 bits and a power of two.
internal fun __pyLog(x : any?, which : int) : float {
  fun one(v : float) : float => which == 0 ? Math.ln(v) : which == 2 ? Math.log2(v) : Math.log10(v)
  if (pyIsInt(x)) {
    val n = pyBig(pyIndexValue(x))
    if (n <= 0) { throw pyValueError("expected a positive input") }
    val bits = n.bitLength
    if (bits <= 1000) { return one(n.toFloat()) }
    // n = m * 2**e with m in [0.5, 1).
    val m = pyExactToFloat(n, -bits)
    return one(m) + (which == 2 ? bits.toFloat() : one(2.0) * bits.toFloat())
  }
  val v = pyRealArg(x)
  if (v.isNaN()) { return v }
  if (v <= 0.0) { throw pyValueError("expected a positive input") }
  return one(v)
}

// ---- gamma and lgamma: ww's Math.gamma and Math.lnGamma, with CPython's errors ----

fun pyGamma(x : float) : float {
  if (x.isNaN() or (x.isInfinite() and x > 0.0)) { return x }
  if (x.isInfinite() or (x == __pyFloorF(x) and x <= 0.0)) {
    throw pyValueError("expected a noninteger or positive integer, got ${__pyFloatText(x)}")
  }
  val r = Math.gamma(x)
  if (r.isInfinite()) { throw __pyRangeError() }
  return r
}

fun pyLgamma(x : float) : float {
  if (x.isNaN()) { return x }
  if (x.isInfinite()) { return pyInf }
  if (x == __pyFloorF(x) and x <= 0.0) { throw pyValueError("expected a noninteger or positive integer, got ${__pyFloatText(x)}") }
  val r = Math.lnGamma(x)
  if (r.isInfinite()) { throw __pyRangeError() }
  return r
}

// ---- Exact float operations ----

fun pyCopySign(x : float, y : float) : float => x.withSign(y)

// C's fmod, which CPython's math.fmod is: ww's % of floats (U18), exact, with x's sign; NaN for
// an infinite x or a zero y, x itself for an infinite y.
internal fun __pyFmodFloat(x : float, y : float) : float => x % y

internal fun __pyFloats(x : any?) : List<float> => pyIterable(x).map { pyRealArg(it) }

// math.fsum: ww's exactSum (CPython's algorithm), with CPython's errors: "-inf + inf in fsum"
// where both infinities are there, "intermediate overflow in fsum" where a sum on the way passes
// the largest float. statistics adds up with this too, as CPython's calls math.fsum.
fun pyFsum(values : List<float>) : float {
  try {
    val r = values.exactSum()
    if (r.isNaN() and values.any { it == pyInf } and values.any { it == -pyInf }) { throw pyValueError("-inf + inf in fsum") }
    return r
  } catch (e : ArithmeticException) {
    throw pyOverflowError("intermediate overflow in fsum")
  }
}

// math.sumprod of two lists of floats: ww's exactDot. statistics' covariance, correlation and
// linear_regression use it too, as CPython's do.
fun pySumprodFloats(p : List<float>, q : List<float>) : float => p.exactDot(q)

// ---- floor, ceil, trunc ----

// A float made an int, toward minus infinity, plus infinity or zero (`way` -1, 1, 0).
fun pyFloatToInt(f : float, way : int) : any? {
  if (f.isNaN()) { throw pyValueError("cannot convert float NaN to integer") }
  if (f.isInfinite()) { throw pyOverflowError("cannot convert float infinity to integer") }
  val t = way < 0 ? __pyFloorF(f) : way > 0 ? __pyCeilF(f) : Math.trunc(f)
  if (t > -9.0e18 and t < 9.0e18) { return t.toInt() }
  return pyNorm(BigInt.of(t))
}

internal fun __pyRound(x : any?, dunder : string, way : int) : any? {
  if (pyIsInt(x)) { return pyIndexValue(x) }
  if (x is PyObject) {
    val m = (x as PyObject).cls.lookup(dunder)
    if (m !== pyUnbound and m != null) { return __pyCall1Special(m, x) }
  }
  if (!(x is float)) {
    if (x is PyObject or x is string or x is Complex or !pyIsNumber(x)) {
      if (dunder == "__trunc__") { throw pyTypeError("type ${pyTypeName(x)} doesn't define __trunc__ method") }
    }
  }
  return pyFloatToInt(pyRealArg(x), way)
}

// ---- Ints ----

internal fun __pyIntArg(x : any?) : BigInt {
  if (x is float) { throw pyTypeError("'float' object cannot be interpreted as an integer") }
  return pyBig(pyIndexValue(x))
}

// ---- The module ----

fun pyMathModule() : PyModule {
  val m : open Map<string, any?> = {:}
  m["pi"] = Math.pi
  m["e"] = Math.e
  m["tau"] = 2.0 * Math.pi
  m["inf"] = pyInf
  m["nan"] = pyNaN
  fun one(name : string, f : (float) -> float, canOverflow : bool = false, domain : ((float) -> string?)? = null) {
    m[name] = __pyB(name) { a ->
      __pyCheckCount(name, a, 1, 1)
      __pyMath1(a.pos[0], f, canOverflow, domain)
    }
  }
  fun finite(x : float) : string? => x.isInfinite() ? "expected a finite input, got ${__pyFloatText(x)}" : null
  fun unit(x : float) : string? => x > 1.0 or x < -1.0 ? "expected a number in range from -1 up to 1, got ${__pyFloatText(x)}" : null
  one("sqrt", { x -> Math.sqrt(x) }, false, { x -> x < 0.0 ? "expected a nonnegative input, got ${__pyFloatText(x)}" : null })
  one("cbrt", { x -> Math.cbrt(x) })
  one("exp", { x -> Math.exp(x) }, true)
  one("exp2", { x -> 2.0.pow(x) }, true)
  one("expm1", { x -> Math.expm1(x) }, true)
  one("log1p", { x -> Math.log1p(x) }, false, { x -> x <= -1.0 ? "expected argument value > -1, got ${__pyFloatText(x)}" : null })
  one("sin", { x -> Math.sin(x) }, false, finite)
  one("cos", { x -> Math.cos(x) }, false, finite)
  one("tan", { x -> Math.tan(x) }, false, finite)
  one("asin", { x -> Math.asin(x) }, false, unit)
  one("acos", { x -> Math.acos(x) }, false, unit)
  one("atan", { x -> Math.atan(x) })
  one("sinh", { x -> Math.sinh(x) }, true)
  one("cosh", { x -> Math.cosh(x) }, true)
  one("tanh", { x -> Math.tanh(x) })
  one("asinh", { x -> Math.asinh(x) })
  one("acosh", { x -> Math.acosh(x) }, false, { x -> x < 1.0 ? "expected argument value not less than 1, got ${__pyFloatText(x)}" : null })
  one("atanh", { x -> Math.atanh(x) }, false, { x -> x >= 1.0 or x <= -1.0 ? "expected a number between -1 and 1, got ${__pyFloatText(x)}" : null })
  one("fabs", { x -> Math.abs(x) })
  one("erf", { x -> Math.erf(x) })
  one("erfc", { x -> Math.erfc(x) })
  m["gamma"] = __pyB("gamma") { a -> pyGamma(pyRealArg(a.pos[0])) }
  m["lgamma"] = __pyB("lgamma") { a -> pyLgamma(pyRealArg(a.pos[0])) }
  m["degrees"] = __pyB("degrees") { a -> Math.toDegrees(pyRealArg(a.pos[0])) }
  m["radians"] = __pyB("radians") { a -> Math.toRadians(pyRealArg(a.pos[0])) }
  m["atan2"] = __pyB("atan2") { a ->
    __pyCheckCount("atan2", a, 2, 2)
    Math.atan2(pyRealArg(a.pos[0]), pyRealArg(a.pos[1]))
  }
  m["log"] = __pyB("log") { a ->
    __pyCheckCount("log", a, 1, 2)
    val num = __pyLog(a.pos[0], 0)
    if (a.pos.size < 2) { num } else {
      val den = __pyLog(a.pos[1], 0)
      if (den == 0.0) { throw pyError(pyZeroDivisionErrorType, "division by zero") }
      num / den
    }
  }
  m["log2"] = __pyB("log2") { a -> __pyLog(a.pos[0], 2) }
  m["log10"] = __pyB("log10") { a -> __pyLog(a.pos[0], 10) }
  m["pow"] = __pyB("pow") { a ->
    __pyCheckCount("pow", a, 2, 2)
    val x = pyRealArg(a.pos[0])
    val y = pyRealArg(a.pos[1])
    if (x == 0.0 and y < 0.0 and !y.isInfinite() or (x == 0.0 and y == -pyInf)) {
      if (x == 0.0 and y < 0.0) { throw __pyDomainError() }
    }
    if (x < 0.0 and !x.isInfinite() and !y.isInfinite() and y != __pyFloorF(y)) { throw __pyDomainError() }
    val r = x.pow(y)
    if (r.isInfinite() and !x.isInfinite() and !y.isInfinite()) { throw __pyRangeError() }
    r
  }
  m["fmod"] = __pyB("fmod") { a ->
    val x = pyRealArg(a.pos[0])
    val y = pyRealArg(a.pos[1])
    if ((x.isInfinite() and !y.isNaN()) or (y == 0.0 and !x.isNaN())) { throw __pyDomainError() }
    __pyFmodFloat(x, y)
  }
  m["remainder"] = __pyB("remainder") { a ->
    val x = pyRealArg(a.pos[0])
    val y = pyRealArg(a.pos[1])
    if (!x.isNaN() and !y.isNaN() and (x.isInfinite() or y == 0.0)) { throw __pyDomainError() }
    Math.ieeeRemainder(x, y)
  }
  m["copysign"] = __pyB("copysign") { a -> pyCopySign(pyRealArg(a.pos[0]), pyRealArg(a.pos[1])) }
  m["floor"] = __pyB("floor") { a -> __pyRound(a.pos[0], "__floor__", -1) }
  m["ceil"] = __pyB("ceil") { a -> __pyRound(a.pos[0], "__ceil__", 1) }
  m["trunc"] = __pyB("trunc") { a -> __pyRound(a.pos[0], "__trunc__", 0) }
  m["isfinite"] = __pyB("isfinite") { a -> val x = pyRealArg(a.pos[0]); !x.isNaN() and !x.isInfinite() }
  m["isinf"] = __pyB("isinf") { a -> pyRealArg(a.pos[0]).isInfinite() }
  m["isnan"] = __pyB("isnan") { a -> pyRealArg(a.pos[0]).isNaN() }
  m["isclose"] = __pyB("isclose") { a ->
    a.only(["rel_tol", "abs_tol"])
    val x = pyRealArg(a.pos[0])
    val y = pyRealArg(a.pos[1])
    val rel = pyRealArg(a.get("rel_tol", 1e-09))
    val abs = pyRealArg(a.get("abs_tol", 0.0))
    if (rel < 0.0 or abs < 0.0) { throw pyValueError("tolerances must be non-negative") }
    if (x == y) { true } else if (x.isInfinite() or y.isInfinite()) { false } else {
      val diff = Math.abs(y - x)
      (diff <= Math.abs(rel * y) or diff <= Math.abs(rel * x)) or diff <= abs
    }
  }
  m["frexp"] = __pyB("frexp") { a ->
    val x = pyRealArg(a.pos[0])
    if (x == 0.0 or x.isNaN() or x.isInfinite()) { PyTuple([x, 0]) } else {
      val p = pyFloatExact(x)
      val bits = p.first.abs().bitLength
      PyTuple([pyExactToFloat(p.first, -bits), p.second + bits])
    }
  }
  m["ldexp"] = __pyB("ldexp") { a ->
    val x = pyRealArg(a.pos[0])
    if (a.pos[1] is float) { throw pyTypeError("Expected an int as second argument to ldexp.") }
    val n = pyBig(pyIndexValue(a.pos[1]))
    if (x == 0.0 or x.isNaN() or x.isInfinite()) { x } else if (n > 5000) { throw __pyRangeError() } else if (n < -5000) {
      pyCopySign(0.0, x)
    } else {
      val p = pyFloatExact(x)
      val r = pyExactToFloat(p.first, p.second + n.toInt())
      if (r.isInfinite()) { throw __pyRangeError() }
      r == 0.0 ? pyCopySign(0.0, x) : r
    }
  }
  m["modf"] = __pyB("modf") { a ->
    val x = pyRealArg(a.pos[0])
    if (x.isInfinite()) { PyTuple([pyCopySign(0.0, x), x]) } else if (x.isNaN()) { PyTuple([x, x]) } else {
      val whole = Math.trunc(x)
      PyTuple([pyCopySign(x - whole, x), pyCopySign(whole, x)])
    }
  }
  m["fma"] = __pyB("fma") { a ->
    val x = pyRealArg(a.pos[0])
    val y = pyRealArg(a.pos[1])
    val z = pyRealArg(a.pos[2])
    val r = Math.fma(x, y, z)
    if (r.isNaN() and !x.isNaN() and !y.isNaN() and !z.isNaN()) { throw pyValueError("invalid operation in fma") }
    if (r.isInfinite() and x.isFinite() and y.isFinite() and z.isFinite()) { throw pyOverflowError("overflow in fma") }
    r
  }
  m["nextafter"] = __pyB("nextafter") { a ->
    a.only(["steps"])
    if (a.pos.size != 2) { throw pyTypeError("nextafter() takes exactly 2 positional arguments (${a.pos.size} given)") }
    var x = pyRealArg(a.pos[0])
    val y = pyRealArg(a.pos[1])
    val stepsArg = a.get("steps", null)
    var steps = stepsArg == null ? 1 : pyIndex(stepsArg)
    if (steps < 0) { throw pyValueError("steps must be a non-negative integer") }
    while (steps > 0 and x != y and !x.isNaN() and !y.isNaN()) {
      x = x.nextTowards(y)
      steps -= 1
    }
    x.isNaN() or y.isNaN() ? x + y : (x == y ? y : x)
  }
  m["ulp"] = __pyB("ulp") { a -> pyRealArg(a.pos[0]).ulp }
  m["hypot"] = __pyB("hypot") { a -> Math.hypot(a.pos.map { pyRealArg(it) }) }
  m["dist"] = __pyB("dist") { a ->
    __pyCheckCount("dist", a, 2, 2)
    val p = __pyFloats(a.pos[0])
    val q = __pyFloats(a.pos[1])
    if (p.size != q.size) { throw pyValueError("both points must have the same number of dimensions") }
    Math.distance(p, q)
  }
  m["fsum"] = __pyB("fsum") { a -> pyFsum(__pyFloats(a.pos[0])) }
  m["sumprod"] = __pyB("sumprod") { a ->
    __pyCheckCount("sumprod", a, 2, 2)
    val p = pyIterable(a.pos[0])
    val q = pyIterable(a.pos[1])
    if (p.size != q.size) { throw pyValueError("Inputs are not the same length") }
    val ints = p.all { pyIsInt(it) } and q.all { pyIsInt(it) }
    val reals = p.all { pyIsInt(it) or it is float } and q.all { pyIsInt(it) or it is float }
    if (ints) {
      var total = BigInt.of(0)
      for i in p.indices { total = total + pyBig(pyIndexValue(p[i])) * pyBig(pyIndexValue(q[i])) }
      pyNorm(total)
    } else if (reals and p.indices.all { !(p[it] is float and ((p[it] as float).isNaN() or (p[it] as float).isInfinite())) and !(q[it] is float and ((q[it] as float).isNaN() or (q[it] as float).isInfinite())) }) {
      pySumprodFloats(p.map { pyRealArg(it) }, q.map { pyRealArg(it) })
    } else {
      var total : any? = 0
      for i in p.indices { total = pyAdd(total, pyMul(p[i], q[i])) }
      total
    }
  }
  m["prod"] = __pyB("prod") { a ->
    a.only(["start"])
    var r = a.get("start", 1)
    for x in pyIterable(a.pos[0]) { r = pyMul(r, x) }
    r
  }
  m["isqrt"] = __pyB("isqrt") { a ->
    val n = __pyIntArg(a.pos[0])
    if (n < 0) { throw pyValueError("isqrt() argument must be nonnegative") }
    pyNorm(n.sqrt())
  }
  m["factorial"] = __pyB("factorial") { a ->
    val n = __pyIntArg(a.pos[0])
    if (n < 0) { throw pyValueError("factorial() not defined for negative values") }
    val k = n.toIntOrNull()
    if (k == null) { throw pyOverflowError("factorial() argument should not exceed 9223372036854775807") }
    pyNorm(BigInt.factorial(k!!))
  }
  m["comb"] = __pyB("comb") { a ->
    __pyCheckCount("comb", a, 2, 2)
    val n = __pyIntArg(a.pos[0])
    val k = __pyIntArg(a.pos[1])
    if (n < 0) { throw pyValueError("n must be a non-negative integer") }
    if (k < 0) { throw pyValueError("k must be a non-negative integer") }
    val small = k > n - k ? n - k : k
    if (k <= n and small.toIntOrNull() == null) { throw pyOverflowError("min(n - k, k) must not exceed 9223372036854775807") }
    pyNorm(BigInt.binomial(n, k))
  }
  m["perm"] = __pyB("perm") { a ->
    __pyCheckCount("perm", a, 1, 2)
    val n = __pyIntArg(a.pos[0])
    if (a.pos.size < 2 or a.pos[1] == null) {
      if (n < 0) { throw pyValueError("factorial() not defined for negative values") }
      val nn = n.toIntOrNull()
      if (nn == null) { throw pyOverflowError("factorial() argument should not exceed 9223372036854775807") }
      pyNorm(BigInt.factorial(nn!!))
    } else {
      val k = __pyIntArg(a.pos[1])
      if (n < 0) { throw pyValueError("n must be a non-negative integer") }
      if (k < 0) { throw pyValueError("k must be a non-negative integer") }
      if (k > n) { 0 } else {
        val nn = n.toIntOrNull()
        val kk = k.toIntOrNull()
        if (nn == null or kk == null) { throw pyOverflowError("n must not exceed 9223372036854775807") }
        pyNorm(BigInt.permutations(nn!!, kk!!))
      }
    }
  }
  m["gcd"] = __pyB("gcd") { a ->
    var g = BigInt.of(0)
    for x in a.pos { g = g.gcd(__pyIntArg(x)) }
    pyNorm(g.abs())
  }
  m["lcm"] = __pyB("lcm") { a ->
    var l = BigInt.of(1)
    for x in a.pos {
      val v = __pyIntArg(x).abs()
      l = l.lcm(v)
    }
    pyNorm(l)
  }
  return pyNativeModule("math", m)
}

// A count of positional arguments, as CPython's math functions check it.
internal fun __pyCheckCount(name : string, a : PyArgs, low : int, high : int) {
  val n = a.pos.size
  if (n >= low and n <= high) { return }
  if (low == high) {
    throw pyTypeError(low == 1 ? "math.$name() takes exactly one argument ($n given)" : "$name expected $low arguments, got $n")
  }
  throw pyTypeError(n < low ? "$name expected at least $low argument${low == 1 ? "" : "s"}, got $n" : "$name expected at most $high arguments, got $n")
}

// floor and ceil of a float, as floats (Math's give ints).
internal fun __pyFloorF(x : float) : float {
  if (x.isNaN() or x.isInfinite()) { return x }
  val t = Math.trunc(x)
  return t > x ? t - 1.0 : t
}
internal fun __pyCeilF(x : float) : float {
  if (x.isNaN() or x.isInfinite()) { return x }
  val t = Math.trunc(x)
  return t < x ? t + 1.0 : t
}
