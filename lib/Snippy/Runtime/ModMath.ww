// A count of positional arguments, as CPython's math functions check it.
internal fun __pyCheckCount(name : string, a : PyArgs, low : int, high : int) {
  val n = a.pos.size
  if (n >= low and n <= high) { return }
  if (low == high) {
    throw pyTypeError(low == 1 ? "math.$name() takes exactly one argument ($n given)" : "$name expected $low arguments, got $n")
  }
  throw pyTypeError(n < low ? "$name expected at least $low argument${low == 1 ? "" : "s"}, got $n" : "$name expected at most $high arguments, got $n")
}

// The next float after x toward y.
internal fun __pyNextAfter(x : float, y : float) : float {
  if (x.isNaN() or y.isNaN()) { return x + y }
  if (x == y) { return y }
  if (x == 0.0) { return y > 0.0 ? 5e-324 : -5e-324 }
  val b = Bytes(8)
  b.putFloat64(0, x)
  var bits = b.int64(0)
  val up = (y > x) == (x > 0.0)
  bits = up ? bits + 1 : bits - 1
  b.putInt64(0, bits)
  return b.float64(0)
}

// cbrt as the C library computes it on Linux (glibc's): a polynomial guess on [0.5, 1) and one
// step of Halley's method, its result not always the nearest float (cbrt(27) is 3.0000000000000004).
fun pyCbrt(x : float) : float {
  if (x == 0.0 or x.isNaN() or x.isInfinite()) { return x + x }
  val p = pyFloatExact(Math.abs(x))
  val bits = p.first.bitLength
  var xe = p.second + bits
  val xm = pyExactToFloat(p.first, -bits)
  val u = 0.354895765043919860 + ((1.50819193781584896 + ((-2.11499494167371287 + ((2.44693122563534430 +
          ((-1.83469277483613086 + (0.784932344976639262 - 0.145263899385486377 * xm) * xm) * xm)) * xm)) * xm)) * xm)
  val t2 = u * u * u
  val factors = [1.0 / 1.5874010519681994748, 1.0 / 1.2599210498948731648, 1.0, 1.2599210498948731648, 1.5874010519681994748]
  // C's xe % 3, of the sign of xe.
  val rem = xe % 3
  val ym = u * (t2 + 2.0 * xm) / (2.0 * t2 + xm) * factors[2 + rem]
  val q = xe / 3
  val r = pyExactToFloat(pyFloatExact(x > 0.0 ? ym : -ym).first, pyFloatExact(x > 0.0 ? ym : -ym).second + q)
  return r
}

// floor and ceil of a float, as floats (Math's give ints).
internal fun __pyFloorF(x : float) : float {
  if (x.isNaN() or x.isInfinite()) { return x }
  val t = Math.trunc(x)
  return t > x ? t - 1.0 : t
}
internal fun __pyCeilF(x : float) : float {
  if (x.isNaN() or x.isInfinite()) { return x }
  val t = Math.trunc(x)
  return t < x ? t + 1.0 : t
}
