import Snippy.Text.*
// fractions (the Snippy plan, part 5.3, step 3), in WinterWolf: Fraction as CPython's, a Python
// class (which a program may subclass) whose objects keep a numerator and a denominator, in
// lowest terms, the denominator positive. With ints and Fractions it stays exact; with floats and
// complex numbers it becomes a float or a complex, as CPython's _operator_fallbacks make it.

// ---- Rationals as two BigInts ----

// n / d, correctly rounded to a float (as Python's int / int).
fun pyRatioToFloat(n : BigInt, d : BigInt) : float {
  if (n.isZero) { return 0.0 }
  val negative = (n < 0) != (d < 0)
  val an = n.abs()
  val ad = d.abs()
  var s = 55 + ad.bitLength - an.bitLength
  if (s < 0) { s = 0 }
  val scaled = an << s
  val q = scaled / ad
  val exact = q * ad == scaled
  val f = pyExactToFloat((q << 1) + (exact ? 0 : 1), -s - 1)
  return negative ? -f : f
}

// The round-half-to-even of n / d, as an int.
fun pyRoundHalfEven(n : BigInt, d : BigInt) : BigInt {
  var q = n.floorDiv(d)
  val r = n - q * d
  val twice = r * 2
  if (twice > d or (twice == d and q.testBit(0))) { q = q + 1 }
  return q
}

// ---- Fraction ----

internal fun __pyNum(f : any?) : BigInt => pyBig(pyGetAttr(f, "_numerator"))
internal fun __pyDen(f : any?) : BigInt => pyBig(pyGetAttr(f, "_denominator"))

// A Fraction of class `cls`, n / d in lowest terms, the sign on n.
fun pyMakeFraction(cls : any?, n0 : BigInt, d0 : BigInt, normalize : bool = true) : any? {
  var n = n0
  var d = d0
  if (d.isZero) { throw pyZeroDivisionError("Fraction(${n}, 0)") }
  if (normalize) {
    var g = n.gcd(d).abs()
    if (d < 0) { g = -g }
    if (!g.isZero) { n = n / g; d = d / g }
  }
  val o = PyObject(cls as PyType)
  o.dict = PyDict()
  o.dict!!.set("_numerator", pyNorm(n))
  o.dict!!.set("_denominator", pyNorm(d))
  return o
}

internal fun __pyFrac(n : BigInt, d : BigInt) : any? => pyMakeFraction(__pyFractionType, n, d)

// Whether x is a Rational: an int or a Fraction (or anything with numerator and denominator).
internal fun __pyIsRational(x : any?) : bool => pyIsInt(x) or pyIsInstance(x, __pyFractionType)
internal fun __pyNumOf(x : any?) : BigInt => pyIsInt(x) ? pyBig(pyIndexValue(x)) : __pyNum(x)
internal fun __pyDenOf(x : any?) : BigInt => pyIsInt(x) ? BigInt.of(1) : __pyDen(x)

// A float as n / d exactly.
fun pyFloatRatio(x : float) : Pair<BigInt, BigInt> {
  if (x.isNaN()) { throw pyValueError("cannot convert NaN to integer ratio") }
  if (x.isInfinite()) { throw pyOverflowError("cannot convert Infinity to integer ratio") }
  val p = pyFloatExact(x)
  if (p.second >= 0) { return Pair(p.first << p.second, BigInt.of(1)) }
  return Pair(p.first, BigInt.of(1) << (-p.second))
}

// Fraction(text), as CPython reads it: a sign, digits with _, /digits, or a point and an exponent.
internal fun __pyFractionFromText(s0 : string) : Pair<BigInt, BigInt> {
  val bad = { -> pyValueError("Invalid literal for Fraction: ${pyRepr(s0)}") }
  val s = s0.trim()
  var i = 0
  var negative = false
  if (i < s.size and (s[i] == '+' or s[i] == '-')) { negative = s[i] == '-'; i += 1 }
  fun digits() : string {
    val start = i
    while (i < s.size and ((s[i] >= '0' and s[i] <= '9') or (s[i] == '_' and i > start and i + 1 < s.size and s[i + 1] >= '0' and s[i + 1] <= '9'))) { i += 1 }
    return s[start..<i].replace("_", "")
  }
  val whole = digits()
  var n = BigInt.of(0)
  var d = BigInt.of(1)
  if (i < s.size and s[i] == '/') {
    if (whole.isEmpty()) { throw bad() }
    i += 1
    val den = digits()
    if (den.isEmpty() or i != s.size) { throw bad() }
    n = BigInt.parse(whole)
    d = BigInt.parse(den)
  } else {
    var frac = ""
    if (i < s.size and s[i] == '.') {
      i += 1
      frac = digits()
    }
    if (whole.isEmpty() and frac.isEmpty()) { throw bad() }
    var exp = 0
    if (i < s.size and (s[i] == 'e' or s[i] == 'E')) {
      i += 1
      var eNeg = false
      if (i < s.size and (s[i] == '+' or s[i] == '-')) { eNeg = s[i] == '-'; i += 1 }
      val e = digits()
      if (e.isEmpty()) { throw bad() }
      exp = e.toInt()
      if (eNeg) { exp = -exp }
    }
    if (i != s.size) { throw bad() }
    n = BigInt.parse((whole + frac).isEmpty() ? "0" : whole + frac)
    exp -= frac.size
    if (exp >= 0) { n = n * BigInt.of(10).pow(exp) } else { d = BigInt.of(10).pow(-exp) }
  }
  if (d.isZero) { throw pyZeroDivisionError("Fraction(${n}, 0)") }
  return Pair(negative ? -n : n, d)
}

// What a Fraction op another is: a Fraction with a Rational, a float with a float, a complex
// with a complex; NotImplemented with anything else (CPython's forward and reverse fallbacks).
internal fun __pyFracOp(a : any?, b : any?, reverse : bool, exact : (BigInt, BigInt, BigInt, BigInt) -> any?, inexact : (any?, any?) -> any?) : any? {
  if (__pyIsRational(b)) {
    val x = reverse ? b : a
    val y = reverse ? a : b
    return exact(__pyNumOf(x), __pyDenOf(x), __pyNumOf(y), __pyDenOf(y))
  }
  if (b is float) {
    val fa = pyRatioToFloat(__pyNum(a), __pyDen(a))
    return reverse ? inexact(b, fa) : inexact(fa, b)
  }
  if (b is Complex) {
    val ca = Complex(pyRatioToFloat(__pyNum(a), __pyDen(a)), 0.0)
    return reverse ? inexact(b, ca) : inexact(ca, b)
  }
  return pyNotImplemented
}

internal fun __pyFracDivZero(n : BigInt, d : BigInt) {
  if (d.isZero) { throw pyZeroDivisionError("Fraction(${n}, 0)") }
}

internal fun __pyFracMethod(name : string, reverse : bool, exact : (BigInt, BigInt, BigInt, BigInt) -> any?, inexact : (any?, any?) -> any?) : PyBuiltin =>
  pyLibMethod("Fraction", name) { self, a -> __pyFracOp(self, a.pos[0], reverse, exact, inexact) }

internal fun __pyFracCompare(self : any?, other : any?, op : (BigInt, BigInt) -> bool) : any? {
  if (__pyIsRational(other)) { return op(__pyNum(self) * __pyDenOf(other), __pyDen(self) * __pyNumOf(other)) }
  if (other is float) {
    val f = other as float
    if (f.isNaN() or f.isInfinite()) { return op(BigInt.of(0), f.isNaN() ? BigInt.of(0) : (f > 0.0 ? BigInt.of(1) : BigInt.of(-1))) and !f.isNaN() }
    val r = pyFloatRatio(f)
    return op(__pyNum(self) * r.second, __pyDen(self) * r.first)
  }
  return pyNotImplemented
}

// Fraction's hash, as CPython's: the numerator's hash times the denominator's inverse modulo 2**61 - 1.
internal fun __pyFracHash(n : BigInt, d : BigInt) : int {
  val modulus = BigInt.of(2305843009213693951)
  var h = 0
  if ((d % modulus).isZero) { h = 314159 } else {
    val dinv = d.modPow(modulus - 2, modulus)
    h = pyHash(pyNorm(BigInt.of(pyHash(pyNorm(n.abs()))) * dinv))
  }
  val r = n < 0 ? -h : h
  return r == -1 ? -2 : r
}

// format(Fraction, spec) for the presentation types e, E, f, F, g, G and %, worked out exactly
// and rounded half to even, as CPython 3.12's Fraction.__format__; with no type, str() padded.
internal fun __pyFracFormat(n0 : BigInt, d : BigInt, spec : string, plain : string) : string {
  val f = PyFormatSpec(spec)
  val type = f.type
  if (type == '\u{0}') { return __pyPad("", plain, f, '>') }
  if (!(type in ['e', 'E', 'f', 'F', 'g', 'G', '%'])) {
    throw pyValueError("Invalid format specifier '$spec' for object of type 'Fraction'")
  }
  val negative = n0 < 0
  var n = n0.abs()
  val prec = f.precision < 0 ? 6 : f.precision
  var body = ""
  if (type == 'f' or type == 'F' or type == '%') {
    if (type == '%') { n = n * 100 }
    val scaled = pyRoundHalfEven(n * BigInt.of(10).pow(prec), d)
    var digits = scaled.toString().padStart(prec + 1, '0')
    body = prec > 0 ? digits[..<(digits.size - prec)] + "." + digits[(digits.size - prec)..] : digits + (f.alt ? "." : "")
    if (type == '%') { body += "%" }
  } else {
    // e, E, g, G: the significant figures, and the power of ten of the first.
    val figures = type == 'e' or type == 'E' ? prec + 1 : (prec == 0 ? 1 : prec)
    var exp = 0
    var sig = BigInt.of(0)
    if (!n.isZero) {
      exp = n.toString().size - d.toString().size
      // 10**exp <= n/d < 10**(exp+1)
      fun pow10(k : int) : Pair<BigInt, BigInt> => k >= 0 ? Pair(BigInt.of(10).pow(k), BigInt.of(1)) : Pair(BigInt.of(1), BigInt.of(10).pow(-k))
      while (true) {
        val p = pow10(exp)
        if (n * p.second < d * p.first) { exp -= 1; continue }
        val q = pow10(exp + 1)
        if (n * q.second >= d * q.first) { exp += 1; continue }
        break
      }
      val shift = figures - 1 - exp
      sig = shift >= 0 ? pyRoundHalfEven(n * BigInt.of(10).pow(shift), d) : pyRoundHalfEven(n, d * BigInt.of(10).pow(-shift))
      if (sig >= BigInt.of(10).pow(figures)) { sig = sig / 10; exp += 1 }
    }
    val digits = sig.toString().padStart(figures, '0')
    if (type == 'e' or type == 'E') {
      body = digits[..<1] + (figures > 1 or f.alt ? "." : "") + digits[1..] + (type == 'e' ? "e" : "E") + (exp < 0 ? "-" : "+") + Math.abs(exp).toString().padStart(2, '0')
    } else {
      if (-4 <= exp and exp < figures) {
        val decimals = figures - 1 - exp
        val scaled = pyRoundHalfEven(n * BigInt.of(10).pow(decimals), d)
        var text = scaled.toString().padStart(decimals + 1, '0')
        var whole = decimals > 0 ? text[..<(text.size - decimals)] : text
        var fracPart = decimals > 0 ? text[(text.size - decimals)..] : ""
        if (!f.alt) { while (fracPart.endsWith("0")) { fracPart = fracPart[..<(fracPart.size - 1)] } }
        body = fracPart.isEmpty() ? whole + (f.alt ? "." : "") : whole + "." + fracPart
      } else {
        var rest = digits[1..]
        if (!f.alt) { while (rest.endsWith("0")) { rest = rest[..<(rest.size - 1)] } }
        body = digits[..<1] + (rest.isEmpty() ? (f.alt ? "." : "") : "." + rest) + (type == 'g' ? "e" : "E") + (exp < 0 ? "-" : "+") + Math.abs(exp).toString().padStart(2, '0')
      }
    }
  }
  if (f.grouping != '\u{0}') {
    val dot = body.indexOf(".")
    var intPart = dot >= 0 ? body[..<dot] : body
    val rest = dot >= 0 ? body[dot..] : ""
    var end = intPart.size
    while (end > 0 and !(intPart[end - 1] >= '0' and intPart[end - 1] <= '9')) { end -= 1 }
    val digitsOnly = intPart[..<end]
    val sb = StringBuilder()
    for i in 0..<digitsOnly.size {
      if (i > 0 and (digitsOnly.size - i) % 3 == 0) { sb.append(f.grouping) }
      sb.append(digitsOnly[i])
    }
    body = sb.toString() + intPart[end..] + rest
  }
  val zeroAll = negative and f.z and !body.any { it >= '1' and it <= '9' }
  val sign = negative and !zeroAll ? "-" : f.sign == '+' ? "+" : f.sign == ' ' ? " " : ""
  return __pyPad(sign, body, f, '>')
}

internal lazy val __pyFractionType : PyType = __pyMakeFractionType()

internal fun __pyMakeFractionType() : PyType {
  val m : open Map<string, any?> = {:}
  m["__slots__"] = PyTuple(["_numerator", "_denominator"])
  m["__new__"] = PyStaticMethod(PyBuiltin("__new__", { args, kw ->
    val cls = args[0]
    val a = PyArgs(args[1..], kw, "Fraction()")
    a.only(["numerator", "denominator"])
    val num = a.pos.isNotEmpty() ? a.pos[0] : a.get("numerator", 0)
    val den = a.pos.size > 1 ? a.pos[1] : a.get("denominator", null)
    if (den == null) {
      if (pyIsInt(num)) { pyMakeFraction(cls, pyBig(pyIndexValue(num)), BigInt.of(1), false) }
      else if (pyIsInstance(num, __pyFractionType)) { pyMakeFraction(cls, __pyNum(num), __pyDen(num), false) }
      else if (num is float) { val r = pyFloatRatio(num as float); pyMakeFraction(cls, r.first, r.second) }
      else if (num is string) { val r = __pyFractionFromText(num as string); pyMakeFraction(cls, r.first, r.second) }
      else { throw pyTypeError("argument should be a string or a Rational instance") }
    } else {
      if (!__pyIsRational(num) or !__pyIsRational(den)) { throw pyTypeError("both arguments should be Rational instances") }
      pyMakeFraction(cls, __pyNumOf(num) * __pyDenOf(den), __pyDenOf(num) * __pyNumOf(den))
    }
  }))
  m["numerator"] = PyProperty(PyBuiltin("numerator", { args, kw -> pyGetAttr(args[0], "_numerator") }), null, null, null)
  m["denominator"] = PyProperty(PyBuiltin("denominator", { args, kw -> pyGetAttr(args[0], "_denominator") }), null, null, null)
  m["real"] = PyProperty(PyBuiltin("real", { args, kw -> args[0] }), null, null, null)
  m["imag"] = PyProperty(PyBuiltin("imag", { args, kw -> 0 }), null, null, null)
  m["conjugate"] = pyLibMethod("Fraction", "conjugate") { self, a -> self }
  m["from_float"] = pyLibClassMethod("Fraction", "from_float") { cls, a ->
    val f = a.pos[0]
    if (pyIsInt(f)) { pyMakeFraction(cls, pyBig(pyIndexValue(f)), BigInt.of(1)) } else {
      if (!(f is float)) { throw pyTypeError("${pyRepr(f)} is not a float") }
      val r = pyFloatRatio(f as float)
      pyMakeFraction(cls, r.first, r.second)
    }
  }
  m["from_number"] = pyLibClassMethod("Fraction", "from_number") { cls, a ->
    val x = a.pos[0]
    if (pyIsInt(x)) { pyMakeFraction(cls, pyBig(pyIndexValue(x)), BigInt.of(1)) }
    else if (x is float) { val r = pyFloatRatio(x as float); pyMakeFraction(cls, r.first, r.second) }
    else if (pyIsInstance(x, __pyFractionType)) { pyMakeFraction(cls, __pyNum(x), __pyDen(x)) }
    else { throw pyTypeError("${pyRepr(pyTypeOf(x).name)} object cannot be interpreted as a rational number") }
  }
  m["as_integer_ratio"] = pyLibMethod("Fraction", "as_integer_ratio") { self, a -> PyTuple([pyNorm(__pyNum(self)), pyNorm(__pyDen(self))]) }
  m["is_integer"] = pyLibMethod("Fraction", "is_integer") { self, a -> __pyDen(self) == BigInt.of(1) }
  m["limit_denominator"] = pyLibMethod("Fraction", "limit_denominator") { self, a ->
    val maxDen = pyBig(pyIndexValue(a.pos.isNotEmpty() ? a.pos[0] : a.get("max_denominator", 1000000)))
    if (maxDen < 1) { throw pyValueError("max_denominator should be at least 1") }
    if (__pyDen(self) <= maxDen) { pyMakeFraction(pyTypeOf(self), __pyNum(self), __pyDen(self), false) } else {
      var p0 = BigInt.of(0)
      var q0 = BigInt.of(1)
      var p1 = BigInt.of(1)
      var q1 = BigInt.of(0)
      var n = __pyNum(self)
      var d = __pyDen(self)
      while (true) {
        val a2 = n.floorDiv(d)
        val q2 = q0 + a2 * q1
        if (q2 > maxDen) { break }
        val np1 = p0 + a2 * p1
        p0 = p1
        q0 = q1
        p1 = np1
        q1 = q2
        val nd = n - a2 * d
        n = d
        d = nd
      }
      val k = (maxDen - q0).floorDiv(q1)
      if (d * 2 * (q0 + k * q1) <= __pyDen(self)) { __pyFrac(p1, q1) } else { __pyFrac(p0 + k * p1, q0 + k * q1) }
    }
  }
  m["__repr__"] = pyLibMethod("Fraction", "__repr__") { self, a -> "${pyTypeOf(self).name}(${__pyNum(self)}, ${__pyDen(self)})" }
  m["__str__"] = pyLibMethod("Fraction", "__str__") { self, a ->
    __pyDen(self) == BigInt.of(1) ? __pyNum(self).toString() : "${__pyNum(self)}/${__pyDen(self)}"
  }
  m["__format__"] = pyLibMethod("Fraction", "__format__") { self, a ->
    val spec = a.pos[0] as string
    val plain = __pyDen(self) == BigInt.of(1) ? __pyNum(self).toString() : "${__pyNum(self)}/${__pyDen(self)}"
    __pyFracFormat(__pyNum(self), __pyDen(self), spec, plain)
  }
  fun op(name : string, rname : string, exact : (BigInt, BigInt, BigInt, BigInt) -> any?, inexact : (any?, any?) -> any?) {
    m[name] = __pyFracMethod(name, false, exact, inexact)
    m[rname] = __pyFracMethod(rname, true, exact, inexact)
  }
  op("__add__", "__radd__", { an, ad, bn, bd -> __pyFrac(an * bd + bn * ad, ad * bd) }, { x, y -> pyAdd(x, y) })
  op("__sub__", "__rsub__", { an, ad, bn, bd -> __pyFrac(an * bd - bn * ad, ad * bd) }, { x, y -> pySub(x, y) })
  op("__mul__", "__rmul__", { an, ad, bn, bd -> __pyFrac(an * bn, ad * bd) }, { x, y -> pyMul(x, y) })
  op("__truediv__", "__rtruediv__", { an, ad, bn, bd -> __pyFracDivZero(an * bd, bn * ad); __pyFrac(an * bd, ad * bn) }, { x, y -> pyDiv(x, y) })
  op("__floordiv__", "__rfloordiv__", { an, ad, bn, bd ->
    if (bn.isZero) { throw pyZeroDivisionError("Fraction(${an * bd}, 0)") }
    pyNorm((an * bd).floorDiv(ad * bn))
  }, { x, y -> pyFloorDiv(x, y) })
  op("__mod__", "__rmod__", { an, ad, bn, bd ->
    if (bn.isZero) { throw pyZeroDivisionError("Fraction(${an * bd}, 0)") }
    val da = ad * bd
    __pyFrac((an * bd).floorMod(bn * ad), da)
  }, { x, y -> pyMod(x, y) })
  op("__divmod__", "__rdivmod__", { an, ad, bn, bd ->
    if (bn.isZero) { throw pyZeroDivisionError("Fraction(${an * bd}, 0)") }
    val q = (an * bd).floorDiv(ad * bn)
    PyTuple([pyNorm(q), __pyFrac((an * bd).floorMod(bn * ad), ad * bd)])
  }, { x, y -> pyDivmod(x, y) })
  m["__pow__"] = pyLibMethod("Fraction", "__pow__") { self, a ->
    val b = a.pos[0]
    val an = __pyNum(self)
    val ad = __pyDen(self)
    if (__pyIsRational(b)) {
      if (__pyDenOf(b) == BigInt.of(1)) {
        val power = __pyNumOf(b)
        val pw = power.abs().toIntOrNull()
        if (pw == null) { throw pyOverflowError("exponent too large") }
        if (power >= 0) { pyMakeFraction(__pyFractionType, an.pow(pw!!), ad.pow(pw!!), false) }
        else if (an > 0) { pyMakeFraction(__pyFractionType, ad.pow(pw!!), an.pow(pw!!), false) }
        else if (an.isZero) { throw pyZeroDivisionError("Fraction(${ad.pow(pw!!)}, 0)") }
        else { pyMakeFraction(__pyFractionType, (-ad).pow(pw!!), (-an).pow(pw!!), false) }
      } else { pyPow(pyRatioToFloat(an, ad), pyRatioToFloat(__pyNumOf(b), __pyDenOf(b))) }
    } else if (b is float or b is Complex) { pyPow(pyRatioToFloat(an, ad), b) } else { pyNotImplemented }
  }
  m["__rpow__"] = pyLibMethod("Fraction", "__rpow__") { self, a ->
    val base = a.pos[0]
    val bn = __pyNum(self)
    val bd = __pyDen(self)
    if (bd == BigInt.of(1) and bn >= 0) { pyPow(base, pyNorm(bn)) }
    else if (__pyIsRational(base)) { pyPow(__pyFrac(__pyNumOf(base), __pyDenOf(base)), self) }
    else if (bd == BigInt.of(1)) { pyPow(base, pyNorm(bn)) }
    else { pyPow(base, pyRatioToFloat(bn, bd)) }
  }
  m["__pos__"] = pyLibMethod("Fraction", "__pos__") { self, a -> pyMakeFraction(__pyFractionType, __pyNum(self), __pyDen(self), false) }
  m["__neg__"] = pyLibMethod("Fraction", "__neg__") { self, a -> pyMakeFraction(__pyFractionType, -__pyNum(self), __pyDen(self), false) }
  m["__abs__"] = pyLibMethod("Fraction", "__abs__") { self, a -> pyMakeFraction(__pyFractionType, __pyNum(self).abs(), __pyDen(self), false) }
  m["__int__"] = pyLibMethod("Fraction", "__int__") { self, a ->
    val n = __pyNum(self)
    val d = __pyDen(self)
    pyNorm(n < 0 ? -((-n) / d) : n / d)
  }
  m["__trunc__"] = m["__int__"]
  m["__floor__"] = pyLibMethod("Fraction", "__floor__") { self, a -> pyNorm(__pyNum(self).floorDiv(__pyDen(self))) }
  m["__ceil__"] = pyLibMethod("Fraction", "__ceil__") { self, a -> pyNorm(-((-__pyNum(self)).floorDiv(__pyDen(self)))) }
  m["__round__"] = pyLibMethod("Fraction", "__round__") { self, a ->
    val nd = a.pos.isNotEmpty() ? a.pos[0] : a.get("ndigits", null)
    val n = __pyNum(self)
    val d = __pyDen(self)
    if (nd == null) { pyNorm(pyRoundHalfEven(n, d)) } else {
      val k = pyIndex(nd)
      val shift = BigInt.of(10).pow(Math.abs(k))
      if (k > 0) { __pyFrac(pyRoundHalfEven(n * shift, d), shift) } else { __pyFrac(pyRoundHalfEven(n, d * shift) * shift, BigInt.of(1)) }
    }
  }
  m["__float__"] = pyLibMethod("Fraction", "__float__") { self, a -> pyRatioToFloat(__pyNum(self), __pyDen(self)) }
  m["__complex__"] = pyLibMethod("Fraction", "__complex__") { self, a -> Complex(pyRatioToFloat(__pyNum(self), __pyDen(self)), 0.0) }
  m["__bool__"] = pyLibMethod("Fraction", "__bool__") { self, a -> !__pyNum(self).isZero }
  m["__hash__"] = pyLibMethod("Fraction", "__hash__") { self, a -> __pyFracHash(__pyNum(self), __pyDen(self)) }
  m["__eq__"] = pyLibMethod("Fraction", "__eq__") { self, a ->
    val b = a.pos[0]
    if (__pyIsRational(b)) { __pyNum(self) == __pyNumOf(b) and __pyDen(self) == __pyDenOf(b) }
    else if (b is Complex and (b as Complex).im == 0.0) { __pyFracCompare(self, (b as Complex).re, { x, y -> x == y }) }
    else if (b is float) { __pyFracCompare(self, b, { x, y -> x == y }) }
    else { pyNotImplemented }
  }
  m["__lt__"] = pyLibMethod("Fraction", "__lt__") { self, a -> __pyFracCompare(self, a.pos[0], { x, y -> x < y }) }
