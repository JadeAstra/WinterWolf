  for name in __pyStrNames() {
    if (name.startsWith("__")) { continue }
    members[name] = pyLibMethod("UserString", name) { self, a ->
      val names : open List<string> = []
      val values : open List<any?> = a.pos.toOpenList()
      for (k, v) in a.kw { names.add(k); values.add(v) }
      val r = pyCallMethodV(__pyData(self), name, values, names.isEmpty() ? null : names)
      r is string ? pyCall1(pyTypeOf(self), r) : r
