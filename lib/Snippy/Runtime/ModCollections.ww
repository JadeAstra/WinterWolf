  return pyNativeModule("collections", m)
}

// ---- copy ----

internal fun __pyAtomic(x : any?) : bool =>
  x == null or x is bool or x is int or x is float or x is BigInt or x is Complex or x is string or x is Bytes or x is PyRange or
  x is PyType or x is PyFunction or x is PyBuiltin or x === pyEllipsis or x === pyNotImplemented or x is PyModule or
  (x is PySet and (x as PySet).frozen)

fun pyShallowCopy(x : any?) : any? {
  if (__pyAtomic(x) or x is PyTuple) { return x }
  if (x is open List<any?>) { return pyNewList((x as List<any?>).toOpenList()) }
  if (x is PyDict) { return (x as PyDict).copy() }
  if (x is PySet) { return (x as PySet).copy(false) }
  if (x is PyByteArray) { return PyByteArray(Bytes((x as PyByteArray).bytes)) }
  if (x is PyNative) {
    val r = pyNativeSpecial(x as PyNative, "__copy__", [])
    if (r !== pyUnbound) { return r }
    return x
  }
  if (x is PyObject) {
    val o = x as PyObject
    val m = o.cls.lookup("__copy__")
    if (m !== pyUnbound and m != null) { return __pyCall1Special(m, x) }
    val c = PyObject(o.cls)
    c.dict = o.dict == null ? null : o.dict!!.copy()
    c.value = o.value is PyTuple ? o.value : pyShallowCopy(o.value)
    return c
  }
  return x
}

// deepcopy: `memo` by id() for the runtime's own objects, as CPython's memo; `seen` the copies of
// values with no id of their own here (a list is WinterWolf's), found by identity.
fun pyDeepCopy(x : any?, memo : PyDict, seen : open List<Pair<any?, any?>>) : any? {
  if (__pyAtomic(x)) { return x }
  val identified = x is PyIdentified
  val id : any? = identified ? pyId(x) : null
  if (identified) {
    val had = memo.get(id, pyUnbound)
    if (had !== pyUnbound) { return had }
  } else {
    for p in seen { if (p.first === x) { return p.second } }
  }
  fun keep(copy : any?) {
    if (identified) { memo.set(id, copy) } else { seen.add(Pair(x, copy)) }
  }
  return when (x) {
    is PyTuple -> {
      val items = (x as PyTuple).items.map { pyDeepCopy(it, memo, seen) }
      var same = true
      for (i, v) in items.withIndex() { if (!pyIs(v, (x as PyTuple).items[i])) { same = false } }
      val r = same ? x : PyTuple(items)
      keep(r)
      r
    }
    is open List<any?> -> {
      val r : open List<any?> = []
      keep(r)
      for v in x as List<any?> { r.add(pyDeepCopy(v, memo, seen)) }
      r
    }
    is PyDict -> {
      val r = PyDict()
      keep(r)
      for k in (x as PyDict).keyList() { r.set(pyDeepCopy(k, memo, seen), pyDeepCopy((x as PyDict).get(k, null), memo, seen)) }
      r
    }
    is PySet -> {
      val r = PySet(false)
      keep(r)
      for k in (x as PySet).items() { r.add(pyDeepCopy(k, memo, seen)) }
      r
    }
    is PyNative -> {
      val r = pyNativeSpecial(x as PyNative, "__deepcopy__", [memo])
      r === pyUnbound ? pyShallowCopy(x) : r
    }
    is PyObject -> {
      val o = x as PyObject
      val m = o.cls.lookup("__deepcopy__")
      if (m !== pyUnbound and m != null) { return __pyCall2Special(m, x, memo) }
      val c = PyObject(o.cls)
      keep(c)
      c.value = pyDeepCopy(o.value, memo, seen)
      if (o.dict == null) { c.dict = null } else {
        val d = PyDict()
        for k in o.dict!!.keyList() { d.set(k, pyDeepCopy(o.dict!!.get(k, null), memo, seen)) }
        c.dict = d
      }
      c
    }
    else -> x
  }
}

fun pyCopyModule() : PyModule {
  val m : open Map<string, any?> = {:}
  m["copy"] = __pyB("copy") { a -> pyShallowCopy(a.pos[0]) }
  m["deepcopy"] = __pyB("deepcopy") { a ->
    val memo = a.pos.size > 1 ? a.pos[1] : a.get("memo", null)
    pyDeepCopy(a.pos[0], memo is PyDict ? memo as PyDict : PyDict(), [])
  }
  m["replace"] = __pyB("replace") { a ->
    val obj = a.pos[0]
    val r = pyTypeOf(obj).lookup("__replace__")
    if (r === pyUnbound) { throw pyTypeError("replace() does not support ${pyTypeName(obj)} objects") }
    val names : open List<string> = []
    val values : open List<any?> = [obj]
    for (k, v) in a.kw { names.add(k); values.add(v) }
    pyCallV(r, values, names.isEmpty() ? null : names)
  }
  val error = __pyExc("Error", pyExceptionType)
  error.module = "copy"
  m["Error"] = error
  m["error"] = error
  return pyNativeModule("copy", m)
}

// A collections class CPython makes in C: its messages name it collections.X.
internal fun __pyCType(name : string, bases : List<PyType>, members : Map<string, any?>) : PyType {
  val t = pyLibClass(name, "collections", bases, members)
  t.cName = "collections." + name
  return t
}

// Whether `test` holds for the counts of every key of either Counter, the missing ones 0.
internal fun __pyCounterAll(self : any?, other : any?, test : (any?, any?) -> bool) : any? {
  if (!pyIsInstance(other, __pyCounterType)) { return pyNotImplemented }
  val x = __pyDictOf(self)
  val y = __pyDictOf(other)
  return x.keyList().all { test(x.get(it, 0), y.get(it, 0)) } and y.keyList().all { test(x.get(it, 0), y.get(it, 0)) }
}
