    members[f] = PyProperty(PyBuiltin(f, { args, kw -> ((args[0] as PyObject).value as PyTuple).items[i] }), null, null, "Alias for field number $i")
  }
  val module = a.get("module", null)
  val made = pyLibClass(typename, module == null ? "__main__" : module as string, [pyTupleType], members)
  return made
}

// ---- ChainMap, UserDict, UserList, UserString ----

internal fun __pyMaps(self : any?) : List<any?> => pyIterable(pyGetAttr(self, "maps"))

