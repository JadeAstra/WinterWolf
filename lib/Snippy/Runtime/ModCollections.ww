  members["__repr__"] = pyLibMethod("UserString", "__repr__") { self, a -> pyRepr(__pyData(self)) }
  members["__len__"] = pyLibMethod("UserString", "__len__") { self, a -> pyLength(__pyData(self)) }
  members["__eq__"] = pyLibMethod("UserString", "__eq__") { self, a ->
    val o = a.pos[0]
    pyEq(__pyData(self), pyIsInstance(o, __pyUserStringType) ? __pyData(o) : o)
  }
  members["__add__"] = pyLibMethod("UserString", "__add__") { self, a ->
    val o = a.pos[0]
    pyCall1(pyTypeOf(self), pyAdd(__pyData(self), pyIsInstance(o, __pyUserStringType) ? __pyData(o) : pyStr(o)))
