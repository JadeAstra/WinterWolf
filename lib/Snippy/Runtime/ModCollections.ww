  return pyLibClass("UserString", "collections", [pyObjectType], members)
}

fun pyCollectionsModule() : PyModule {
  val m : open Map<string, any?> = {:}
  m["Counter"] = __pyCounterType
  m["OrderedDict"] = __pyOrderedDictType
