// The keys of a ChainMap, the first map's last, in the order of a dict made from the maps backwards.
internal fun __pyChainKeys(self : any?) : PyDict {
  val d = PyDict()
  for m in __pyMaps(self).reversed() { for k in pyIterable(m) { d.set(k, null) } }
  return d
}

internal fun __pyData(self : any?) : any? => pyGetAttr(self, "data")

