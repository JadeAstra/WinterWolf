import Snippy.Text.*
// cmath (the Snippy plan, part 5.3, step 2): ww's Complex functions, which are CPython's cmath
// step for step (W6 of docs/snippy-ww-checklist.html): its answers, its special values, and its
// errors, which ww throws as IllegalArgumentException ("math domain error") and
// ArithmeticException ("math range error") and Snippy raises as ValueError and OverflowError.

// A complex argument, as cmath takes one: complex, a real number, or an object with
// __complex__, __float__ or __index__.
fun pyComplexArg(x : any?) : Complex {
  if (x is Complex) { return x as Complex }
  if (x is PyObject) {
    val m = (x as PyObject).cls.lookup("__complex__")
    if (m !== pyUnbound and m != null) {
      val r = __pyCall1Special(m, x)
      if (!(r is Complex)) { throw pyTypeError("__complex__ returned non-complex (type ${pyTypeName(r)})") }
      return r as Complex
    }
  }
  return Complex(pyRealArg(x), 0.0)
}

// `f`'s answer, its exceptions raised as CPython raises them.
internal fun __pyCmath(f : () -> Complex) : Complex {
  try {
    return f()
  } catch (e : IllegalArgumentException) {
    throw pyValueError(e.message ?: "math domain error")
  } catch (e : ArithmeticException) {
    throw pyOverflowError(e.message ?: "math range error")
  }
}

fun pyCmathModule() : PyModule {
  val m : open Map<string, any?> = {:}
  m["pi"] = Math.pi
  m["e"] = Math.e
  m["tau"] = 2.0 * Math.pi
  m["inf"] = pyInf
  m["nan"] = pyNaN
  m["infj"] = Complex(0.0, pyInf)
  m["nanj"] = Complex(0.0, pyNaN)
  fun one(name : string, f : (Complex) -> Complex) {
    m[name] = __pyB(name) { a ->
      __pyCheckCount(name, a, 1, 1)
      val z = pyComplexArg(a.pos[0])
      __pyCmath { f(z) }
    }
  }
  one("sqrt", { z -> z.sqrt() })
  one("exp", { z -> z.exp() })
  one("log10", { z -> z.log10() })
  one("asinh", { z -> z.asinh() })
  one("asin", { z -> z.asin() })
  one("acos", { z -> z.acos() })
  one("acosh", { z -> z.acosh() })
  one("atanh", { z -> z.atanh() })
  one("atan", { z -> z.atan() })
  one("cosh", { z -> z.cosh() })
  one("sinh", { z -> z.sinh() })
  one("tanh", { z -> z.tanh() })
  one("cos", { z -> z.cos() })
  one("sin", { z -> z.sin() })
  one("tan", { z -> z.tan() })
  m["log"] = __pyB("log") { a ->
    __pyCheckCount("log", a, 1, 2)
    val x = pyComplexArg(a.pos[0])
    if (a.pos.size < 2) { __pyCmath { x.log() } } else {
      // As CPython: the base's error, or a base whose log is 0, raises; log(0) then gives -inf
      // over it, without raising.
      val lb = __pyCmath { pyComplexArg(a.pos[1]).log() }
      if (lb.re == 0.0 and lb.im == 0.0) { throw pyValueError("math domain error") }
      val lx = x.re == 0.0 and x.im == 0.0 ? Complex(-pyInf, Math.atan2(x.im, x.re)) : x.log()
      lx / lb
    }
  }
  m["phase"] = __pyB("phase") { a ->
    pyComplexArg(a.pos[0]).arg()
  }
  m["polar"] = __pyB("polar") { a ->
    val z = pyComplexArg(a.pos[0])
    val r = z.abs()
    if (r.isInfinite() and !z.re.isInfinite() and !z.im.isInfinite()) { throw pyOverflowError("math range error") }
    PyTuple([r, z.arg()])
  }
  m["rect"] = __pyB("rect") { a ->
    __pyCheckCount("rect", a, 2, 2)
    val r = pyRealArg(a.pos[0])
    val phi = pyRealArg(a.pos[1])
    __pyCmath { Complex.fromPolar(r, phi) }
  }
  m["isfinite"] = __pyB("isfinite") { a ->
    val z = pyComplexArg(a.pos[0])
    !z.re.isNaN() and !z.re.isInfinite() and !z.im.isNaN() and !z.im.isInfinite()
  }
  m["isinf"] = __pyB("isinf") { a -> val z = pyComplexArg(a.pos[0]); z.re.isInfinite() or z.im.isInfinite() }
  m["isnan"] = __pyB("isnan") { a -> val z = pyComplexArg(a.pos[0]); z.re.isNaN() or z.im.isNaN() }
  m["isclose"] = __pyB("isclose") { a ->
    a.only(["rel_tol", "abs_tol"])
    val x = pyComplexArg(a.pos[0])
    val y = pyComplexArg(a.pos[1])
    val rel = pyRealArg(a.get("rel_tol", 1e-09))
    val abs = pyRealArg(a.get("abs_tol", 0.0))
    if (rel < 0.0 or abs < 0.0) { throw pyValueError("tolerances must be non-negative") }
    if (x.re == y.re and x.im == y.im) { true } else if (x.re.isInfinite() or x.im.isInfinite() or y.re.isInfinite() or y.im.isInfinite()) { false } else {
      val diff = (x - y).abs()
      (diff <= rel * y.abs() or diff <= rel * x.abs()) or diff <= abs
    }
  }
  return pyNativeModule("cmath", m)
}
