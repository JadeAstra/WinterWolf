import Snippy.Text.*
// datetime (the Snippy plan, part 5.3, step 3), in WinterWolf, after CPython's _pydatetime:
// timedelta, date, time, datetime, tzinfo and timezone as Python classes (datetime a date), their
// fields kept as ints, their arithmetic on ordinals and microseconds exactly, their text as
// CPython's, and their messages naming them as CPython's C types are named (datetime.date...).

internal fun __pyI(o : any?, name : string) : int => pyIndex(pyGetAttr(o, name))
internal fun __pyQual(o : any?) : string {
  return pyTypeName(o)
}
internal fun __pyDtClass(name : string, bases : List<PyType>, members : Map<string, any?>) : PyType {
  val t = pyLibClass(name, "datetime", bases, members)
  t.cName = "datetime." + name
  return t
}
internal fun __pyMake(cls : any?, fields : List<Pair<string, any?>>) : any? {
  val o = PyObject(cls as PyType)
  o.dict = PyDict()
  for f in fields { o.dict!!.set(f.first, f.second) }
  return o
}

// ---- timedelta ----

internal val __pyUsPerDay = 86400000000

// A timedelta of `us` microseconds in all, as days, seconds and microseconds.
internal fun __pyTd(cls : any?, us : BigInt) : any? {
  val perDay = BigInt.of(__pyUsPerDay)
  val days = us.floorDiv(perDay)
  val rest = us - days * perDay
  if (days.abs() > BigInt.of(2147483647)) { throw pyOverflowError("Python int too large to convert to C int") }
  val d = days.toInt()
  if (d > 999999999 or d < -999999999) { throw pyOverflowError("days=$d; must have magnitude <= 999999999") }
  val r = rest.toInt()
  return __pyMake(cls, [Pair("_days", d), Pair("_seconds", r / 1000000), Pair("_microseconds", r % 1000000)])
}
internal fun __pyTdUs(td : any?) : BigInt =>
  BigInt.of(__pyI(td, "_days")) * BigInt.of(__pyUsPerDay) + BigInt.of(__pyI(td, "_seconds") * 1000000 + __pyI(td, "_microseconds"))
internal fun __pyIsTd(x : any?) : bool => pyIsInstance(x, __pyTimedeltaType)

// A number of a unit (microseconds per one) as microseconds, exactly: an int or a float.
internal fun __pyUnitUs(x : any?, perUnit : int) : Pair<BigInt, BigInt> {
  if (pyIsInt(x)) { return Pair(pyBig(pyIndexValue(x)) * BigInt.of(perUnit), BigInt.of(1)) }
  if (x is float) {
    val r = pyFloatRatio(x as float)
    return Pair(r.first * BigInt.of(perUnit), r.second)
  }
  throw pyTypeError("unsupported type for timedelta ${"component"} component: ${pyTypeName(x)}")
}

internal lazy val __pyTimedeltaType : PyType = __pyMakeTimedelta()
internal fun __pyMakeTimedelta() : PyType {
  val m : open Map<string, any?> = {:}
  m["__new__"] = PyStaticMethod(PyBuiltin("__new__", { args, kw ->
    val cls = args[0]
    val a = PyArgs(args[1..], kw, "timedelta()")
    a.only(["days", "seconds", "microseconds", "milliseconds", "minutes", "hours", "weeks"])
    val names = ["days", "seconds", "microseconds", "milliseconds", "minutes", "hours", "weeks"]
    val per = [__pyUsPerDay, 1000000, 1, 1000, 60000000, 3600000000, 7 * __pyUsPerDay]
    var n = BigInt.of(0)
    var d = BigInt.of(1)
    for (i, name) in names.withIndex() {
      val v = i < a.pos.size ? a.pos[i] : a.get(name, null)
      if (v == null) { continue }
      if (!pyIsInt(v) and !(v is float)) { throw pyTypeError("unsupported type for timedelta $name component: ${pyTypeName(v)}") }
      val u = __pyUnitUs(v, per[i])
      n = n * u.second + u.first * d
      d = d * u.second
    }
    __pyTd(cls, pyRoundHalfEven(n, d))
  }))
  m["days"] = PyProperty(PyBuiltin("days", { args, kw -> pyGetAttr(args[0], "_days") }), null, null, null)
  m["seconds"] = PyProperty(PyBuiltin("seconds", { args, kw -> pyGetAttr(args[0], "_seconds") }), null, null, null)
  m["microseconds"] = PyProperty(PyBuiltin("microseconds", { args, kw -> pyGetAttr(args[0], "_microseconds") }), null, null, null)
  m["total_seconds"] = pyLibMethod("timedelta", "total_seconds") { self, a -> pyRatioToFloat(__pyTdUs(self), BigInt.of(1000000)) }
  m["__str__"] = pyLibMethod("timedelta", "__str__") { self, a ->
    val days = __pyI(self, "_days")
    val s = __pyI(self, "_seconds")
    val us = __pyI(self, "_microseconds")
    val hms = "${s / 3600}:${__pyPadNum(s / 60 % 60, 2, '0')}:${__pyPadNum(s % 60, 2, '0')}" + (us != 0 ? "." + __pyPadNum(us, 6, '0') : "")
    days != 0 ? "$days day${Math.abs(days) != 1 ? "s" : ""}, $hms" : hms
  }
  m["__repr__"] = pyLibMethod("timedelta", "__repr__") { self, a ->
    val parts : open List<string> = []
    val days = __pyI(self, "_days")
    val s = __pyI(self, "_seconds")
    val us = __pyI(self, "_microseconds")
    if (days != 0) { parts.add("days=$days") }
    if (s != 0) { parts.add("seconds=$s") }
    if (us != 0) { parts.add("microseconds=$us") }
    "${__pyQual(self)}(${parts.isEmpty() ? "0" : parts.join(", ")})"
  }
  fun same(a : any?) : bool => __pyIsTd(a)
  m["__add__"] = pyLibMethod("timedelta", "__add__") { self, a -> same(a.pos[0]) ? __pyTd(__pyTimedeltaType, __pyTdUs(self) + __pyTdUs(a.pos[0])) : pyNotImplemented }
  m["__radd__"] = m["__add__"]
  m["__sub__"] = pyLibMethod("timedelta", "__sub__") { self, a -> same(a.pos[0]) ? __pyTd(__pyTimedeltaType, __pyTdUs(self) - __pyTdUs(a.pos[0])) : pyNotImplemented }
  m["__rsub__"] = pyLibMethod("timedelta", "__rsub__") { self, a -> same(a.pos[0]) ? __pyTd(__pyTimedeltaType, __pyTdUs(a.pos[0]) - __pyTdUs(self)) : pyNotImplemented }
  m["__neg__"] = pyLibMethod("timedelta", "__neg__") { self, a -> __pyTd(__pyTimedeltaType, -__pyTdUs(self)) }
  m["__pos__"] = pyLibMethod("timedelta", "__pos__") { self, a -> __pyTd(__pyTimedeltaType, __pyTdUs(self)) }
  m["__abs__"] = pyLibMethod("timedelta", "__abs__") { self, a -> __pyTd(__pyTimedeltaType, __pyTdUs(self).abs()) }
  m["__mul__"] = pyLibMethod("timedelta", "__mul__") { self, a ->
    val o = a.pos[0]
    if (pyIsInt(o)) { __pyTd(__pyTimedeltaType, __pyTdUs(self) * pyBig(pyIndexValue(o))) }
    else if (o is float) { val r = pyFloatRatio(o as float); __pyTd(__pyTimedeltaType, pyRoundHalfEven(__pyTdUs(self) * r.first, r.second)) }
    else { pyNotImplemented }
  }
  m["__rmul__"] = m["__mul__"]
  m["__truediv__"] = pyLibMethod("timedelta", "__truediv__") { self, a ->
    val o = a.pos[0]
    if (same(o)) {
      val den = __pyTdUs(o)
      if (den.isZero) { throw pyZeroDivisionError("division by zero") }
      pyRatioToFloat(__pyTdUs(self), den)
    } else if (pyIsInt(o)) {
      val k = pyBig(pyIndexValue(o))
      if (k.isZero) { throw pyZeroDivisionError("division by zero") }
      __pyTd(__pyTimedeltaType, pyRoundHalfEven(__pyTdUs(self), k))
    } else if (o is float) {
      val r = pyFloatRatio(o as float)
      if (r.first.isZero) { throw pyZeroDivisionError("division by zero") }
      __pyTd(__pyTimedeltaType, pyRoundHalfEven(__pyTdUs(self) * r.second, r.first))
    } else { pyNotImplemented }
  }
  m["__floordiv__"] = pyLibMethod("timedelta", "__floordiv__") { self, a ->
    val o = a.pos[0]
    if (same(o)) {
      val den = __pyTdUs(o)
      if (den.isZero) { throw pyZeroDivisionError("division by zero") }
      pyNorm(__pyTdUs(self).floorDiv(den))
    } else if (pyIsInt(o)) {
      val k = pyBig(pyIndexValue(o))
      if (k.isZero) { throw pyZeroDivisionError("division by zero") }
      __pyTd(__pyTimedeltaType, __pyTdUs(self).floorDiv(k))
    } else { pyNotImplemented }
  }
  m["__mod__"] = pyLibMethod("timedelta", "__mod__") { self, a ->
    val o = a.pos[0]
    if (!same(o)) { pyNotImplemented } else {
      val den = __pyTdUs(o)
      if (den.isZero) { throw pyZeroDivisionError("division by zero") }
      __pyTd(__pyTimedeltaType, __pyTdUs(self).floorMod(den))
    }
  }
  m["__divmod__"] = pyLibMethod("timedelta", "__divmod__") { self, a ->
    val o = a.pos[0]
    if (!same(o)) { pyNotImplemented } else {
      val den = __pyTdUs(o)
      if (den.isZero) { throw pyZeroDivisionError("division by zero") }
      PyTuple([pyNorm(__pyTdUs(self).floorDiv(den)), __pyTd(__pyTimedeltaType, __pyTdUs(self).floorMod(den))])
    }
  }
  fun cmp(name : string, test : (int) -> bool) {
    m[name] = pyLibMethod("timedelta", name) { self, a -> same(a.pos[0]) ? test(__pyTdUs(self).compareTo(__pyTdUs(a.pos[0]))) : pyNotImplemented }
  }
  cmp("__eq__", { c -> c == 0 })
  cmp("__lt__", { c -> c < 0 })
  cmp("__le__", { c -> c <= 0 })
  cmp("__gt__", { c -> c > 0 })
  cmp("__ge__", { c -> c >= 0 })
  m["__hash__"] = pyLibMethod("timedelta", "__hash__") { self, a ->
    pyHash(PyTuple([pyGetAttr(self, "_days"), pyGetAttr(self, "_seconds"), pyGetAttr(self, "_microseconds")]))
  }
  m["__bool__"] = pyLibMethod("timedelta", "__bool__") { self, a -> !__pyTdUs(self).isZero }
  val t = __pyDtClass("timedelta", [pyObjectType], m)
  t.dict["min"] = __pyTd(t, BigInt.of(-999999999) * BigInt.of(__pyUsPerDay))
  t.dict["max"] = __pyTd(t, BigInt.of(1000000000) * BigInt.of(__pyUsPerDay) - BigInt.of(1))
  t.dict["resolution"] = __pyTd(t, BigInt.of(1))
  return t
}
internal fun __pyTdOf(days : int, seconds : int, us : int) : any? =>
  __pyTd(__pyTimedeltaType, BigInt.of(days) * BigInt.of(__pyUsPerDay) + BigInt.of(seconds) * BigInt.of(1000000) + BigInt.of(us))

// ---- Checks ----

internal fun __pyCheckDate(y : int, m : int, d : int) {
  if (y < 1 or y > 9999) { throw pyValueError("year must be in 1..9999, not $y") }
  if (m < 1 or m > 12) { throw pyValueError("month must be in 1..12, not $m") }
  val dim = pyDaysInMonth(y, m)
  if (d < 1 or d > dim) { throw pyValueError("day $d must be in range 1..$dim for month $m in year $y") }
}
internal fun __pyCheckTime(h : int, mi : int, s : int, us : int, fold : int) {
  if (h < 0 or h > 23) { throw pyValueError("hour must be in 0..23, not $h") }
  if (mi < 0 or mi > 59) { throw pyValueError("minute must be in 0..59, not $mi") }
  if (s < 0 or s > 59) { throw pyValueError("second must be in 0..59, not $s") }
  if (us < 0 or us > 999999) { throw pyValueError("microsecond must be in 0..999999, not $us") }
  if (fold != 0 and fold != 1) { throw pyValueError("fold must be either 0 or 1") }
}
internal fun __pyCheckTz(tz : any?) {
  if (tz != null and !pyIsInstance(tz, __pyTzinfoType)) {
    throw pyTypeError("tzinfo argument must be None or of a tzinfo subclass, not type '${pyTypeName(tz)}'")
  }
}
internal fun __pyIntArgOf(x : any?, name : string) : int {
  if (x is float) { throw pyTypeError("'float' object cannot be interpreted as an integer") }
  return pyIndex(x)
}

internal fun __pyNewDate(cls : any?, y : int, m : int, d : int) : any? {
  __pyCheckDate(y, m, d)
  return __pyMake(cls, [Pair("_year", y), Pair("_month", m), Pair("_day", d)])
}
internal fun __pyNewDatetime(cls : any?, y : int, mo : int, d : int, h : int, mi : int, s : int, us : int, tz : any?, fold : int) : any? {
  __pyCheckDate(y, mo, d)
  __pyCheckTime(h, mi, s, us, fold)
  __pyCheckTz(tz)
  return __pyMake(cls, [Pair("_year", y), Pair("_month", mo), Pair("_day", d), Pair("_hour", h), Pair("_minute", mi),
    Pair("_second", s), Pair("_microsecond", us), Pair("_tzinfo", tz), Pair("_fold", fold)])
}
internal fun __pyNewTime(cls : any?, h : int, mi : int, s : int, us : int, tz : any?, fold : int) : any? {
  __pyCheckTime(h, mi, s, us, fold)
  __pyCheckTz(tz)
  return __pyMake(cls, [Pair("_hour", h), Pair("_minute", mi), Pair("_second", s), Pair("_microsecond", us), Pair("_tzinfo", tz), Pair("_fold", fold)])
}

internal fun __pyIsDatetime(x : any?) : bool => pyIsInstance(x, __pyDatetimeType)
internal fun __pyIsDate(x : any?) : bool => pyIsInstance(x, __pyDateType)

// ---- Offsets and their text ----

// tzinfo.utcoffset(dt) as microseconds, or null.
internal fun __pyOffsetUs(tz : any?, dt : any?) : BigInt? {
  if (tz == null) { return null }
  val off = pyCall1(pyGetAttr(tz, "utcoffset"), dt)
  if (off == null) { return null }
  if (!__pyIsTd(off)) { throw pyTypeError("tzinfo.utcoffset() must return None or timedelta, not '${pyTypeName(off)}'") }
  return __pyTdUs(off)
}

// "+HH:MM" (":SS" and ".ffffff" where they are not 0), with `sep` between them.
internal fun __pyOffsetText(us0 : BigInt, sep : string) : string {
  val negative = us0 < 0
  var us = us0.abs().toInt()
  val hh = us / 3600000000
  us = us % 3600000000
  val mm = us / 60000000
  us = us % 60000000
  val ss = us / 1000000
  val rest = us % 1000000
  var text = (negative ? "-" : "+") + __pyPadNum(hh, 2, '0') + sep + __pyPadNum(mm, 2, '0')
  if (ss != 0 or rest != 0) { text += sep + __pyPadNum(ss, 2, '0') }
  if (rest != 0) { text += "." + __pyPadNum(rest, 6, '0') }
  return text
}

internal fun __pyTimeText(h : int, mi : int, s : int, us : int, timespec : string) : string {
  return when (timespec) {
    "auto" -> __pyPadNum(h, 2, '0') + ":" + __pyPadNum(mi, 2, '0') + ":" + __pyPadNum(s, 2, '0') + (us != 0 ? "." + __pyPadNum(us, 6, '0') : "")
    "hours" -> __pyPadNum(h, 2, '0')
    "minutes" -> __pyPadNum(h, 2, '0') + ":" + __pyPadNum(mi, 2, '0')
    "seconds" -> __pyPadNum(h, 2, '0') + ":" + __pyPadNum(mi, 2, '0') + ":" + __pyPadNum(s, 2, '0')
    "milliseconds" -> __pyPadNum(h, 2, '0') + ":" + __pyPadNum(mi, 2, '0') + ":" + __pyPadNum(s, 2, '0') + "." + __pyPadNum(us / 1000, 3, '0')
    "microseconds" -> __pyPadNum(h, 2, '0') + ":" + __pyPadNum(mi, 2, '0') + ":" + __pyPadNum(s, 2, '0') + "." + __pyPadNum(us, 6, '0')
    else -> throw pyValueError("Unknown timespec value")
  }
}

// strftime for a date, time or datetime: %f, %z, %:z and %Z of its own, the rest as time.strftime.
internal fun __pyDtStrftime(fmt : string, y : int, mo : int, d : int, h : int, mi : int, s : int, us : int, tz : any?, dt : any?) : string {
  val sb = StringBuilder()
  var i = 0
  while (i < fmt.size) {
    val c = fmt[i]
    if (c == '%' and i + 1 < fmt.size) {
      val n = fmt[i + 1]
      if (n == 'f') { sb.append(__pyPadNum(us, 6, '0')); i += 2; continue }
      if (n == 'z') {
        val off = __pyOffsetUs(tz, dt)
        if (off != null) { sb.append(__pyOffsetText(off!!, "")) }
        i += 2
        continue
      }
      if (n == ':' and i + 2 < fmt.size and fmt[i + 2] == 'z') {
        val off = __pyOffsetUs(tz, dt)
        if (off != null) { sb.append(__pyOffsetText(off!!, ":")) }
        i += 3
        continue
      }
      if (n == 'Z') {
        if (tz != null) {
          val name = pyCall1(pyGetAttr(tz, "tzname"), dt)
          if (name != null) { sb.append((name as string).replace("%", "%%")) }
        }
        i += 2
        continue
      }
      sb.append(c)
      sb.append(n)
      i += 2
      continue
    }
    sb.append(c)
    i += 1
  }
  val yday = pyDaysBeforeMonth(y, mo) + d
  return pyStrftime(sb.toString(), PyTm(y, mo, d, h, mi, s, pyWeekday(y, mo, d), yday, -1, null, null))
}

// ---- ISO text ----

internal fun __pyIsoBad(s : string) : PyError => pyValueError("Invalid isoformat string: ${pyRepr(s)}")
internal fun __pyDigitsAt(s : string, at : int, n : int) : int {
  if (at + n > s.size) { return -1 }
  for k in at..<(at + n) { if (!(s[k] >= '0' and s[k] <= '9')) { return -1 } }
  return s[at..<(at + n)].toInt()
}

// The date of an ISO text (YYYY-MM-DD, YYYYMMDD, YYYY-Www[-D], YYYYWww[D]): [y, m, d], or null.
internal fun __pyIsoDate(s : string) : List<int>? {
  val y = __pyDigitsAt(s, 0, 4)
  if (y < 0) { return null }
  var at = 4
  val extended = at < s.size and s[at] == '-'
  if (extended) { at += 1 }
  if (at < s.size and s[at] == 'W') {
    at += 1
    val w = __pyDigitsAt(s, at, 2)
    if (w < 0) { return null }
    at += 2
    var wd = 1
    if (at < s.size) {
      if (extended) { if (s[at] != '-') { return null }; at += 1 }
      wd = __pyDigitsAt(s, at, 1)
      if (wd < 1 or wd > 7) { return null }
      at += 1
    }
    if (at != s.size) { return null }
    val jan4 = pyYmdToOrd(y, 1, 4)
    val monday = jan4 - (jan4 + 6) % 7
    if (w < 1 or w > 53) { return null }
    return pyOrdToYmd(monday + (w - 1) * 7 + wd - 1)
  }
  val mo = __pyDigitsAt(s, at, 2)
  if (mo < 0) { return null }
  at += 2
  if (extended) { if (at >= s.size or s[at] != '-') { return null }; at += 1 }
  val d = __pyDigitsAt(s, at, 2)
  if (d < 0) { return null }
  at += 2
  if (at != s.size) { return null }
  return [y, mo, d]
}

// The time of an ISO text (HH[:MM[:SS[.f]]] or HHMM[SS[.f]], then Z or ±HH[:MM[:SS[.f]]]): [h, m, s, us] and the offset.
internal fun __pyIsoTime(s : string) : Pair<List<int>, BigInt?>? {
  var body = s
  var offset : BigInt? = null
  var tzAt = -1
  for k in 0..<s.size { if (s[k] == '+' or s[k] == '-' or s[k] == 'Z' or s[k] == 'z') { tzAt = k; break } }
  if (tzAt >= 0) {
    body = s[..<tzAt]
    val tzText = s[tzAt..]
    if (tzText == "Z" or tzText == "z") { offset = BigInt.of(0) } else {
      val sign = tzText[0] == '-' ? -1 : 1
      val t = __pyIsoTime(tzText[1..])
      if (t == null or t!!.second != null) { return null }
      val p = t!!.first
      offset = BigInt.of(sign) * (BigInt.of(p[0]) * BigInt.of(3600000000) + BigInt.of(p[1] * 60000000 + p[2] * 1000000 + p[3]))
    }
  }
  var at = 0
  val h = __pyDigitsAt(body, at, 2)
  if (h < 0) { return null }
  at += 2
  var mi = 0
  var sec = 0
  var us = 0
  val extended = at < body.size and body[at] == ':'
  if (at < body.size) {
    if (extended) { at += 1 }
    mi = __pyDigitsAt(body, at, 2)
    if (mi < 0) { return null }
    at += 2
    if (at < body.size) {
      if (extended) { if (body[at] != ':') { return null }; at += 1 }
      sec = __pyDigitsAt(body, at, 2)
      if (sec < 0) { return null }
      at += 2
      if (at < body.size) {
        if (body[at] != '.' and body[at] != ',') { return null }
        at += 1
        var n = 0
        while (at + n < body.size and body[at + n] >= '0' and body[at + n] <= '9') { n += 1 }
        if (n == 0 or at + n != body.size) { return null }
        val digits = n > 6 ? body[at..<(at + 6)] : body[at..<(at + n)] + "000000"[..<(6 - n)]
        us = digits.toInt()
        at += n
      }
    }
  }
  if (at != body.size) { return null }
  return Pair([h, mi, sec, us], offset)
}

// A timezone of `us` microseconds.
internal fun __pyTzOf(us : BigInt) : any? => us.isZero ? __pyUtc : pyCall1(__pyTimezoneType, __pyTd(__pyTimedeltaType, us))

// ---- date ----

internal lazy val __pyIsoCalType : PyType = __pyMakeIsoCal()
internal fun __pyMakeIsoCal() : PyType {
  val t = pyNamedTuple(PyArgs(["IsoCalendarDate", PyTuple(["year", "week", "weekday"]), "datetime"], ["module"], "namedtuple()"))
  t.dict["__repr__"] = pyLibMethod("IsoCalendarDate", "__repr__") { self, a ->
    val v = ((self as PyObject).value as PyTuple).items
    "datetime.IsoCalendarDate(year=${v[0]}, week=${v[1]}, weekday=${v[2]})"
  }
  return t
}

internal fun __pyYmd(o : any?) : List<int> => [__pyI(o, "_year"), __pyI(o, "_month"), __pyI(o, "_day")]

internal fun __pyDateMembers(owner : string) : open Map<string, any?> {
  val m : open Map<string, any?> = {:}
  m["year"] = PyProperty(PyBuiltin("year", { args, kw -> pyGetAttr(args[0], "_year") }), null, null, null)
  m["month"] = PyProperty(PyBuiltin("month", { args, kw -> pyGetAttr(args[0], "_month") }), null, null, null)
  m["day"] = PyProperty(PyBuiltin("day", { args, kw -> pyGetAttr(args[0], "_day") }), null, null, null)
  m["toordinal"] = pyLibMethod(owner, "toordinal") { self, a -> val v = __pyYmd(self); pyYmdToOrd(v[0], v[1], v[2]) }
  m["weekday"] = pyLibMethod(owner, "weekday") { self, a -> val v = __pyYmd(self); pyWeekday(v[0], v[1], v[2]) }
  m["isoweekday"] = pyLibMethod(owner, "isoweekday") { self, a -> val v = __pyYmd(self); pyWeekday(v[0], v[1], v[2]) + 1 }
  m["isocalendar"] = pyLibMethod(owner, "isocalendar") { self, a ->
    val v = __pyYmd(self)
    val c = pyIsoCalendar(v[0], v[1], v[2])
    pyCallV(__pyIsoCalType, [c[0], c[1], c[2]], null)
  }
  return m
}

internal lazy val __pyDateType : PyType = __pyMakeDate()
internal fun __pyMakeDate() : PyType {
  val m = __pyDateMembers("date")
  m["__new__"] = PyStaticMethod(PyBuiltin("__new__", { args, kw ->
    val a = PyArgs(args[1..], kw, "date()")
    a.only(["year", "month", "day"])
