// A module of this library's, made once, as import makes it.
internal fun __pyStdModule(name : string) : any? {
  val had = pyModules.get(name, pyUnbound)
  if (had !== pyUnbound) { return had }
  val m = __pyModuleMakers()[name]!!()
  pyModules.set(name, m)
  return m
}
