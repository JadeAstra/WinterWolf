import Snippy.Text.*
// Snippy's builtin types and its exceptions as PyType objects; the type of each value; classes made
// by class statements (their MRO by C3, their metaclass, __init_subclass__ and __set_name__); and
// making an object of a class.

// ---- The builtin types ----

internal fun __pyNewBuiltinType(name : string, base : PyType?, layout : int) : PyType {
  val t = PyType(name, name, "builtins")
  t.builtin = true
  t.layout = layout
  if (base != null) {
    t.bases = [base!!]
    val m : open List<PyType> = [t]
    m.addAll(base!!.mro)
    t.mro = m
  } else {
    t.mro = [t]
  }
  return t
}

val pyObjectType : PyType = __pyNewBuiltinType("object", null, 0)
val pyTypeType : PyType = __pyNewBuiltinType("type", pyObjectType, 0)
val pyNoneType : PyType = __pyNewBuiltinType("NoneType", pyObjectType, 0)
val pyIntType : PyType = __pyNewBuiltinType("int", pyObjectType, 5)
val pyBoolType : PyType = __pyNewBuiltinType("bool", pyIntType, 5)
val pyFloatType : PyType = __pyNewBuiltinType("float", pyObjectType, 6)
val pyComplexType : PyType = __pyNewBuiltinType("complex", pyObjectType, 10)
val pyStrType : PyType = __pyNewBuiltinType("str", pyObjectType, 7)
val pyBytesType : PyType = __pyNewBuiltinType("bytes", pyObjectType, 11)
val pyByteArrayType : PyType = __pyNewBuiltinType("bytearray", pyObjectType, 12)
val pyMemoryViewType : PyType = __pyNewBuiltinType("memoryview", pyObjectType, 0)
val pyListType : PyType = __pyNewBuiltinType("list", pyObjectType, 2)
val pyTupleType : PyType = __pyNewBuiltinType("tuple", pyObjectType, 8)
val pyDictType : PyType = __pyNewBuiltinType("dict", pyObjectType, 3)
val pySetType : PyType = __pyNewBuiltinType("set", pyObjectType, 4)
val pyFrozenSetType : PyType = __pyNewBuiltinType("frozenset", pyObjectType, 9)
val pyRangeType : PyType = __pyNewBuiltinType("range", pyObjectType, 0)
val pySliceType : PyType = __pyNewBuiltinType("slice", pyObjectType, 0)
val pyFunctionType : PyType = __pyNewBuiltinType("function", pyObjectType, 0)
val pyBuiltinFunctionType : PyType = __pyNewBuiltinType("builtin_function_or_method", pyObjectType, 0)
val pyMethodType : PyType = __pyNewBuiltinType("method", pyObjectType, 0)
val pyMethodDescriptorType : PyType = __pyNewBuiltinType("method_descriptor", pyObjectType, 0)
val pyModuleType : PyType = __pyNewBuiltinType("module", pyObjectType, 0)
val pyGeneratorType : PyType = __pyNewBuiltinType("generator", pyObjectType, 0)
val pyCoroutineType : PyType = __pyNewBuiltinType("coroutine", pyObjectType, 0)
val pyAsyncGeneratorType : PyType = __pyNewBuiltinType("async_generator", pyObjectType, 0)
val pyEllipsisType : PyType = __pyNewBuiltinType("ellipsis", pyObjectType, 0)
val pyNotImplementedType : PyType = __pyNewBuiltinType("NotImplementedType", pyObjectType, 0)
val pyPropertyType : PyType = __pyNewBuiltinType("property", pyObjectType, 0)
val pyClassMethodType : PyType = __pyNewBuiltinType("classmethod", pyObjectType, 0)
val pyStaticMethodType : PyType = __pyNewBuiltinType("staticmethod", pyObjectType, 0)
val pySuperType : PyType = __pyNewBuiltinType("super", pyObjectType, 0)
val pyIteratorType : PyType = __pyNewBuiltinType("iterator", pyObjectType, 0)
val pyCellType : PyType = __pyNewBuiltinType("cell", pyObjectType, 0)
val pyTextIOType : PyType = __pyNewBuiltinType("TextIOWrapper", pyObjectType, 0)

// ---- Exceptions ----

internal fun __pyExc(name : string, base : PyType?) : PyType {
  val t = __pyNewBuiltinType(name, base ?: pyObjectType, 1)
  return t
}

val pyBaseExceptionType : PyType = __pyExc("BaseException", null)
val pySystemExitType : PyType = __pyExc("SystemExit", pyBaseExceptionType)
val pyKeyboardInterruptType : PyType = __pyExc("KeyboardInterrupt", pyBaseExceptionType)
val pyGeneratorExitType : PyType = __pyExc("GeneratorExit", pyBaseExceptionType)
val pyExceptionType : PyType = __pyExc("Exception", pyBaseExceptionType)
