// Snippy's text for its values, as repr() gives it: what ast.dump shows of a constant, and what
// the runtime's repr() and str() will give. Each matches CPython 3.14's.

// ---- Unicode categories (Unicode.ww's table) ----

// Where each run of one category starts, and its category's index in __pyCategoryNames.
// Read on first use: the library's files run their top levels in the order of their names.
internal var __pyRunsRead : Pair<List<int>, List<int>>? = null
internal fun __pyRuns() : Pair<List<int>, List<int>> {
  if (__pyRunsRead == null) { __pyRunsRead = __pyReadRuns() }
  return __pyRunsRead!!
}


internal fun __pyReadRuns() : Pair<List<int>, List<int>> {
  val letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ!#$%"
  val starts : open List<int> = []
  val kinds : open List<int> = []
  var start = 0
  var i = 0
  val t = __pyCategoryTable
  while (i < t.size) {
    val kind = letters.indexOf(t[i])
    i += 1
    var delta = 0
    while (i < t.size and letters.indexOf(t[i]) < 0) {
      val c = t[i]
      delta = delta * 32 + (c <= '9' ? c.code - '0'.code : c.code - 'a'.code + 10)
      i += 1
    }
    start += delta
    starts.add(start)
    kinds.add(kind)
  }
  return Pair(starts, kinds)
}

// The general category of the code point `cp`, as Python's unicodedata.category gives it: "Lu",
// "Nd", "Zs" and the rest; "Cn" past the last.
fun pyCategory(cp : int) : string {
  if (cp < 0 or cp > 0x10FFFF) { return "Cn" }
  val runs = __pyRuns()
  var lo = 0
  var hi = runs.first.size - 1
  while (lo < hi) {
    val mid = (lo + hi + 1) / 2
    if (runs.first[mid] <= cp) { lo = mid } else { hi = mid - 1 }
  }
  return __pyCategoryNames[runs.second[lo]]
}

// Whether Python prints the code point as it is in a repr (str.isprintable): every one but the
// separators and the other kinds (C*, Z*), the space excepted.
fun pyIsPrintable(cp : int) : bool {
  if (cp < 0x7F) { return cp >= 0x20 }
  if (cp < 0xA0) { return false }
  val c = pyCategory(cp)
  return !(c[0] == 'C' or c[0] == 'Z')
}

// ---- Surrogates ----
// A str (in Python) may hold a lone surrogate (U+D800 to U+DFFF: '\udc80', as os keeps a file name's
// undecodable bytes), which a WinterWolf string cannot. Snippy keeps each as a code point of
// Unicode's last private use area, U+10F800 plus its offset, and gives it back as the surrogate
// wherever Python shows it (repr, ord, encoding). Python's text does not use that range.

internal val __pySurrogateBase = 0x10F800

// The character standing for the code point `cp` in a Snippy str.
fun pyChar(cp : int) : char => cp >= 0xD800 and cp <= 0xDFFF ? (__pySurrogateBase + cp - 0xD800).char : cp.char

// The code point a Snippy str's character stands for, as Python's ord() gives it.
fun pyOrd(c : char) : int {
  val cp = c.code
  return cp >= __pySurrogateBase ? cp - __pySurrogateBase + 0xD800 : cp
}

// ---- repr ----

internal val __pyHexDigits = "0123456789abcdef"

fun pyHex(n : int, width : int) : string {
  val sb = StringBuilder()
  var shift = (width - 1) * 4
  while (shift >= 0) {
    sb.append(__pyHexDigits[(n >> shift) & 15])
    shift -= 4
  }
  return sb.toString()
}

// A str as Python's repr() writes it: in single quotes, or double where it holds a single quote
// and no double; backslash, the quote, \t \n \r escaped, and what is not printable as \x, \u or \U.
fun pyReprStr(s : string) : string {
  val quote = s.contains('\'') and !s.contains('"') ? '"' : '\''
  val sb = StringBuilder()
  sb.append(quote)
  for (c in s) {
    val cp = pyOrd(c)
    if (c == quote or c == '\\') {
      sb.append('\\')
      sb.append(c)
    } else if (c == '\t') {
      sb.append("\\t")
    } else if (c == '\n') {
      sb.append("\\n")
    } else if (c == '\r') {
      sb.append("\\r")
    } else if (pyIsPrintable(cp)) {
      sb.append(c)
    } else if (cp < 0x100) {
      sb.append("\\x" + pyHex(cp, 2))
    } else if (cp < 0x10000) {
      sb.append("\\u" + pyHex(cp, 4))
    } else {
      sb.append("\\U" + pyHex(cp, 8))
    }
  }
  sb.append(quote)
  return sb.toString()
}

// Bytes as Python's repr() writes them: b'...', the quote chosen as a str's is, and every byte
// that is not printable ASCII as \x.
// (`escapeSingle`: a bytearray's, as CPython writes it, a single quote escaped inside double quotes too.)
fun pyReprBytes(b : Bytes, escapeSingle : bool = false) : string {
  var single = false
  var double = false
  for (i in 0 ..< b.size) {
    if (b[i] == 39) { single = true }
    if (b[i] == 34) { double = true }
  }
  val quote = single and !double ? 34 : 39
  val sb = StringBuilder()
  sb.append('b')
  sb.append(quote.char)
  for (i in 0 ..< b.size) {
    val v = b[i].toInt()
    if (v == quote or v == 92 or (escapeSingle and v == 39)) {
      sb.append('\\')
      sb.append(v.char)
    } else if (v == 9) {
      sb.append("\\t")
    } else if (v == 10) {
      sb.append("\\n")
    } else if (v == 13) {
      sb.append("\\r")
    } else if (v < 32 or v >= 127) {
      sb.append("\\x" + pyHex(v, 2))
    } else {
      sb.append(v.char)
    }
  }
  sb.append(quote.char)
  return sb.toString()
}

// A float as Python's repr() writes it: the fewest digits that read back as it, in positional
// form from 1e-4 up to 1e16 (with ".0" where it is whole, unless `addDotZero` is false, as a
// complex number's parts are written), in exponent form past them ("1e-05", "1e+16").
fun pyReprFloat(x : float, addDotZero : bool = true) : string => __reprFloat(x, addDotZero)

// A complex number as Python's repr() writes it: "3j" where its real part is a positive zero,
// "(1+2j)" otherwise.
fun pyReprComplex(re : float, im : float) : string {
  val imText = pyReprFloat(im, false)
  if (re == 0.0 and 1.0 / re > 0.0) { return imText + "j" }
  val sign = imText.startsWith("-") ? "" : "+"
  return "(" + pyReprFloat(re, false) + sign + imText + "j)"
}
