// Python's case mappings of text (the Snippy plan, part 5.3), from the tables Case.ww holds
// (made from CPython): full mappings, one character becoming several (ß to SS), title case of
// its own (ǅ, ß to Ss), casefolding, and the final sigma rule of lower(), as CPython applies each
// in str.lower(), upper(), title(), capitalize(), swapcase() and casefold().

internal class PyCaseTable(val single : Map<int, int>, val special : Map<int, string>)

internal fun __pyCaseTable(runs : List<int>?, special : List<int>) : PyCaseTable {
  val s : open Map<int, int> = {:}
  if (runs != null) {
    var i = 0
    while (i < runs!!.size) {
      val start = runs!![i]
      val count = runs!![i + 1]
      val stride = runs!![i + 2]
      val delta = runs!![i + 3]
      for k in 0..<count { s[start + k * stride] = start + k * stride + delta }
      i += 4
    }
  }
  val sp : open Map<int, string> = {:}
  var j = 0
  while (j < special.size) {
    val cp = special[j]
    val n = special[j + 1]
    val sb = StringBuilder()
    for k in 0..<n { sb.append(pyChar(special[j + 2 + k])) }
    sp[cp] = sb.toString()
    j += 2 + n
  }
  return PyCaseTable(s, sp)
}

internal lazy val __pyLowerTable : PyCaseTable = __pyCaseTable(__pyCaseRuns_lower(), __pyCaseSpecial_lower())
internal lazy val __pyUpperTable : PyCaseTable = __pyCaseTable(__pyCaseRuns_upper(), __pyCaseSpecial_upper())
internal lazy val __pyTitleTable : PyCaseTable = __pyCaseTable(null, __pyCaseSpecial_title())
internal lazy val __pyFoldTable : PyCaseTable = __pyCaseTable(null, __pyCaseSpecial_casefold())

internal fun __pyInRanges(ranges : List<int>, cp : int) : bool {
  var lo = 0
  var hi = ranges.size / 2 - 1
  while (lo <= hi) {
    val mid = (lo + hi) / 2
    if (cp < ranges[mid * 2]) { hi = mid - 1 } else if (cp > ranges[mid * 2 + 1]) { lo = mid + 1 } else { return true }
  }
  return false
}
internal lazy val __pyCasedRanges : List<int> = __pyCaseRanges_cased()
internal lazy val __pyIgnorableRanges : List<int> = __pyCaseRanges_ignorable()
fun pyIsCased(cp : int) : bool => __pyInRanges(__pyCasedRanges, cp)
fun pyIsCaseIgnorable(cp : int) : bool => __pyInRanges(__pyIgnorableRanges, cp)

internal fun __pyMapped(t : PyCaseTable, cp : int, sb : StringBuilder) {
  val sp = t.special[cp]
  if (sp != null) { sb.append(sp!!); return }
  val one = t.single[cp]
  sb.append(pyChar(one != null ? one!! : cp))
}

fun pyCharUpper(cp : int, sb : StringBuilder) { __pyMapped(__pyUpperTable, cp, sb) }
fun pyCharTitle(cp : int, sb : StringBuilder) {
  if (__pyTitleTable.special[cp] != null) { sb.append(__pyTitleTable.special[cp]!!) } else { pyCharUpper(cp, sb) }
}
// A character lowered: a capital sigma final (ς) where it ends a word, as CPython's
// handle_capital_sigma finds it, cased letters before it and none after, case-ignorable ones passed over.
fun pyCharLower(cps : List<int>, i : int, sb : StringBuilder) {
  val cp = cps[i]
  if (cp == 0x3A3) {
    var j = i - 1
    while (j >= 0 and pyIsCaseIgnorable(cps[j])) { j -= 1 }
    val before = j >= 0 and pyIsCased(cps[j])
    var k = i + 1
    while (k < cps.size and pyIsCaseIgnorable(cps[k])) { k += 1 }
    val after = k < cps.size and pyIsCased(cps[k])
    sb.append(pyChar(before and !after ? 0x3C2 : 0x3C3))
    return
  }
  __pyMapped(__pyLowerTable, cp, sb)
}

internal fun __pyCodePoints(s : string) : List<int> {
  val out : open List<int> = []
  for c in s { out.add(pyOrd(c)) }
  return out
}

fun pyStrUpper(s : string) : string {
  val sb = StringBuilder()
  for c in s { pyCharUpper(pyOrd(c), sb) }
  return sb.toString()
}

fun pyStrLower(s : string) : string {
  val cps = __pyCodePoints(s)
  val sb = StringBuilder()
  for i in 0..<cps.size { pyCharLower(cps, i, sb) }
  return sb.toString()
}

fun pyStrCasefold(s : string) : string {
  val sb = StringBuilder()
  for c in s {
    val cp = pyOrd(c)
    val f = __pyFoldTable.special[cp]
    if (f != null) { sb.append(f!!) } else { __pyMapped(__pyLowerTable, cp, sb) }
  }
  return sb.toString()
}

// title(): a cased letter after a cased one lowered, any other put in title case.
fun pyStrTitle(s : string) : string {
  val cps = __pyCodePoints(s)
  val sb = StringBuilder()
  var previousCased = false
  for i in 0..<cps.size {
    val cp = cps[i]
    if (previousCased) { pyCharLower(cps, i, sb) } else { pyCharTitle(cp, sb) }
    previousCased = pyIsCased(cp)
  }
  return sb.toString()
}

// capitalize(): the first character in title case (since 3.8), the rest lowered.
fun pyStrCapitalize(s : string) : string {
  val cps = __pyCodePoints(s)
  val sb = StringBuilder()
  for i in 0..<cps.size {
    if (i == 0) { pyCharTitle(cps[i], sb) } else { pyCharLower(cps, i, sb) }
  }
  return sb.toString()
}

// swapcase(): an upper-case letter lowered, a lower-case one raised, any other as it is.
fun pyStrSwapcase(s : string) : string {
  val cps = __pyCodePoints(s)
  val sb = StringBuilder()
  for i in 0..<cps.size {
    val cp = cps[i]
    if (pyCharUpperCase(cp)) { pyCharLower(cps, i, sb) }
    else if (pyCharLowerCase(cp)) { pyCharUpper(cp, sb) }
    else { sb.append(pyChar(cp)) }
  }
  return sb.toString()
}

// One character upper-case or lower-case as Python's str.isupper() and islower() count it.
fun pyCharUpperCase(cp : int) : bool => pyIsCased(cp) and pyCategory(cp) != "Lt" and __pyStrIsUpperOne(cp)
fun pyCharLowerCase(cp : int) : bool => pyIsCased(cp) and pyCategory(cp) != "Lt" and !__pyStrIsUpperOne(cp)
internal fun __pyStrIsUpperOne(cp : int) : bool {
  val cat = pyCategory(cp)
  if (cat == "Lu") { return true }
  if (cat == "Ll") { return false }
  // Other_Uppercase and Other_Lowercase letters and symbols: as lower() changes them, upper.
  return __pyLowerTable.single[cp] != null or __pyLowerTable.special[cp] != null
}
