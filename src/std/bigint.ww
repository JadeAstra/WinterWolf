// ---- Whole numbers of any size (2026-11-19) ----
// A BigInt is a whole number with no limit to its size: what an int holds and past it, its
// arithmetic exact however long the numbers grow. It never changes; each operation gives a new
// one. Written in WinterWolf, its digits held as a list of ints of 30 bits each, lowest first, so
// that a digit times a digit, and what is carried, always fits in an int.
//
//   val big = BigInt.of(2).pow(100)            // 1267650600228229401496703205376
//   val n = "123456789012345678901234567890".toBigInt()
//   print(big * n + 7, big / 3, big % 1000, -big < n)
//
// It mixes with ints on either side (`5 + big`, `big * 2`, `5 == BigInt.of(5)`), and with floats,
// which make a float (a division by or of a float rounded once, from the exact quotient).
// divideToFloat divides two as a float, rounded once. `/` and `%` of two cut toward zero, as an
// int's do (-7 / 2 is -3, -7 % 2 is -1);
// floorDiv and floorMod round down, as Python's // and % do. The bitwise operators work as if
// the number were in two's complement with as many bits as it needs, a negative one's ones
// going on forever (as Python's and Java's do).

// A whole number of any size, exact; each operation gives a new one.
class BigInt {
  // -1, 0 or 1.
  internal val sign : int
  // The size's digits, 30 bits each, lowest first: none for zero, the highest never 0. Frozen,
  // so that a BigInt can be a key.
  internal val mag : FrozenList<int>

  internal fun init(sign : int, mag : List<int>) {
    this.sign = mag.isEmpty() ? 0 : sign
    this.mag = mag.frozen()
  }

  static {
    // The number `n`.
    fun of(n : int) : BigInt => __bigOfInt(n)
    // n!, the product 1 × 2 × ... × n; 1 for 0. An IllegalArgumentException for a negative n.
    //   BigInt.factorial(25)   // 15511210043330985984000000
    fun factorial(n : int) : BigInt {
      if (n < 0) { throw IllegalArgumentException("factorial of a negative number ($n)") }
      return n < 2 ? BigInt.of(1) : __bigProductRange(2, n)
    }
    // How many ways there are to choose `k` of `n` things, n! / (k! (n - k)!): 0 where k > n
    // (Python's math.comb). An IllegalArgumentException where either is negative, and an
    // ArithmeticException where the smaller of k and n - k is past an int.
    //   BigInt.binomial(52, 5)   // 2598960
    fun binomial(n : BigInt, k : BigInt) : BigInt {
      if (n < 0 or k < 0) { throw IllegalArgumentException("binomial of a negative number ($n, $k)") }
      if (k > n) { return BigInt.of(0) }
      val small = k > n - k ? n - k : k
      val kk = small.toIntOrNull()
      if (kk == null) { throw ArithmeticException("binomial($n, $k): the smaller of k and n - k is past an int") }
      var r = BigInt.of(1)
      for i in 1..kk!! { r = r * (n - kk!! + i) / i }
      return r
    }
    // binomial of two ints.
    fun binomial(n : int, k : int) : BigInt => binomial(BigInt.of(n), BigInt.of(k))
    // How many ways there are to put `k` of `n` things in order, n! / (n - k)!: 0 where k > n
    // (Python's math.perm). An IllegalArgumentException where either is negative.
    //   BigInt.permutations(5, 2)   // 20
    fun permutations(n : int, k : int) : BigInt {
      if (n < 0 or k < 0) { throw IllegalArgumentException("permutations of a negative number ($n, $k)") }
      if (k > n) { return BigInt.of(0) }
      return k == 0 ? BigInt.of(1) : __bigProductRange(n - k + 1, n)
    }
    // The whole number `x` is, cut toward zero (2.7 makes 2, -2.7 makes -2), exactly however
    // large; an ArithmeticException for an infinity or NaN.
    fun of(x : float) : BigInt => __bigOfFloat(x)
    // The number `text` writes in base `radix` (2 to 36), a sign first if it has one, and
    // underscores between digits allowed (1_000_000); a NumberFormatException for anything else.
    fun parse(text : string, radix : int = 10) : BigInt {
      val made = __bigParse(text, radix)
      if (made == null) { throw NumberFormatException("'$text' is not a whole number in base $radix") }
      return made!!
    }
    // The same, null for text that is not one.
    fun parseOrNull(text : string, radix : int = 10) : BigInt? => __bigParse(text, radix)
    // The number the bytes spell, the most significant byte first (`bigEndian`) or last, as
    // Python's int.from_bytes and C#'s BigInteger(bytes, isUnsigned, isBigEndian) read them: not
    // `signed`, every bit counts; `signed`, two's complement, the top bit the sign, as Java's
    // BigInteger(bytes). No bytes at all is 0.
    //   BigInt.fromBytes(Bytes([1, 0]))                  // 256
    //   BigInt.fromBytes(Bytes([255]), signed = true)    // -1
    fun fromBytes(bytes : Bytes, bigEndian : bool = true, signed : bool = false) : BigInt {
      val n = bytes.size
      if (n == 0) { return zero }
      val digits : open List<int> = []
      var held = 0
      var bits = 0
      for (k in 0..<n) {
        held = held | (bytes[bigEndian ? n - 1 - k : k].toInt() << bits)
        bits += 8
        if (bits >= 30) {
          digits.add(held & 0x3FFFFFFF)
          held = held >> 30
          bits -= 30
        }
      }
      if (bits > 0) { digits.add(held) }
      val value = BigInt(1, __bigTrim(digits))
      val top = bytes[bigEndian ? 0 : n - 1].toInt()
      return signed and top >= 128 ? value - (one << (8 * n)) : value
    }
    // 0.
    val zero : BigInt = BigInt(0, [])
    // 1.
    val one : BigInt = BigInt(1, [1])
    // 2.
    val two : BigInt = BigInt(1, [2])
    // 10.
    val ten : BigInt = BigInt(1, [10])
  }

  // The number as bytes, the most significant first (`bigEndian`) or last, as few as hold it, as
  // Java's toByteArray and C#'s ToByteArray(isUnsigned, isBigEndian) give them: `signed`, in two's
  // complement with room for the sign (128 takes two bytes, 0 and 128); not `signed`, every bit
  // its value, and an ArithmeticException for a negative number. One byte at least: 0 is [0].
  // BigInt.fromBytes reads them back.
  //   BigInt.of(256).toBytes()                    // [1, 0]
  //   BigInt.of(-1).toBytes(signed = true)        // [255]
  fun toBytes(bigEndian : bool = true, signed : bool = false) : Bytes {
    if (!signed and sign < 0) { throw ArithmeticException("$this is negative: it has no bytes without a sign") }
    val size = signed ? bitLength / 8 + 1 : Math.max((bitLength + 7) / 8, 1)
    val value = sign < 0 ? this + (one << (8 * size)) : this
    val out = Bytes(size)
    var held = 0
    var bits = 0
    var d = 0
    for (k in 0..<size) {
      if (bits < 8 and d < value.mag.size) {
        held = held | (value.mag[d] << bits)
        bits += 30
        d += 1
      }
      out[bigEndian ? size - 1 - k : k] = (held & 255).toByte()
      held = held >> 8
      bits = Math.max(bits - 8, 0)
    }
    return out
  }

  // -1, 0 or 1, as the number is below, at or above zero.
  val signum : int
    get() => sign
  // Whether it is 0.
  val isZero : bool
    get() => sign == 0
  // The bits it needs, not counting a sign: 0 for 0, 1 for 1 and -1, 8 for 255 and -256
  // (as Java's bitLength: a negative number's in two's complement, its ones not counted).
  val bitLength : int
    get() {
      if (sign == 0) { return 0 }
      if (sign > 0) { return __bigBits(mag) }
      return __bigBits(__bigSubMag(mag, [1]))
    }

  // ---- Arithmetic ----

  // The sum.
  op +(other : BigInt) : BigInt => __bigAdd(sign, mag, other.sign, other.mag)
  // The sum with an int.
  op +(other : int) : BigInt => this + BigInt.of(other)
  // The sum with a float, as a float.
  op +(other : float) : float => toFloat() + other
  // The difference.
  op -(other : BigInt) : BigInt => __bigAdd(sign, mag, -other.sign, other.mag)
  // The difference with an int.
  op -(other : int) : BigInt => this - BigInt.of(other)
  // The difference with a float, as a float.
  op -(other : float) : float => toFloat() - other
  // The number with its sign turned round.
  op -() : BigInt => BigInt(-sign, mag)
  // The product.
  op *(other : BigInt) : BigInt => BigInt(sign * other.sign, __bigMulMag(mag, other.mag))
  // The product with an int.
  op *(other : int) : BigInt {
    // A small int: each digit times it, no BigInt made of it.
    if (other > -__BIG_BASE and other < __BIG_BASE) {
      return other < 0 ? BigInt(-sign, __bigMulSmall(mag, -other)) : BigInt(sign, __bigMulSmall(mag, other))
    }
    return this * BigInt.of(other)
  }
  // The product with a float, as a float.
  op *(other : float) : float => toFloat() * other
  // Cut toward zero, as an int's; an ArithmeticException for 0.
  op /(other : BigInt) : BigInt => divRem(other).first
  // Divided by an int, cut toward zero.
  op /(other : int) : BigInt {
    if (other > 0 and other < __BIG_BASE) { return BigInt(sign, __bigDivSmall(mag, other)[0] as List<int>) }
    return this / BigInt.of(other)
  }
  // Divided by a float, as the float nearest the exact quotient (rounded once).
  op /(other : float) : float => __bigDivideByFloat(this, other)
  // The rest, with the sign of the number divided, as an int's; an ArithmeticException for 0.
  op %(other : BigInt) : BigInt => divRem(other).second
  // The rest after dividing by an int, with the sign of this number.
  op %(other : int) : BigInt {
    if (other > 0 and other < __BIG_BASE) { return BigInt.of(sign * (__bigDivSmall(mag, other)[1] as int)) }
    return this % BigInt.of(other)
  }

  // The quotient cut toward zero and the rest, in one division.
  fun divRem(by : BigInt) : Pair<BigInt, BigInt> {
    if (by.sign == 0) { throw ArithmeticException("a BigInt divided by zero") }
    if (__bigCmpMag(mag, by.mag) < 0) { return Pair(BigInt.zero, this) }
    val parts = __bigDivMag(mag, by.mag)
    return Pair(BigInt(sign * by.sign, parts[0]), BigInt(sign, parts[1]))
  }
  // Divided and rounded down (toward minus infinity), as Python's //.
  fun floorDiv(by : BigInt) : BigInt {
    val (q, r) = divRem(by)
    return r.sign != 0 and r.sign != by.sign ? q - 1 : q
  }
  // floorDiv by an int.
  fun floorDiv(by : int) : BigInt => floorDiv(BigInt.of(by))
  // The rest after floorDiv, with the sign of `by`, as Python's %.
  fun floorMod(by : BigInt) : BigInt {
    val r = divRem(by).second
    return r.sign != 0 and r.sign != by.sign ? r + by : r
  }
  // floorMod by an int.
  fun floorMod(by : int) : BigInt => floorMod(BigInt.of(by))

  // Its size, the sign dropped.
  fun abs() : BigInt => sign < 0 ? BigInt(1, mag) : this
  // To the power `exponent`, 0 or more (anything to the 0 is 1).
  fun pow(exponent : int) : BigInt {
    if (exponent < 0) { throw ArithmeticException("a BigInt to a negative power ($exponent) is no whole number") }
    var result = BigInt.one
    var square = this
    var e = exponent
    while (e > 0) {
      if ((e & 1) == 1) { result = result * square }
      e = e >> 1
      if (e > 0) { square = square * square }
    }
    return result
  }
  // The greatest whole number dividing both, never negative; gcd(0, 0) is 0.
  fun gcd(other : BigInt) : BigInt {
    var a = abs()
    var b = other.abs()
    while (!b.isZero) {
      val r = a % b
      a = b
      b = r
    }
    return a
  }
  // gcd with an int.
  fun gcd(other : int) : BigInt => gcd(BigInt.of(other))
  // The least whole number both divide, never negative; 0 where either is 0.
  fun lcm(other : BigInt) : BigInt {
    val a = abs()
    val b = other.abs()
    if (a.isZero or b.isZero) { return BigInt.of(0) }
    return a / a.gcd(b) * b
  }
  // lcm with an int.
  fun lcm(other : int) : BigInt => lcm(BigInt.of(other))
  // To the power `exponent` (0 or more), all modulo `modulus` (above 0): the result 0 or more and
  // below it, worked out without the whole power.
  fun modPow(exponent : BigInt, modulus : BigInt) : BigInt {
    if (modulus.sign <= 0) { throw ArithmeticException("a modulus is above zero, not $modulus") }
    if (exponent.sign < 0) { throw ArithmeticException("modPow takes an exponent of 0 or more, not $exponent") }
    var result = BigInt.one.floorMod(modulus)
    var base = floorMod(modulus)
    val bits = exponent.bitLength
    for (i in 0 ..< bits) {
      if (exponent.testBit(i)) { result = (result * base).floorMod(modulus) }
      if (i + 1 < bits) { base = (base * base).floorMod(modulus) }
    }
    return result
  }
  // modPow with an int exponent.
  fun modPow(exponent : int, modulus : BigInt) : BigInt => modPow(BigInt.of(exponent), modulus)
  // The number that, times this, is 1 modulo `modulus`; an ArithmeticException where there is
  // none (they share a divisor).
  fun modInverse(modulus : BigInt) : BigInt {
    if (modulus.sign <= 0) { throw ArithmeticException("a modulus is above zero, not $modulus") }
    var oldR = floorMod(modulus)
    var r = modulus
    var oldS = BigInt.one
    var s = BigInt.zero
    while (!r.isZero) {
      val q = oldR / r
      val nextR = oldR - q * r
      oldR = r
      r = nextR
      val nextS = oldS - q * s
      oldS = s
      s = nextS
    }
    if (oldR != BigInt.one) { throw ArithmeticException("$this has no inverse modulo $modulus") }
    return oldS.floorMod(modulus)
  }
  // The whole part of its square root: the largest whole number whose square is not above it;
  // an ArithmeticException for a negative number.
  fun sqrt() : BigInt {
    if (sign < 0) { throw ArithmeticException("a negative number ($this) has no square root") }
    if (sign == 0) { return this }
    // Newton's way, from a guess above the root, down until it stops falling.
    var x = BigInt.one << ((bitLength + 1) / 2)
    while (true) {
      val y = (x + this / x) >> 1
      if (y >= x) { return x }
      x = y
    }
  }

  // ---- Bits ----

  // Moved up `by` bits (times 2 to that power); a negative `by` moves it down.
  op <<(by : int) : BigInt {
    if (by < 0) { return this >> -by }
    if (sign == 0 or by == 0) { return this }
    return BigInt(sign, __bigShlMag(mag, by))
  }
  // Moved down `by` bits, rounded down (toward minus infinity), as an int's >> is.
  op >>(by : int) : BigInt {
    if (by < 0) { return this << -by }
    if (sign == 0 or by == 0) { return this }
    if (sign > 0) { return BigInt(1, __bigShrMag(mag, by)) }
    // -((|x| - 1) >> by) - 1
    return BigInt(-1, __bigAddMag(__bigShrMag(__bigSubMag(mag, [1]), by), [1]))
  }
  // The bits set in both, in two's complement.
  op &(other : BigInt) : BigInt => __bigBitwise(this, other, 0)
  // & with an int.
  op &(other : int) : BigInt => this & BigInt.of(other)
  // The bits set in either, in two's complement.
  op |(other : BigInt) : BigInt => __bigBitwise(this, other, 1)
  // | with an int.
  op |(other : int) : BigInt => this | BigInt.of(other)
  // The bits set in one but not both, in two's complement.
  op ^(other : BigInt) : BigInt => __bigBitwise(this, other, 2)
  // ^ with an int.
  op ^(other : int) : BigInt => this ^ BigInt.of(other)
  // Every bit turned round: -this - 1.
  op ~() : BigInt => -this - 1
  // Whether bit `n` (0 the lowest) is set, in two's complement.
  fun testBit(n : int) : bool {
    if (n < 0) { throw IllegalArgumentException("a bit's place is 0 or more, not $n") }
    return ((this >> n).lowDigit() & 1) == 1
  }
  // The lowest 30 bits of its two's complement.
  internal fun lowDigit() : int {
    if (sign == 0) { return 0 }
    val low = mag[0]
    return sign > 0 ? low : (__BIG_BASE - low) & __BIG_MASK
  }

  // ---- Comparing ----

  // -1, 0 or 1, as it is below, equal to or above `other`.
  fun compareTo(other : BigInt) : int {
    if (sign != other.sign) { return sign < other.sign ? -1 : 1 }
    val c = __bigCmpMag(mag, other.mag)
    return sign >= 0 ? c : -c
  }
  // compareTo an int.
  fun compareTo(other : int) : int => compareTo(BigInt.of(other))
  // Whether it is below `other`.
  op <(other : BigInt) : bool => compareTo(other) < 0
  // Whether it is below the int.
  op <(other : int) : bool => compareTo(other) < 0
  // Whether it is below `other` or equal.
  op <=(other : BigInt) : bool => compareTo(other) <= 0
  // Whether it is below the int or equal.
  op <=(other : int) : bool => compareTo(other) <= 0
  // Whether it is above `other`.
  op >(other : BigInt) : bool => compareTo(other) > 0
  // Whether it is above the int.
  op >(other : int) : bool => compareTo(other) > 0
  // Whether it is above `other` or equal.
  op >=(other : BigInt) : bool => compareTo(other) >= 0
  // Whether it is above the int or equal.
  op >=(other : int) : bool => compareTo(other) >= 0
  // Equal to a BigInt, an int or a float of the same whole value (exactly: no float rounding).
  op ==(other : any?) : bool {
    if (other is BigInt) { return compareTo(other as BigInt) == 0 }
    if (other is int) { return compareTo(other as int) == 0 }
    if (other is float) {
      val x = other as float
      if (x.isNaN() or x.isInfinite() or x % 1.0 != 0.0) { return false }
      return compareTo(BigInt.of(x)) == 0
    }
    return false
  }
  // Equal to an int's where it is one, so that BigInt.of(5) and 5 find each other as keys.
  fun hashCode() : int {
    val small = toIntOrNull()
    if (small != null) { return small!!.hashCode() }
    var h = sign
    for (d in mag) { h = (h &* 31) &+ d }
    return h
  }

  // ---- Into other kinds ----

  // As an int; an ArithmeticException where it does not fit.
  fun toInt() : int {
    val small = toIntOrNull()
    if (small == null) { throw ArithmeticException("$this does not fit in an int") }
    return small!!
  }
  // As an int, null where it does not fit.
  fun toIntOrNull() : int? {
    if (sign == 0) { return 0 }
    if (mag.size > 3) { return null }
    // At most 90 bits: 63 fit, and -2^63.
    if (mag.size == 3 and mag[2] >= 8) {
      return sign < 0 and mag[2] == 8 and mag[1] == 0 and mag[0] == 0 ? -9223372036854775807 - 1 : null
    }
    var v = 0
    for (i in mag.size - 1 downTo 0) { v = (v << 30) | mag[i] }
    return sign * v
  }
  // Whether it fits in an int.
  val fitsInt : bool
    get() => toIntOrNull() != null
  // The nearest float, rounded as the processor rounds (to even where halfway); an infinity
  // past the largest.
  fun toFloat() : float {
    val small = toIntOrNull()
    if (small != null) { return small!!.toFloat() }
    // The highest 63 bits as an int, the lowest of them set where anything below them is (so that
    // the int's rounding to 53 bits rounds as the whole number would), times 2 to what was cut.
    val bits = __bigBits(mag)
    val cut = bits - 63
    val top = __bigShrMag(mag, cut)
    var high = 0
    for (i in top.size - 1 downTo 0) { high = (high << 30) | top[i] }
    if (__bigAnyBelow(mag, cut)) { high = high | 1 }
    val x = high.toFloat() * __bigTwoTo(cut)
    return sign < 0 ? -x : x
  }
  // Divided by `divisor`, as the float nearest the exact quotient: rounded once, where
  // toFloat() / divisor.toFloat() rounds three times, and is NaN where both are past the largest
  // float. A subnormal quotient rounded at its own place, an infinity past the largest float, a
  // zero with the quotient's sign (0 divided by a negative is -0.0). An ArithmeticException for a
  // divisor of 0.
  //   (BigInt.ten.pow(400) + 1).divideToFloat(BigInt.ten.pow(399))   // 10.0
  fun divideToFloat(divisor : BigInt) : float {
    if (divisor.sign == 0) { throw ArithmeticException("division by zero") }
    val negative = (sign < 0) != (divisor.sign < 0)
    if (sign == 0) { return negative ? -0.0 : 0.0 }
    val a = abs()
    val b = divisor.abs()
    // Both exact as floats: one division, rounded once.
    if (__bigBits(a.mag) <= 53 and __bigBits(b.mag) <= 53) { return toFloat() / divisor.toFloat() }
    val x = __bigDivideScaled(a, b, 0)
    return negative ? -x : x
  }
  // In base `radix`, 2 to 36 (digits past 9 in small letters), a minus first where negative.
  fun toString(radix : int) : string => __bigToString(this, radix)
  // In base 10, a minus first where negative.
  fun toString() : string => __bigToString(this, 10)
}

// Into a BigInt.
fun int.toBigInt() : BigInt => BigInt.of(this)
// The whole number the float is, cut toward zero; an ArithmeticException for an infinity or NaN.
fun float.toBigInt() : BigInt => BigInt.of(this)
// The number the text writes in base `radix`; a NumberFormatException for anything else.
fun string.toBigInt(radix : int = 10) : BigInt => BigInt.parse(this, radix)
// The number the text writes in base `radix`, null for anything else.
fun string.toBigIntOrNull(radix : int = 10) : BigInt? => BigInt.parseOrNull(this, radix)

// An int or a float on the left of a BigInt.
op int.+(other : BigInt) : BigInt => BigInt.of(this) + other
// The int less a BigInt.
op int.-(other : BigInt) : BigInt => BigInt.of(this) - other
// The int times a BigInt.
op int.*(other : BigInt) : BigInt => BigInt.of(this) * other
// The int divided by a BigInt, cut toward zero.
op int./(other : BigInt) : BigInt => BigInt.of(this) / other
// The rest after dividing the int by a BigInt.
op int.%(other : BigInt) : BigInt => BigInt.of(this) % other
// Whether the int is below the BigInt.
op int.<(other : BigInt) : bool => other.compareTo(this) > 0
// Whether the int is below the BigInt or equal.
op int.<=(other : BigInt) : bool => other.compareTo(this) >= 0
// Whether the int is above the BigInt.
op int.>(other : BigInt) : bool => other.compareTo(this) < 0
// Whether the int is above the BigInt or equal.
op int.>=(other : BigInt) : bool => other.compareTo(this) <= 0
// The float plus a BigInt, as a float.
op float.+(other : BigInt) : float => this + other.toFloat()
// The float less a BigInt, as a float.
op float.-(other : BigInt) : float => this - other.toFloat()
// The float times a BigInt, as a float.
op float.*(other : BigInt) : float => this * other.toFloat()
// The float divided by a BigInt, as the float nearest the exact quotient (rounded once).
op float./(other : BigInt) : float => __bigFloatDividedBy(this, other)

// ---- How it is worked out ----

val __BIG_BASE = 1073741824   // 2^30
val __BIG_MASK = 1073741823

// A list of digits with the zeros at its top taken off.
fun __bigTrim(d : open List<int>) : List<int> {
  while (d.isNotEmpty() and d.last() == 0) { d.removeLast() }
  return d
}

fun __bigOfInt(n : int) : BigInt {
  if (n == 0) { return BigInt.zero }
  // -2^63 has no int of its size: 2^63 is 8 times 2^60.
  if (n == -9223372036854775807 - 1) { return BigInt(-1, [0, 0, 8]) }
  var v = n < 0 ? -n : n
  val d : open List<int> = []
  while (v > 0) {
    d.add(v & __BIG_MASK)
    v = v >> 30
  }
  return BigInt(n < 0 ? -1 : 1, d)
}

// Exactly, cut toward zero: the float's whole part a digit at a time from the top, each step a
// multiplication or a division by a power of two, which floats do without rounding.
fun __bigOfFloat(x : float) : BigInt {
  if (x.isNaN() or x.isInfinite()) { throw ArithmeticException("$x is no whole number") }
  var f = x < 0.0 ? -x : x
  f = f - f % 1.0
  if (f < 4.0e18) { return BigInt.of(x < 0.0 ? -(f.toInt()) : f.toInt()) }
  var levels = 0
  while (f >= 1073741824.0) {
    f = f / 1073741824.0
    levels += 1
  }
  val d : open List<int> = List(levels + 1) { 0 }
  for (k in levels downTo 0) {
    val whole = f - f % 1.0
    d[k] = whole.toInt()
    f = (f - whole) * 1073741824.0
  }
  return BigInt(x < 0.0 ? -1 : 1, __bigTrim(d))
}

// The bits of the highest digit and those below: a size's bit length.
fun __bigBits(d : List<int>) : int {
  if (d.isEmpty()) { return 0 }
  var top = d.last()
  var bits = 0
  while (top > 0) {
    bits += 1
    top = top >> 1
  }
  return (d.size - 1) * 30 + bits
}

// Whether any of the lowest `count` bits is set.
fun __bigAnyBelow(d : List<int>, count : int) : bool {
  val whole = count / 30
  for (i in 0 ..< Math.min(whole, d.size)) { if (d[i] != 0) { return true } }
  val part = count % 30
  return part > 0 and whole < d.size and (d[whole] & ((1 << part) - 1)) != 0
}

// ---- Floats rounded once ----

// n × 2^e for n > 0, as the nearest float: rounded once, halves to even, where `sticky` says
// something under n's lowest bit was left out (so a half is more than a half; it counts only
// where n has two bits or more past what the float keeps, as __bigDivideScaled sees to). A
// subnormal result is rounded at its own place, a result past the largest float is an infinity.
fun __bigScaledToFloat(n : BigInt, e : int, sticky : bool) : float {
  val bits = __bigBits(n.mag)
  val top = bits - 1 + e   // n × 2^e is from 2^top to under 2^(top + 1)
  if (top > 1023) { return 1.0 / 0.0 }
  val keep = top >= -1022 ? 53 : top + 1075   // the bits a float has there
  if (keep < 0) { return 0.0 }               // under half the least subnormal
  val drop = bits - keep
  if (drop <= 0) { return __bigTimesTwoTo(n.toFloat(), e) }
  var m = n >> drop
  val half = !((n >> (drop - 1)) & 1).isZero
  val below = sticky or __bigAnyBelow(n.mag, drop - 1)
  if (half and (below or !(m & 1).isZero)) { m = m + 1 }
  return __bigTimesTwoTo(m.toFloat(), e + drop)
}

// (a / b) × 2^e for a, b > 0, as the nearest float, rounded once: a quotient of 55 bits or 56
// made by shifting one of them, the rest kept as a sticky bit (CPython's long_true_divide works
// so).
fun __bigDivideScaled(a : BigInt, b : BigInt, e : int) : float {
  val shift = 55 - (__bigBits(a.mag) - __bigBits(b.mag))
  val parts = shift >= 0 ? (a << shift).divRem(b) : a.divRem(b << -shift)
  return __bigScaledToFloat(parts.first, e - shift, !parts.second.isZero)
}

// x × 2^k, exactly where the result is a float (x a float of at most 53 bits): in steps that
// lose nothing on the way.
fun __bigTimesTwoTo(x : float, k : int) : float {
  if (k >= 0) { return x * __bigTwoTo(k) }
  var y = x
  var left = -k
  while (left > 1000) {
    y = y / 1.0715086071862673e301   // 2^1000
    left -= 1000
  }
  return y / __bigTwoTo(left)
}

// A finite float other than 0 as m × 2^e, m a whole number of at most 53 bits, positive.
fun __bigFloatParts(x : float) : Pair<int, int> {
  val bits = Bytes(8).putFloat64(0, x).int64(0)
  val biased = (bits >> 52) & 0x7FF
  val fraction = bits & 0xFFFFFFFFFFFFF
  if (biased == 0) { return Pair(fraction, -1074) }
  return Pair(fraction | 0x10000000000000, biased - 1075)
}

// A BigInt divided by a float, rounded once.
fun __bigDivideByFloat(n : BigInt, x : float) : float {
  if (x.isNaN() or x.isInfinite() or x == 0.0 or __bigBits(n.mag) <= 53) { return n.toFloat() / x }
  if (n.sign == 0) { return (x < 0.0) ? -0.0 : 0.0 }
  val parts = __bigFloatParts(Math.abs(x))
  val q = __bigDivideScaled(n.abs(), BigInt.of(parts.first), -parts.second)
  return (n.sign < 0) != (x < 0.0) ? -q : q
}

// A float divided by a BigInt, rounded once.
fun __bigFloatDividedBy(x : float, n : BigInt) : float {
  if (x.isNaN() or x.isInfinite() or x == 0.0 or n.sign == 0 or __bigBits(n.mag) <= 53) { return x / n.toFloat() }
  val parts = __bigFloatParts(Math.abs(x))
  val q = __bigDivideScaled(BigInt.of(parts.first), n.abs(), parts.second)
  return (n.sign < 0) != (x < 0.0) ? -q : q
}

// 2 to the power `e` as a float, exactly (an infinity past the largest).
fun __bigTwoTo(e : int) : float {
  var x = 1.0
  var left = e
  while (left >= 1000) {
    x = x * 1.0715086071862673e301   // 2^1000
    left -= 1000
  }
  while (left >= 30) {
    x = x * 1073741824.0
    left -= 30
  }
  return x * (1 << left).toFloat()
}

// -1, 0 or 1, comparing two sizes.
fun __bigCmpMag(a : List<int>, b : List<int>) : int {
  if (a.size != b.size) { return a.size < b.size ? -1 : 1 }
  var i = a.size - 1
  while (i >= 0) {
    val x = a[i]
    val y = b[i]
    if (x != y) { return x < y ? -1 : 1 }
    i -= 1
  }
  return 0
}

fun __bigAddMag(a : List<int>, b : List<int>) : List<int> {
  val (long, short) = a.size >= b.size ? Pair(a, b) : Pair(b, a)
  val out : open List<int> = List(long.size + 1) { 0 }
  var carry = 0
  for (i in 0 ..< long.size) {
    val s = long[i] + (i < short.size ? short[i] : 0) + carry
    out[i] = s & __BIG_MASK
    carry = s >> 30
  }
  out[long.size] = carry
  return __bigTrim(out)
}

// a - b, where a is not below b.
fun __bigSubMag(a : List<int>, b : List<int>) : List<int> {
  val out : open List<int> = List(a.size) { 0 }
  var borrow = 0
  for (i in 0 ..< a.size) {
    var s = a[i] - (i < b.size ? b[i] : 0) - borrow
    if (s < 0) {
      s += __BIG_BASE
      borrow = 1
    } else {
      borrow = 0
    }
    out[i] = s
  }
  return __bigTrim(out)
}

fun __bigAdd(sa : int, a : List<int>, sb : int, b : List<int>) : BigInt {
  if (sb == 0) { return BigInt(sa, a) }
  if (sa == 0) { return BigInt(sb, b) }
  if (sa == sb) { return BigInt(sa, __bigAddMag(a, b)) }
  val c = __bigCmpMag(a, b)
  if (c == 0) { return BigInt.zero }
  return c > 0 ? BigInt(sa, __bigSubMag(a, b)) : BigInt(sb, __bigSubMag(b, a))
}

// Long multiplication; Karatsuba's way where both are long (each half times each half three
// times, not four), from 48 digits.
fun __bigMulMag(a : List<int>, b : List<int>) : List<int> {
  if (a.isEmpty() or b.isEmpty()) { return [] }
  if (a.size >= 48 and b.size >= 48) { return __bigKaratsuba(a, b) }
  val out : open List<int> = List(a.size + b.size) { 0 }
  for (i in 0 ..< a.size) {
    val x = a[i]
    if (x == 0) { continue }
    var carry = 0
    for (j in 0 ..< b.size) {
      val t = out[i + j] + x * b[j] + carry
      out[i + j] = t & __BIG_MASK
      carry = t >> 30
    }
    var k = i + b.size
    while (carry != 0) {
      val t = out[k] + carry
      out[k] = t & __BIG_MASK
      carry = t >> 30
      k += 1
    }
  }
  return __bigTrim(out)
}

fun __bigKaratsuba(a : List<int>, b : List<int>) : List<int> {
  val half = Math.max(a.size, b.size) / 2
  val aLow = __bigTrim(a[0 ..< Math.min(half, a.size)].toOpenList())
  val aHigh = a.size > half ? a[half ..< a.size] : []
  val bLow = __bigTrim(b[0 ..< Math.min(half, b.size)].toOpenList())
  val bHigh = b.size > half ? b[half ..< b.size] : []
  val low = __bigMulMag(aLow, bLow)
  val high = __bigMulMag(aHigh, bHigh)
  val middle = __bigSubMag(__bigSubMag(__bigMulMag(__bigAddMag(aLow, aHigh), __bigAddMag(bLow, bHigh)), low), high)
  return __bigAddMag(__bigAddMag(low, __bigShiftDigits(middle, half)), __bigShiftDigits(high, 2 * half))
}

// Times the base to the power `n`: `n` zero digits put under it.
fun __bigShiftDigits(d : List<int>, n : int) : List<int> {
  if (d.isEmpty()) { return d }
  val out : open List<int> = List(n) { 0 }
  out.addAll(d)
  return out
}

fun __bigShlMag(d : List<int>, by : int) : List<int> {
  val whole = by / 30
  val part = by % 30
  val out : open List<int> = List(whole + d.size + 1) { 0 }
  if (part == 0) {
    for (i in 0 ..< d.size) { out[whole + i] = d[i] }
  } else {
    var carry = 0
    for (i in 0 ..< d.size) {
      val v = d[i]
      out[whole + i] = ((v << part) & __BIG_MASK) | carry
      carry = v >> (30 - part)
    }
    out[whole + d.size] = carry
  }
  return __bigTrim(out)
}

fun __bigShrMag(d : List<int>, by : int) : List<int> {
  val whole = by / 30
  val part = by % 30
  if (whole >= d.size) { return [] }
  val out : open List<int> = List(d.size - whole) { 0 }
  for (i in 0 ..< out.size) {
    val low = d[whole + i] >> part
    val high = part > 0 and whole + i + 1 < d.size ? (d[whole + i + 1] << (30 - part)) & __BIG_MASK : 0
    out[i] = low | high
  }
  return __bigTrim(out)
}

// A size divided by a digit: [the quotient, the rest].
fun __bigDivSmall(a : List<int>, by : int) : List<any> {
  val q : open List<int> = List(a.size) { 0 }
  var r = 0
  var i = a.size - 1
  while (i >= 0) {
    val t = (r << 30) | a[i]
    q[i] = t / by
    r = t % by
    i -= 1
  }
  return [__bigTrim(q), r]
}

// Two sizes divided, the divisor not above the dividend: [the quotient, the rest] (Knuth's
// algorithm D, The Art of Computer Programming, 4.3.1).
fun __bigDivMag(a : List<int>, b : List<int>) : List<List<int>> {
  if (b.size == 1) {
    val parts = __bigDivSmall(a, b[0])
    val r = parts[1] as int
    return [parts[0] as List<int>, r == 0 ? [] : [r]]
  }
  // Both moved up until the divisor's highest digit has its top bit (29) set.
  val s = 30 - __bigBits([b.last()])
  val v = __bigShlMag(b, s)
  val u : open List<int> = __bigShlMag(a, s).toOpenList()
  while (u.size < a.size + 1) { u.add(0) }
  val n = v.size
  val m = u.size - n - 1
  val q : open List<int> = List(m + 1) { 0 }
  val vTop = v[n - 1]
  val vNext = v[n - 2]
  var j = m
  while (j >= 0) {
    // The quotient's next digit guessed from the top two of what is left, then corrected.
    val num = (u[j + n] << 30) | u[j + n - 1]
    var qhat = num / vTop
    var rhat = num % vTop
    while (qhat >= __BIG_BASE or qhat * vNext > ((rhat << 30) | u[j + n - 2])) {
      qhat -= 1
      rhat += vTop
      if (rhat >= __BIG_BASE) { break }
    }
    // Taken away: u[j ..< j + n + 1] -= qhat * v.
    var borrow = 0
    var carry = 0
    for (i in 0 ..< n) {
      val p = qhat * v[i] + carry
      carry = p >> 30
      val t = u[i + j] - (p & __BIG_MASK) - borrow
      if (t < 0) {
        u[i + j] = t + __BIG_BASE
        borrow = 1
      } else {
        u[i + j] = t
        borrow = 0
      }
    }
    val top = u[j + n] - carry - borrow
    if (top < 0) {
      // Once in a while the guess is one too many: v added back.
      u[j + n] = top + __BIG_BASE
      qhat -= 1
      var c = 0
      for (i in 0 ..< n) {
        val t = u[i + j] + v[i] + c
        u[i + j] = t & __BIG_MASK
        c = t >> 30
      }
      u[j + n] = (u[j + n] + c) & __BIG_MASK
    } else {
      u[j + n] = top
    }
    q[j] = qhat
    j -= 1
  }
  val rest = __bigShrMag(__bigTrim(u[0 ..< n].toOpenList()), s)
  return [__bigTrim(q), rest]
}

// &, | and ^ (0, 1, 2) on the two numbers' two's complements, as long as the longer and one
// more digit, whose top bit is the sign.
fun __bigBitwise(x : BigInt, y : BigInt, op : int) : BigInt {
  val length = Math.max(x.mag.size, y.mag.size) + 1
  val a = __bigTwos(x, length)
  val b = __bigTwos(y, length)
  val out : open List<int> = List(length) { 0 }
  for (i in 0 ..< length) {
    out[i] = op == 0 ? a[i] & b[i] : op == 1 ? a[i] | b[i] : a[i] ^ b[i]
  }
  val negative = (out[length - 1] >> 29) == 1
  if (!negative) { return BigInt(1, __bigTrim(out)) }
  // Its size: every bit turned round, then one added.
  for (i in 0 ..< length) { out[i] = __BIG_MASK - out[i] }
  return BigInt(-1, __bigAddMag(__bigTrim(out), [1]))
}

// A number's two's complement in `length` digits: a negative one's size less one, each bit turned.
fun __bigTwos(x : BigInt, length : int) : List<int> {
  val out : open List<int> = List(length) { 0 }
  if (x.sign >= 0) {
    for (i in 0 ..< x.mag.size) { out[i] = x.mag[i] }
    return out
  }
  val less = __bigSubMag(x.mag, [1])
  for (i in 0 ..< length) { out[i] = __BIG_MASK - (i < less.size ? less[i] : 0) }
  return out
}

fun __bigDigitValue(c : char) : int {
  val code = c.code
  if (code >= 48 and code <= 57) { return code - 48 }
  if (code >= 97 and code <= 122) { return code - 87 }
  if (code >= 65 and code <= 90) { return code - 55 }
  return 99
}

// The largest power of `radix` a digit holds, and how many of the radix's digits that is.
fun __bigChunk(radix : int) : List<int> {
  var power = radix
  var count = 1
  while (power * radix < __BIG_BASE) {
    power = power * radix
    count += 1
  }
  return [power, count]
}

fun __bigParse(text : string, radix : int) : BigInt? {
  if (radix < 2 or radix > 36) { throw IllegalArgumentException("a base is 2 to 36, not $radix") }
  var i = 0
  var negative = false
  if (text.size > 0 and (text[0] == '-' or text[0] == '+')) {
    negative = text[0] == '-'
    i = 1
  }
  // The digits, underscores between them dropped.
  val digits : open List<int> = []
  var lastWasDigit = false
  while (i < text.size) {
    val c = text[i]
    if (c == '_') {
      if (!lastWasDigit or i + 1 >= text.size) { return null }
      lastWasDigit = false
    } else {
      val v = __bigDigitValue(c)
      if (v >= radix) { return null }
      digits.add(v)
      lastWasDigit = true
    }
    i += 1
  }
  if (digits.isEmpty() or !lastWasDigit) { return null }
  val chunk = __bigChunk(radix)
  val power = chunk[0]
  val per = chunk[1]
  // A chunk of the radix's digits at a time, each as large as a digit holds.
  val mag : open List<int> = []
  var at = 0
  val first = digits.size % per
  while (at < digits.size) {
    val take = at == 0 and first > 0 ? first : per
    var value = 0
    var scale = 1
    for (k in 0 ..< take) {
      value = value * radix + digits[at + k]
      scale = scale * radix
    }
    __bigMulAddInPlace(mag, scale, value)
    at += take
  }
  return BigInt(negative ? -1 : 1, __bigTrim(mag))
}

// A size times a digit.
fun __bigMulSmall(a : List<int>, by : int) : List<int> {
  if (a.isEmpty() or by == 0) { return [] }
  val out : open List<int> = List(a.size + 1) { 0 }
  var carry = 0
  for (i in 0 ..< a.size) {
    val t = a[i] * by + carry
    out[i] = t & __BIG_MASK
    carry = t >> 30
  }
  out[a.size] = carry
  return __bigTrim(out)
}

fun __bigToString(x : BigInt, radix : int) : string {
  if (radix < 2 or radix > 36) { throw IllegalArgumentException("a base is 2 to 36, not $radix") }
  if (x.sign == 0) { return "0" }
  val chunk = __bigChunk(radix)
  val power = chunk[0]
  val per = chunk[1]
  // The number divided by the largest power of the radix a digit holds, again and again: its
  // rests are its chunks of `per` digits, lowest first.
  val parts : open List<int> = []
  val left : open List<int> = x.mag.toOpenList()
  while (left.isNotEmpty()) {
    parts.add(__bigDivSmallInPlace(left, power))
  }
  val text = StringBuilder()
  if (x.sign < 0) { text.append("-") }
  text.append(parts.last().toString(radix))
  var i = parts.size - 2
  while (i >= 0) {
    text.append(parts[i].toString(radix).padStart(per, '0'))
    i -= 1
  }
  return text.toString()
}

// d = d * by + add, in place: by and add below the base.
fun __bigMulAddInPlace(d : open List<int>, by : int, add : int) {
  var carry = add
  for (i in 0 ..< d.size) {
    val t = d[i] * by + carry
    d[i] = t & __BIG_MASK
    carry = t >> 30
  }
  if (carry != 0) { d.add(carry) }
}

// d = d / by, in place, its top zeros taken off: the rest. `by` is above 0 and below the base.
fun __bigDivSmallInPlace(d : open List<int>, by : int) : int {
  var r = 0
  var i = d.size - 1
  while (i >= 0) {
    val t = (r << 30) | d[i]
    d[i] = t / by
    r = t % by
    i -= 1
  }
  __bigTrim(d)
  return r
}

// low × (low + 1) × ... × high, the product split in halves so that the numbers multiplied stay of
// a size (factorial, permutations).
fun __bigProductRange(low : int, high : int) : BigInt {
  if (high < low) { return BigInt.of(1) }
  if (high - low < 8) {
    var p = BigInt.of(low)
    for i in (low + 1)..high { p = p * i }
    return p
  }
  val mid = low + (high - low) / 2
  return __bigProductRange(low, mid) * __bigProductRange(mid + 1, high)
}
