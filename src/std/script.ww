// Inside WinterWolf: the work is done by the built-in __script (script.cpp).

// ---- Scripts ----
// A script is WinterWolf source compiled while the program runs, from text or a file, and run
// in a VM of its own, on a thread of its own: it shares nothing with the program, as a worker
// does not. The program calls its functions by name; what goes in and what comes back is
// copied as a worker's messages are: numbers, text, booleans, null, bytes, and lists, maps and
// sets of those (frozen data shared, not copied).
//
//   val script = Script.compile("fun double(n : int) : int => n * 2", name = "double.ww")
//   val running = script.start()
//   print(running.call("double", [21]))   // 42
//   running.stop()
//
// A script that does not compile is a ScriptError listing what is wrong and where; one that
// throws is a ScriptException in the program, with what it threw. A script compiled once can be
// started any number of times, each run with its own VM. A program built into an executable
// that uses Script keeps the compiler (and the standard library's source) in its file.
//
// The program and its scripts talk through interfaces (the scripting plan, part 2), declared in
// a file of their own, the contract, which both compile: it imports nothing and holds only
// declarations. The script is given an object of one of them, its `api`, and may give the program
// one of another, made of its own top-level functions:
//
//   // door_contract.ww
//   interface DoorApi {
//     fun open(door : int)
//     fun isLocked(door : int) : bool
//     fun onTimer(seconds : int, then : () -> unit)
//   }
//   interface DoorScript { fun onEnter(player : int) }
//
//   // the program, which imports door_contract.ww
//   val script = Script.compile(source, name = "door.ww", api = DoorApi#, gives = DoorScript#)
//   val running = script.start(api = game.doors)          // game.doors is a DoorApi
//   val door = running.gives as DoorScript
//   door.onEnter(7)                                        // runs the script's onEnter
//
//   // door.ww, the script: `api` is a DoorApi; it gives DoorScript with this onEnter
//   fun onEnter(player : int) {
//     if (!api.isLocked(3)) { api.open(3) }
//     api.onTimer(2) { api.open(4) }
//   }
//
// A member with a body in the contract is a hook a script may leave out (fun onBoard(player : int,
// ship : int) {}): its own where it declares one, the contract's body where not, so each of a
// game's mods declares only the hooks it wants. One with no body, it has to declare.
//
// A script that calls a member the contract does not have, or gives the interface with a
// function of another type, does not compile. Data (numbers, text, lists, maps, sets, the
// contract's data classes and value types) is copied; an object of an interface of the contract
// goes as a handle, an object of that interface on the other side whose calls run on the object
// itself; a function given goes so too, so a script's lambda is called back in the script. A
// handle that comes back is the object itself again.
//
// A script is safe unless compiled `trusted`: it reaches nothing outside the program but through
// its api (each try a SecurityException), what it prints goes to a function of the program's or
// nowhere, and exit ends it alone.
//
// What a script may take is given as it starts (Limits): each call's time, or a count of its
// steps for a game whose machines must agree; its heap; how deep its calls go. A call past one
// is a ScriptLimitException in the program, and the script goes on for the next:
//
//   val running = script.start(api = game, limits = Limits(time = 2.milliseconds, memory = 32 * 1024 * 1024))
class Script {
  internal val handle : any
  // The name it was compiled under, which its errors and stack traces give.
  val name : string
  // The interface its `api` is an object of, where it was compiled with api = ...
  val api : Class?
  // The interface it gives, where it was compiled with gives = ...
  val gives : Class?

  internal fun init(handle : any, name : string, api : Class?, gives : Class?) {
    this.handle = handle
    this.name = name
    this.api = api
    this.gives = gives
  }

  static {
    // `source` compiled, as a file named `name` in `folder` (by default where the program
    // runs), which its imports are looked for from; a ScriptError listing each problem, with its
    // line and column, where it does not compile. With `api`, an interface of a contract written
    // here by its name (api = DoorApi#), the script has `api`, an object of it, and sees the
    // contract's declarations; with `gives`, another of them, its top-level functions are made
    // an object of that interface, which the program gets from RunningScript.gives.
    // A script is safe unless `trusted`: it reaches nothing outside the program (files, the
    // network, processes, native libraries, threads and workers, the system's fonts, standard
    // input, the program's arguments and environment), each a SecurityException, only its api;
    // and it imports only files under `folder` (none where no folder is given) and the libraries
    // ww carries. A trusted one reaches what any program does.
    fun compile(source : string, name : string = "script.ww", folder : FilePath? = null, api : Class? = null,
                gives : Class? = null, trusted : bool = false) : Script throws ScriptError =>
      __scriptCompile(null, source, name, folder, api, gives, trusted)

    // The file read and compiled, its imports looked for from its folder, as compile does; a
    // ScriptError where it does not compile, an IOException where it cannot be read.
    fun load(path : FilePath, api : Class? = null, gives : Class? = null, trusted : bool = false) : Script throws IOException | ScriptError =>
      compile(path.readText(), path.name, path.absolute.parent ?: FilePath("."), api, gives, trusted)
  }

  // What it declares at its top level, its functions among them, sorted.
  val names : List<string>
    get() => __script.names(handle) as List<string>

  // Starts it: a VM of its own, on a thread of its own, runs its top level, and waits for
  // calls. `api` is what the script's `api` stands for: an object of the interface it was
  // compiled with, whose calls from the script run here. A ScriptException where the top level
  // throws. `output` gets each line it prints (on the program's event loop); with none, a safe
  // one's go nowhere and a trusted one's to the program's own output. `limits` are what it may
  // take, its top level a call as any (one compiled in a ScriptVM has the ScriptVM's).
  fun start(api : any? = null, output : ((string) -> unit)? = null, limits : Limits? = null) : RunningScript {
    if (this.api != null and api == null) {
      throw IllegalArgumentException("$name was compiled with api = ${this.api!!.name}#: start it with an object of ${this.api!!.name}")
    }
    val started = __script.start(handle, api, output, limits?.forScript())
    if (started is List<any?>) { throw __scriptFailed(name, started as List<any?>) }
    return RunningScript(started, this)
  }

  // As "Script(door.ww)".
  override fun toString() : string => "Script($name)"
}

// A script started (Script.start), until it is stopped.
class RunningScript {
  internal val handle : any
  // The script it runs.
  val script : Script

  internal fun init(handle : any, script : Script) {
    this.handle = handle
    this.script = script
  }

  // Calls the function the script declares under `function`, with `arguments` copied over, and
  // gives what it returns, copied back. The program waits until it answers. A ScriptException
  // where the script throws (with what it threw, and where), has no such function, or has ended;
  // a ScriptLimitException where it ran past its limits.
  fun call(function : string, arguments : List<any?> = []) : any? {
    val answer = __script.call(handle, function, arguments) as List<any?>
    if (!(answer[0] as bool)) { throw __scriptFailed(script.name, answer) }
    return answer[1]
  }

  // Stops the script, whatever it is doing (at its next call or loop round), and waits until
  // it has ended. A call after that is a ScriptException.
  fun stop() {
    __script.stop(handle)
  }

  // The object of the interface the script gives (compiled with gives = DoorScript#), made of its
  // own top-level functions: its calls run in the script. A ScriptException where it gives none.
  val gives : any?
    get() {
      val answer = __script.gives(handle) as List<any?>
      if (!(answer[0] as bool)) { throw __scriptFailed(script.name, answer) }
      return answer[1]
    }

  // True until it ends: stopped, or ended by itself (its top level called exit).
  val isRunning : bool
    get() => __script.isRunning(handle) as bool

  // As "RunningScript(door.ww)".
  override fun toString() : string => "RunningScript(${script.name})"
}

// A VM that several scripts share (asked 2026-11-19: "so we can choose which vm a script runs
// in"): one copy of the standard library and of what they import, for all of them. Each is
// compiled into it as it runs, by a compiler of its own that lives on its thread (as the shell's
// does), so a script after the first compiles in a few milliseconds. Its scripts run one at a
// time, on its one thread, each with names of its own; but they share its fate: one that loops
// for ever, or calls exit, stops them all. So a game puts its own mods in one, and a script it
// does not trust in a VM of its own (Script.compile(...).start()).
//
//   val shared = ScriptVM()
//   val core = shared.compile(coreSource, name = "core.ww", api = ModApi#, gives = ModHooks#).start(api = game)
//   val earthlings = shared.compile(earthSource, name = "earthlings.ww", api = ModApi#, gives = ModHooks#).start(api = game)
class ScriptVM {
  internal val handle : any

  // Starts it: its thread, its VM, the standard library loaded. Its scripts are safe unless
  // `trusted`, as Script.compile's are; `output` gets each line they print (on the program's
  // event loop), and with none a safe one's go nowhere and a trusted one's to the program's own.
  // `limits` are its scripts': each call's time or steps, and the VM's memory and depth, which
  // they share.
  fun init(trusted : bool = false, output : ((string) -> unit)? = null, limits : Limits? = null) {
    handle = __script.vm(!trusted, output, limits?.forScript())
  }

  // `source` compiled into this VM, as Script.compile compiles one of its own; it starts here,
  // once (compile it again for another run).
  fun compile(source : string, name : string = "script.ww", folder : FilePath? = null, api : Class? = null,
              gives : Class? = null) : Script throws ScriptError => __scriptCompile(handle, source, name, folder, api, gives, false)

  // The file read and compiled into this VM, as Script.load does.
  fun load(path : FilePath, api : Class? = null, gives : Class? = null) : Script throws IOException | ScriptError =>
    compile(path.readText(), path.name, path.absolute.parent ?: FilePath("."), api, gives)

  // Stops it, and every script in it, whatever it is doing, and waits until it has ended.
  fun stop() {
    __script.stopVm(handle)
  }

  // True until it is stopped, or ends by itself (a script of it called exit).
  val isRunning : bool
    get() => __script.vmIsRunning(handle) as bool

  // As "ScriptVM".
  override fun toString() : string => "ScriptVM"
}

// One thing wrong with a script that does not compile, and where.
value ScriptProblem(val file : string, val line : int, val column : int, val message : string) {
  // As the compiler writes it: "door.ww:3:5: error: ...".
  override fun toString() : string => "$file:$line:$column: error: $message"
}

// A script that does not compile: every problem found, each with its place.
class ScriptError(val problems : List<ScriptProblem>) : Exception(problems.map { it.toString() }.join("\n"))

// A script that threw, has no function of the name called, or is no longer running.
class ScriptException(message : string? = null) : RuntimeException(message)

// A call of a script's that ran past its limits (Limits): its time, its steps or its heap. The
// script goes on, for the next call.
class ScriptLimitException(message : string? = null) : ScriptException(message)

// What a script may take (the scripting plan, part 4), each null for no limit:
//   time    each call from the program, the script's own time in it (not the program's, while
//           the script waits on its api): past it, the call ends
//   steps   each call from the program, a count of its steps (each time round a loop, each call),
//           the same on every machine, for a game whose machines must agree (replays,
//           multiplayer): a script counted runs with no native code, more slowly
//   memory  the script's heap, in bytes: a collection that finds more live ends the call, and
//           one request for more than all of it (Bytes(n), a list's room) is refused at once,
//           nothing taken
//   depth   how deep its calls go: deeper is a StackOverflowError in the script
// The top level, as the script starts, is a call as any. A call that ends by a limit ends at
// once, no catch or finally of the script's run, and is a ScriptLimitException in the program;
// the script goes on for the next, what it was in the middle of left as it was. A program whose
// scripts keep passing their limits stops them (a game: a mod disabled after a few).
value Limits(val time : Duration? = null, val steps : int? = null, val memory : int? = null, val depth : int? = null) {
  init {
    if (time != null and time!!.inNanoseconds <= 0) { throw IllegalArgumentException("a script's time limit is more than nothing, not $time") }
    if (steps != null and steps!! < 0) { throw IllegalArgumentException("a script's steps cannot be fewer than none, not $steps") }
    if (memory != null and memory!! <= 0) { throw IllegalArgumentException("a script's memory limit is more than nothing, not $memory") }
    if (depth != null and depth!! <= 0) { throw IllegalArgumentException("a script's depth is a call or more, not $depth") }
  }

  // As __script takes them: [nanoseconds, steps, bytes, calls], each null for none.
  internal fun forScript() : List<any?> => [time?.inNanoseconds, steps, memory, depth]
}

// ---- What the compiler and the contract's proxies call ----

// The contract each interface named in Script.compile(..., api = DoorApi#) is declared in: its
// file's name and text, by the interface's name. The compiler writes the call that fills it in
// place of the `DoorApi#` (CompilerSession::useContract).
internal val __scriptContracts : open Map<string, Pair<string, string>> = {:}

fun __scriptContract(type : Class, file : string, source : string) : Class {
  __scriptContracts[type.name] = Pair(file, source)
  return type
}

// A call of a method of the object a proxy stands for, on the other side.
fun __scriptForward(handle : any, member : string, arguments : List<any?>) : any? {
  val answer = __script.forward(handle, 1, member, arguments) as List<any?>
  if (!(answer[0] as bool)) { throw __scriptFailed(null, answer) }
  return answer[1]
}

// A val of the object a proxy stands for, on the other side.
fun __scriptGet(handle : any, member : string) : any? {
  val answer = __script.forward(handle, 2, member, []) as List<any?>
  if (!(answer[0] as bool)) { throw __scriptFailed(null, answer) }
  return answer[1]
}

// What a failed answer ([false, what went wrong, whether a limit failed it]) throws: a
// ScriptLimitException or a ScriptException, its text after `name` where there is one.
fun __scriptFailed(name : string?, answer : List<any?>) : ScriptException {
  val text = name == null ? __scriptFailure(answer[1] as string) : "$name: ${answer[1] as string}"
  return answer.size > 2 and answer[2] as bool ? ScriptLimitException(text) : ScriptException(text)
}

// In a script compiled with api = ...: the program's object its `api` stands for.
fun __scriptApi() : any => __script.api()

// What the other side threw, as this side's ScriptException says it: a ScriptException that
// crossed already said once.
fun __scriptFailure(text : string) : string => text.startsWith("ScriptException: ") ? text[17 ..< text.size] : text

// Script.compile's and ScriptVM.compile's work: the contract of the interfaces named found (the
// compiler put it there), and the script compiled, in the ScriptVM `vm` or, where it is null, as
// a program of its own.
fun __scriptCompile(vm : any?, source : string, name : string, folder : FilePath?, api : Class?, gives : Class?,
                    trusted : bool) : Script throws ScriptError {
  var contract : Pair<string, string>? = null
  for (named in [api, gives]) {
    if (named == null) { continue }
    val found = __scriptContracts[named!!.name]
    if (found == null) {
      throw IllegalArgumentException("${named!!.name} is not an interface of a script's contract: name it in the call itself, api = ${named!!.name}#")
    }
    contract = found
  }
  val made = __script.compile(vm, source, name, (folder ?: FilePath(".")).absolute.toString(), contract?.first ?: "", contract?.second ?: "",
                              api?.name ?: "", gives?.name ?: "", !trusted, folder?.absolute?.toString())
  if (made is List) {
    val problems = (made as List<List<any>>).map {
      ScriptProblem(it[0] as string, it[1] as int, it[2] as int, it[3] as string)
    }
    throw ScriptError(problems)
  }
  return Script(made, name, api, gives)
}

// ---- Code compiled into the program itself ----
// Source compiled while the program runs into the program itself (asked 2026-11-21, for an
// emulator that translates the code it runs into WinterWolf): in the program's own VM, on the
// calling thread, trusted, with nothing copied. Unlike a Script, it is the program's own code:
// its imports are the program's files and their classes, the same ones, and the names of the
// program's main file are its own, so what it makes is an object like any (a class of the
// program's extended, an interface of the program's implemented, a function) and runs as fast
// as the program's own code.
//
//   // shape.ww, imported by the program
//   interface Shape { fun area() : float }
//
//   val made = Compiler.compile("import \"shape.ww\".*\nobject : Shape { override fun area() : float => 2.5 }") as Shape
//   print(made.area())   // 2.5
//
// Each compile is one more file in `folder` (by default the folder of the program's own file),
// which its imports are looked for from: the names of that folder's files are its own, as for any
// file there, and what it declares at its top level joins them (a name the program already
// declares cannot be declared again). The compile needs the compiler's view of the program. Run
// from its source (ww program.ww), the program is compiled from it each time it starts (the units
// ww kept are put back, so that is quick), never read back whole from what ww kept, and that view
// is kept. Built (ww build, to a bytecode file or an executable), it carries the sources it was
// compiled from and keeps all of its code; its first compile compiles it again from those, not
// from the disk (once, taking about as long as compiling it did), so it works where they are not.
object Compiler {
  // `source` compiled into the program, as the file `name` in `folder`, and run: what its last
  // expression gives (null where it ends with none). An IllegalArgumentException with the
  // compiler's errors, each with its line and column, where it does not compile; an
  // IllegalStateException in a program built without its sources (by a ww before 0.9.5050).
  fun compile(source : string, name : string = "code.ww", folder : FilePath? = null) : any? =>
    __compileHere(source, name, folder?.text ?: "")
}
