// Real chains, as eight sites served them on 2026-11-20 (tests/data/certs/real, fetched by
// tools/crypto/fetch_chains.py), each checked at the moment it was fetched up to the root
// Ubuntu's bundle has for it: RSA and ECDSA (P-256 and P-384) at each step, cross-signed roots,
// wildcards. Then what is refused: another host, a later time, a damaged signature, a missing
// intermediate, the wrong root.
import Crypto.*

val dir = "data/certs/real"
val index = (Json.read(FilePath("$dir/index.json").readText()) as List<any?>).map { it as Map<string, any?> }

fun refusal(block : () -> unit) : string {
  try {
    block()
    return "taken"
  } catch (e : CertificateException) {
    return e.message ?: ""
  }
}

for (e in index) {
  val host = e["host"] as string
  val chain = Certificate.allFromPem(FilePath("$dir/${e["chain"]}").readText())
  val root = Certificate.fromPem(FilePath("$dir/${e["root"]}").readText())
  val at = Instant.parse(e["fetched"] as string)
  val store = TrustStore([root])
  val path = store.verify(chain, host, at)
  // In any order after the leaf.
  val shuffled = [chain[0]] + chain.drop(1).reversed()
  print("$host: ${path.size} long to ${path.last().subject.commonName}, " +
        "${path.last().subject == DistinguishedName(root.subject.der)} ${store.verify(shuffled, host, at).size == path.size} ${path[0].matchesHost(host)}")
}
// expect: www.google.com: 3 long to GTS Root R4, true true true
// expect: github.com: 3 long to Sectigo Public Server Authentication Root E46, true true true
// expect: www.cloudflare.com: 3 long to GTS Root R4, true true true
// expect: letsencrypt.org: 4 long to ISRG Root X2, true true true
// expect: www.wikipedia.org: 4 long to ISRG Root X2, true true true
// expect: www.microsoft.com: 4 long to DigiCert Global Root G2, true true true
// expect: www.amazon.com: 3 long to Amazon Root CA 1, true true true
// expect: www.mozilla.org: 4 long to ISRG Root X1, true true true

// One chain looked at closely.
val github = Certificate.allFromPem(FilePath("$dir/github.pem").readText())
val leaf = github[0]
print(leaf.subject, "|", leaf.issuer.commonName, "|", leaf.dnsNames, "|", leaf.version, leaf.isCa, github[1].isCa, github[1].pathLength)
// expect: CN=github.com | Sectigo Public Server Authentication CA DV E36 | ["github.com", "www.github.com"] | 3 false true 0
print(leaf.publicKey is P256PublicKey, leaf.keyUsage!!.contains(KeyUsage.digitalSignature), leaf.extendedKeyUsage!!.contains(ExtendedKeyUsage.serverAuth))
// expect: true true true
print(Certificate.fromPem(leaf.toPem()) == leaf, Certificate(leaf.der).fingerprint == leaf.fingerprint, leaf.fingerprint.size)
// expect: true true 32
print(leaf.isSignedBy(github[1]), github[1].isSignedBy(leaf), leaf.matchesHost("WWW.GitHub.com."), leaf.matchesHost("api.github.com"))
// expect: true false true false

val e = index[1]
val at = Instant.parse(e["fetched"] as string)
val store = TrustStore([Certificate.fromPem(FilePath("$dir/${e["root"]}").readText())])
print(refusal { store.verify(github, "gist.github.com", at) })
// expect: the certificate CN=github.com: it is not for gist.github.com (it is for github.com, www.github.com)
print(refusal { store.verify(github, "github.com", Instant.parse("2030-01-01T00:00:00Z")) })
// expect: the certificate CN=github.com: it expired at 2027-01-27T23:59:59Z
print(refusal { store.verify(github, "github.com", Instant.parse("2020-01-01T00:00:00Z")) })
// expect: the certificate CN=github.com: it is not good until 2026-10-30T00:00:00Z
print(refusal { store.verify([github[0]], "github.com", at) })
// expect: no issuer of CN=github.com (CN=Sectigo Public Server Authentication CA DV E36, O=Sectigo Limited, C=GB) is trusted or given
val damaged = leaf.der[0..]
damaged[damaged.size - 3] = (damaged[damaged.size - 3].toInt() ^ 1).toByte()
print(refusal { store.verify([Certificate(damaged), github[1]], "github.com", at) })
// expect: the certificate CN=github.com: its signature is not good
val google = TrustStore([Certificate.fromPem(FilePath("$dir/google-root.pem").readText())])
print(refusal { google.verify(github, "github.com", at) })
// expect: no issuer of CN=Sectigo Public Server Authentication CA DV E36, O=Sectigo Limited, C=GB (CN=Sectigo Public Server Authentication Root E46, O=Sectigo Limited, C=GB) is trusted or given
print(refusal { store.verify(github, "github.com", at, ExtendedKeyUsage.codeSigning) })
// expect: the certificate CN=github.com: its extended key usage does not have 1.3.6.1.5.5.7.3.3

// The system's roots are there (checking a chain with them may fetch a root on Windows, so it is
// not done here).
print(TrustStore.system().roots.size > 10)
// expect: true
