// needs windows: it draws text
// Charts (M8): JadeUI's six chart tests (ChartAxisTest, ChartCategoryColorTest, ChartHoverTest,
// ChartLegendTest, ChartPaletteWrapTest, ChartViewTest), on images and on components laid out and
// drawn with no window.
// The colours of categories are in jade_charts_colors.ww.
import Jade.*

fun render(data : ChartData, w : int = 420, h : int = 260) : Image {
  val image = Image(w, h)
  val c = image.canvas()
  c.color = Color.white
  c.fillRect(0, 0, w, h)
  ChartRenderer.render(data, c, w, h)
  return image
}
// The pixels not white in a region: labels are ink where there was none.
fun ink(image : Image, x0 : int, y0 : int, x1 : int, y1 : int) : int {
  var n = 0
  for (y in y0 ..< y1) {
    for (x in x0 ..< x1) {
      if (image.get(x, y).argb != 0xFFFFFFFF) { n += 1 }
    }
  }
  return n
}
// A view laid out and drawn once: the first paint is what makes the places of its data.
fun shown(data : ChartData, w : int = 500, h : int = 300) : Pair<ChartView, Component> {
  val view = ChartView(data)
  val c = Component(view)
  c.layout(w, h)
  c.renderToImage(w, h)
  return view to c
}
// Each category's colour, once (a pie's legend lines repeat its slices).
fun colorsOf(view : ChartView) : List<Color> {
  val seen : open Map<int, Color> = {:}
  for (hit in view.layout().hits) {
    if (!seen.keys.contains(hit.point)) { seen[hit.point] = hit.color }
  }
  return seen.keys.toList().sorted().map { seen[it]!! }
}
fun isRect(hit : ChartHit) : bool => hit.shape is Rect

print("-- the axis: ticks")   // expect: -- the axis: ticks
// Steps land on 1, 2, 2.5 or 5 times a power of ten.
var round = true
for (range in [0.9, 3.0, 7.0, 12.0, 37.0, 88.0, 176.0, 1234.0, 250000.0]) {
  val step = ChartRenderer.niceStep(range, 5)
  val mantissa = step / Math.pow(10.0, Math.floor(Math.log10(step)))
  round = round and [1.0, 2.0, 2.5, 5.0].any { Math.abs(mantissa - it) < 1e-9 }
}
print(round)   // expect: true
// A range of nothing still gives a step to use.
print(ChartRenderer.niceStep(0.0, 5), ChartRenderer.niceStep(-5.0, 5), ChartRenderer.niceStep(0.0 / 0.0, 5))   // expect: 1.0 1.0 1.0
// Ticks are whole multiples, with no drift from adding up.
val ticks = ChartRenderer.tickValues(0.0, 25.0, 2.5)
print(ticks.size, ticks.last(), ticks.indices.toList().all { Math.abs(ticks[it] - it * 2.5) < 1e-12 })   // expect: 11 25.0 true
// A bar chart's axis always has nought.
print(ChartRenderer.tickValues(0.0, 100.0, ChartRenderer.niceStep(100.0, 5)).first())   // expect: 0.0
// A tick's number has the decimals its step needs.
print(ChartRenderer.tickLabel(0.0, 0.5), ChartRenderer.tickLabel(2.5, 2.5), ChartRenderer.tickLabel(20.0, 5.0), ChartRenderer.tickLabel(176.0, 20.0))   // expect: 0.0 2.5 20 176
// A step of nothing, or a tiny one, gives two ticks rather than a billion.
print(ChartRenderer.tickValues(0.0, 1.0, 0.0).size, ChartRenderer.tickValues(0.0, 1e9, 1e-9).size)   // expect: 2 2

print("-- values")   // expect: -- values
// Four significant figures are not cut down to fewer: 1200.5 once came out 12.
print(ChartRenderer.fmt(1200.5), ChartRenderer.fmt(1200.0), ChartRenderer.fmt(12.0), ChartRenderer.fmt(12.34), ChartRenderer.fmt(0.7))   // expect: 1200 1200 12 12.34 0.7
// Not a number is a dash rather than the word.
print(ChartRenderer.fmt(0.0 / 0.0), ChartRenderer.fmt(1.0 / 0.0))   // expect: - -

print("-- the axis drawn")   // expect: -- the axis drawn
val ram = ChartData(ChartType.bar, [ChartSeries([12.4, 4.7, 1.3, 12.8, 0.7])], ["Nonpaged", "Paged res.", "Cache", "Processes", "Free"], "Physical RAM (GB)")
print(ink(render(ram), 0, 40, 34, 220) > 40)   // expect: true
val history = ChartData(ChartType.line, [ChartSeries([0.0, 25.0, 50.0, 75.0, 100.0])], [], "History")
print(ink(render(history), 0, 34, 34, 230) > 40)   // expect: true
// Data of nothing draws without failing or dividing by nought.
render(ChartData(ChartType.bar, [ChartSeries([0.0, 0.0])], ["a", "b"], "t"))
render(ChartData(ChartType.bar, [ChartSeries([1.0])], ["a"], "t"), w = 30, h = 20)
render(ChartData(ChartType.line, [ChartSeries([1.0, 2.0])], [], "t"), w = 30, h = 20)
render(ChartData(ChartType.line, [ChartSeries([5.0])], [], "t"))
render(ChartData(ChartType.pie, [ChartSeries([0.0, 0.0])], ["a", "b"], "t"))
print("drawn")   // expect: drawn

print("-- the datum under the pointer")   // expect: -- the datum under the pointer
val barLabels = ["Nonpaged", "Paged res.", "Cache", "Processes", "Free"]
val barValues = [12.4, 4.7, 1.3, 12.8, 0.7]
fun barView(colorByCategory : bool = true) : Pair<ChartView, Component> =>
  shown(ChartData(ChartType.bar, [ChartSeries(barValues)], barLabels, "Physical RAM (GB)", valueFormat = { "%.1f GB".format(it) }, colorByCategory = colorByCategory))
fun centreOf(view : ChartView, index : int) : Pair<int, int> {
  val b = view.layout().hits.first { it.point == index }.shape.bounds
  return (b.x + b.width / 2) to (b.y + b.height / 2)
}
// Every bar can be found.
val bars = barView()
print(bars.first.layout().hits.size, bars.first.layout().hits.map { it.label } == barLabels, bars.first.layout().hits.map { it.value } == barValues)   // expect: 5 true true
// colorByCategory gives each bar a colour of its own; by series, one series is one colour.
print(bars.first.layout().hits.map { it.color }.toSet().size, barView(false).first.layout().hits.map { it.color }.toSet().size)   // expect: 5 1
// Hovering a bar picks it out, and nothing else; the pick follows the pointer.
val hv = barView()
print(hv.first.hovered)   // expect: null
hv.second.dispatch(Event.Hover(centreOf(hv.first, 3).first, centreOf(hv.first, 3).second))
print(hv.first.hovered)   // expect: ChartPoint(series=0, point=3)
hv.second.dispatch(Event.Hover(centreOf(hv.first, 0).first, centreOf(hv.first, 0).second))
print(hv.first.hovered)   // expect: ChartPoint(series=0, point=0)
// The pointer leaving takes the pick away; so does empty space.
hv.second.dispatch(Event.Hover(-1, -1))
print(hv.first.hovered)   // expect: null
hv.second.dispatch(Event.Hover(centreOf(hv.first, 1).first, centreOf(hv.first, 1).second))
hv.second.dispatch(Event.Hover(2, 2))
print(hv.first.hovered)   // expect: null
// The tooltip names the datum, in the chart's own format.
print(hv.first.tooltipAt(centreOf(hv.first, 0).first, centreOf(hv.first, 0).second), hv.first.tooltipAt(2, 2))   // expect: Nonpaged: 12.4 GB null
// The pick changes what is drawn.
val before = hv.second.renderToImage(500, 300)
hv.second.dispatch(Event.Hover(centreOf(hv.first, 3).first, centreOf(hv.first, 3).second))
val after = hv.second.renderToImage(500, 300)
var differs = false
for (y in 0 ..< 300 step 2) {
  for (x in 0 ..< 500 step 2) {
    if (before.get(x, y) != after.get(x, y)) { differs = true }
  }
}
print(differs)   // expect: true
// A click on a datum reports it; on empty space, nothing.
val clicked = []
hv.first.onSelect = { clicked.add(it.label) }
hv.second.dispatch(Event.Click(centreOf(hv.first, 4).first, centreOf(hv.first, 4).second))
hv.second.dispatch(Event.Click(2, 2))
print(clicked)   // expect: ["Free"]
// The pointer is a hand only over a datum that can be clicked.
val hand = barView()
val at1 = centreOf(hand.first, 1)
print(hand.second.cursorAt(at1.first, at1.second))   // expect: default
hand.first.onSelect = {}
print(hand.second.cursorAt(at1.first, at1.second), hand.second.cursorAt(2, 2))   // expect: hand default
hand.first.canSelect = { it.label != "Paged res." }
print(hand.second.cursorAt(at1.first, at1.second))   // expect: default
// New data drops the old pick, and the old places.
val stale = barView()
val at2 = centreOf(stale.first, 2)
stale.second.dispatch(Event.Hover(at2.first, at2.second))
stale.first.setData(ChartData(ChartType.bar, [ChartSeries([1.0])], ["only"], "t"))
print(stale.first.hovered, stale.first.tooltipAt(at2.first, at2.second))   // expect: null null
// A pie's slices and their legend lines can both be found.
val twoSlices = shown(ChartData(ChartType.pie, [ChartSeries([3.0, 1.0])], ["a", "b"], "t")).first
print(twoSlices.layout().hits.size, twoSlices.layout().hits.map { it.label }.sorted())   // expect: 4 ["a", "a", "b", "b"]
val legendB = twoSlices.layout().hits.last { it.label == "b" }.shape.bounds
print(twoSlices.layout().at(legendB.x + legendB.width / 2, legendB.y + legendB.height / 2)?.id)   // expect: ChartPoint(series=0, point=1)
// A line's points can be found from a few pixels away.
val line = shown(ChartData(ChartType.line, [ChartSeries([0.0, 5.0, 2.0, 8.0])], [], "t")).first
val pb = line.layout().hits[2].shape.bounds
print(line.layout().hits.size, line.layout().at(pb.x + pb.width / 2 + 2, pb.y + pb.height / 2 + 2)?.id)   // expect: 4 ChartPoint(series=0, point=2)
// After a resize the places are worked out again, at the new size.
val resized = barView()
resized.second.dispatch(Event.Hover(centreOf(resized.first, 3).first, centreOf(resized.first, 3).second))
resized.second.layout(700, 400)
resized.second.renderToImage(700, 400)
val moved = resized.first.layout().hits.first { it.point == 3 }.shape.bounds
print(moved.width > 0 and moved.x > 0, moved.x > centreOf(barView().first, 3).first - 60)   // expect: true true
// A pie's legend fits inside the chart, and a legend far too long is capped so that the pie stays.
fun ramPie(w : int, h : int, names : List<string>) : ChartView =>
  shown(ChartData(ChartType.pie, [ChartSeries([11.7, 4.0, 1.7, 12.5, 1.8])], names, "Physical RAM", valueFormat = { "%.1f GB".format(it) }), w, h).first
val fits = ramPie(420, 260, ["Nonpaged pool", "Paged pool (resident)", "System cache", "Processes", "Free"]).layout().hits.filter { isRect(it) }
print(fits.size, fits.all { it.shape.bounds.x + it.shape.bounds.width <= 420 and it.shape.bounds.x >= 0 })   // expect: 5 true
val longNames = (0 ..< 5).toList().map { "a legend entry so long it would swallow the entire chart area #$it" }
val capped = ramPie(420, 260, longNames).layout().hits
print(capped.filter { isRect(it) }.all { it.shape.bounds.x + it.shape.bounds.width <= 420 })   // expect: true
print(capped.filter { !isRect(it) }.size, capped.filter { !isRect(it) }.all { it.shape.bounds.width > 20 })   // expect: 5 true
// A chart of no data finds nothing under the pointer, and does not fail.
val none = shown(ChartData(ChartType.bar, [ChartSeries([])], [], "t"), 200, 120)
none.second.dispatch(Event.Hover(50, 50))
print(none.first.tooltipAt(50, 50), none.first.hovered)   // expect: null null
// The palette's colours are far enough apart to tell.
var apart = ChartRenderer.palette.size >= 5
for (i in 0 ..< ChartRenderer.palette.size) {
  for (j in i + 1 ..< ChartRenderer.palette.size) {
    val a = ChartRenderer.palette[i]
    val b = ChartRenderer.palette[j]
    val dr = (a.red - b.red).toFloat()
    val dg = (a.green - b.green).toFloat()
    val db = (a.blue - b.blue).toFloat()
    apart = apart and Math.sqrt(dr * dr + dg * dg + db * db) > 40
  }
}
print(apart)   // expect: true

print("-- the legend of lines")   // expect: -- the legend of lines
fun series(name : string, base : float) : ChartSeries => ChartSeries((0 ..< 8).toList().map { base + it }, name)
val oneLine = ChartData(ChartType.line, [ChartSeries((0 ..< 8).toList().map { 10.0 + it })], [], "t")
val three = ChartData(ChartType.line, [series("Committed", 10.0), series("Paged pool", 30.0), series("Nonpaged pool", 5.0)], [], "Memory over time")
print(ink(render(three, 460, 280), 300, 36, 450, 90) > ink(render(oneLine, 460, 280), 300, 36, 450, 90) + 50)   // expect: true
// One series has no legend.
val only = ChartData(ChartType.line, [series("Only", 10.0)], [], "t")
print(ink(render(only, 460, 280), 300, 36, 450, 90) - ink(render(oneLine, 460, 280), 300, 36, 450, 90) < 40)   // expect: true
// Series with no names, or names that cannot fit, draw no legend and do not fail.
render(ChartData(ChartType.line, [ChartSeries((0 ..< 8).toList().map { 10.0 + it }), ChartSeries((0 ..< 8).toList().map { 20.0 + it })], [], "t"), 460, 280)
render(ChartData(ChartType.line, [series("a name far too long for this chart", 10.0), series("another very long one", 20.0)], [], "t"), 120, 90)
print("drawn")   // expect: drawn

// A colour near white, as a category's own (as in jade_charts_colors.ww).
val nearWhite = Color(0xF7, 0xF7, 0xF7)
print("-- the palette going round")   // expect: -- the palette going round
fun colorsFor(count : int) : List<Color> =>
  colorsOf(shown(ChartData(ChartType.pie, [ChartSeries((0 ..< count).toList().map { (count - it).toFloat() })], (0 ..< count).toList().map { "cat $it" }, "wrapping"), 600, 360).first)
// No two categories share a colour, however many.
val many = colorsFor(24)
print(many.size, many.toSet().size)   // expect: 24 24
// The first eight are the palette itself.
print(colorsFor(8) == ChartRenderer.palette)   // expect: true
// The ninth is the first, darker, not a new hue.
val nine = colorsFor(9)
print(nine[8] != nine[0], nine[8].red < nine[0].red and nine[8].green < nine[0].green and nine[8].blue < nine[0].blue, nine[8].blue > nine[8].red)   // expect: true true true
// Shades go dark, light, darker, lighter.
val base = Color(0x4E, 0x79, 0xA7)
fun lum(c : Color) : int => c.red + c.green + c.blue
print(lum(ChartRenderer.shade(base, 1)) < lum(base), lum(ChartRenderer.shade(base, 2)) > lum(base),
      lum(ChartRenderer.shade(base, 3)) < lum(ChartRenderer.shade(base, 1)), lum(ChartRenderer.shade(base, 4)) > lum(ChartRenderer.shade(base, 2)),
      ChartRenderer.shade(base, 0) == base)   // expect: true true true true true
// A shade never comes near white, which means nothing on these charts.
print(ChartRenderer.palette.all { b -> (1 .. 8).toList().all { cycle ->
  val c = ChartRenderer.shade(b, cycle)
  Math.min(Math.min(c.red, c.green), c.blue) < 215
} })   // expect: true
// A category's own colour wins over the shading.
val tenth = colorsOf(shown(ChartData(ChartType.pie, [ChartSeries((0 ..< 10).toList().map { 10.0 - it })], (0 ..< 10).toList().map { "cat $it" }, "overridden",
                                     categoryColors = [null, null, null, null, null, null, null, null, null, nearWhite]), 600, 360).first)
print(tenth[9] == nearWhite)   // expect: true

print("-- the view")   // expect: -- the view
// Every type draws something.
val every = []
for (type in ChartType.entries) {
  val drawn = Component(ChartView(ChartData(type, [ChartSeries([3.0, 1.0, 4.0, 1.0, 5.0, 9.0])], ["a", "b", "c", "d", "e", "f"]))).renderToImage(400, 260)
  every.add("$type ${ink(drawn, 0, 0, 400, 260) > 200}")
}
print(every)   // expect: ["bar true", "line true", "area true", "scatter true", "pie true"]
// It draws on the window's canvas at the size it is given (JadeUI drew an image and showed that;
// drawn as it is, it stays sharp at any scale).
val recorded = barChart([1.0, 2.0, 3.0], ["x", "y", "z"]).record(300, 200)
val back = recorded.first { it is DrawOp.Rect } as DrawOp.Rect
print(recorded.none { it is DrawOp.Image }, back.w, back.h, recorded.any { it is DrawOp.Text and (it as DrawOp.Text).text == "z" })   // expect: true 300 200 true
// No data draws a message rather than failing.
print(ink(Component(ChartView(ChartData(ChartType.bar, []))).renderToImage(200, 120), 0, 0, 200, 120) > 0)   // expect: true
// The shorthands.
print(lineChart(ChartSeries([1.0, 2.0]), ChartSeries([2.0, 1.0]), title = "two").content is ChartView, pieChart([1.0, 2.0]).content is ChartView)   // expect: true true
