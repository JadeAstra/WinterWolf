// ww's Complex gives CPython 3.14's answers (C11's Annex G: infinities recovered where a product
// or quotient would come out NaN + NaN i; a real divided by a complex without an imaginary part
// of its own; rect's special values), over every pair of awkward values, each folded into one
// number as tools/complex/python_complex.py folds CPython's. Snippy's complex arithmetic and
// cmath.rect are these (S8, S9 of docs/snippy-ww-checklist.html).

val m = 1000000007
val inf = 1.0 / 0.0
val nan = 0.0 / 0.0
val vals = [0.0, -0.0, 1.0, -2.5, 1e308, 1e-310, inf, -inf, nan]
val angles = [0.0, -0.0, 1.0, -2.5, 3.0, 1e-310, 100.0, inf, -inf, nan]
fun part(x : float) : int => x.isNaN() ? 1 : x.toBits().mod(m)
fun fold(h0 : int, z : Complex?) : int {
  if (z == null) { return (h0 * 1000003 + 3) % m }
  var h = (h0 * 1000003 + part(z!!.re) + 1) % m
  return (h * 1000003 + part(z!!.im) + 1) % m
}

var products = 0
var quotients = 0
var reals = 0
var rects = 0
for (a in vals) { for (b in vals) { for (c in vals) { for (d in vals) {
  products = fold(products, Complex(a, b) * Complex(c, d))
  if (!(c == 0.0 and d == 0.0)) { quotients = fold(quotients, Complex(a, b) / Complex(c, d)) }
} } } }
for (a in vals) { for (c in vals) { for (d in vals) {
  if (!(c == 0.0 and d == 0.0)) { reals = fold(reals, a / Complex(c, d)) }
} } }
for (r in vals) { for (t in angles) {
  // CPython's ValueError: a size not 0 nor NaN at an infinite angle.
  rects = fold(rects, r != 0.0 and !r.isNaN() and t.isInfinite() ? null : Complex.fromPolar(r, t))
} }
print(products == 378877874, quotients == 804439306, reals == 6114268, rects == 339522799)   // expect: true true true true

// A few by themselves.
print(Complex(1.0, 0.0) * Complex(inf, nan), Complex(inf, nan) / Complex(1.0, 1.0), 2.0 / Complex(-0.0, 2.0), 1 / Complex(0.0, inf))
// expect: inf+nani inf-infi -0.0-1.0i 0.0-0.0i
print(Complex.fromPolar(inf, 0.0), Complex.fromPolar(-inf, -0.0), Complex.fromPolar(nan, 0.0), Complex.fromPolar(0.0, inf), Complex.fromPolar(-inf, 1.0))
// expect: inf+0.0i -inf+0.0i nan+0.0i 0.0+0.0i -inf-infi
