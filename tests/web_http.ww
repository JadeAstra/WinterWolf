// import Web's HTTP server and client in one program over the loopback (networking plan, part 6):
// routes, JSON, forms, multipart, redirects, cookies, gzip, streaming, HEAD, a handler that fails;
// the server given malformed requests by hand (each answered with its status, none hurting the
// next connection); the client given odd responses by small servers of bytes (bodies to the
// connection's end, 1xx, chunks with trailers, cut short, redirect loops), keeping connections
// and sending again on one the server had closed. tools/web/web_interop.sh checks the server
// against curl, and page.html in a browser.
import Web.*

val router = HttpRouter()
  .get("/") { r -> HttpResponse.html("<h1>hello</h1>") }
  .get("/users/{id}") { r -> HttpResponse.json({"id": r.pathParameter("id"), "q": r.query("q")}) }
  .get("/files/*") { r -> HttpResponse.text("rest: ${r.pathParameter("*")}") }
  .post("/echo") { r -> HttpResponse.text("${r.method} ${r.body.size} ${r.header("Content-Type")}") }
  .post("/form") { r -> HttpResponse.json(r.form().map { "${it.first}=${it.second}" }) }
  .get("/big") { r -> HttpResponse.text("wolf ".repeat(4000)) }
  .get("/stream") { r -> HttpResponse.stream("text/plain", { w -> for (i in 0..<3) { w.println("line $i") } }) }
  .get("/redirect") { r -> HttpResponse.redirect("/users/7?q=moved") }
  .post("/see-other") { r -> HttpResponse.redirect("/echo-method", 303) }
  .get("/echo-method") { r -> HttpResponse.text("now ${r.method}") }
  .get("/cookie") { r -> HttpResponse.text("set").setCookie(Cookie("session", "abc", path = "/")) }
  .get("/whoami") { r -> HttpResponse.text("cookies ${r.cookies()}") }
  .get("/fail") { r -> throw IllegalStateException("broken on purpose") }
  .get("/teapot") { r -> throw HttpException("no coffee", 418) }
val failures : open List<string> = []
val server = HttpServer(0, router, bindAddress = "127.0.0.1", idleTimeout = 5.seconds, maxBody = 100000,
                        onError = { r, e -> failures.add("${r.url.requestTarget}: ${e.message}") }).start()
val base = "http://127.0.0.1:${server.port}"
val client = HttpClient(cookies = CookieJar(), timeout = 10.seconds)

for (path in ["/", "/users/42?q=wolf%20pack", "/files/a/b%20c.txt", "/missing", "/redirect", "/cookie", "/whoami", "/fail", "/teapot"]) {
  val r = client.get(base + path)
  print(path, r.status, r.header("Content-Type")?.substringBefore(";"), r.text.take(50))
}
// expect: / 200 text/html <h1>hello</h1>
// expect: /users/42?q=wolf%20pack 200 application/json {"id": "42", "q": "wolf pack"}
// expect: /files/a/b%20c.txt 200 text/plain rest: a/b c.txt
// expect: /missing 404 text/plain 404 Not Found
// expect: /redirect 200 application/json {"id": "7", "q": "moved"}
// expect: /cookie 200 text/plain set
// expect: /whoami 200 text/plain cookies {"session": "abc"}
// expect: /fail 500 text/plain 500 Internal Server Error
// expect: /teapot 418 text/plain 418 : no coffee
val big = client.get(base + "/big")
print(big.status, big.body.size, big.text.startsWith("wolf wolf"), client.head(base + "/big").body.size)
// expect: 200 20000 true 0
print(client.get(base + "/stream").text.lines(), client.post(base + "/see-other", HttpBody.text("x")).text)
// expect: ["line 0", "line 1", "line 2", ""] now GET
print(client.post(base + "/echo", HttpBody.json({"a": 1})).text, client.put(base + "/echo", HttpBody.text("x")).status, client.delete(base + "/").header("Allow"))
// expect: POST 8 application/json 405 GET
print(client.post(base + "/form", HttpBody.form([Pair("a", "1 2"), Pair("b", "&=")])).text,
      client.post(base + "/form", HttpBody.multipart([FormPart.field("x", "y"), FormPart.file("f", "a.txt", "file body".toBytes())])).text)
// expect: ["a=1 2", "b=&="] ["x=y", "f=file body"]
print(client.post(base + "/echo", HttpBody.bytes(Bytes(200000))).status, failures)
// expect: 413 ["/fail: broken on purpose"]

// ---- The server given requests by hand ----
// What comes back for `request`, the server closing after it (or the client after a while).
fun raw(request : string) : string {
  val s = Socket("127.0.0.1", server.port)
  s.readTimeout = 5.seconds
  s.writer.write(request.toBytes(Charset.latin1))
  s.shutdownOutput()
  val reply = try { s.reader.readText() } catch (e : IOException) { "" }
  s.close()
  return reply
}
fun statusOf(request : string) : string => raw(request).lines().first()
for (request in [
    "GET / HTTP/1.1\r\n\r\n",
    "GET / HTTP/2.0\r\nHost: x\r\n\r\n",
    "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
    "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip, chunked\r\n\r\n",
    "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n",
    "GET / HTTP/1.1\r\nHost: x\r\nX-Folded: a\r\n b\r\n\r\n",
    "GET /\r\n\r\n",
    "GET /${"a".repeat(9000)} HTTP/1.1\r\nHost: x\r\n\r\n",
    "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 999999999\r\n\r\n",
    "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 1, 2\r\n\r\n",
    "GET / HTTP/1.0\r\n\r\n",
    "\r\n\r\nGET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"]) {
  print(statusOf(request))
}
// expect: HTTP/1.1 400 Bad Request
// expect: HTTP/1.1 505 HTTP Version Not Supported
// expect: HTTP/1.1 400 Bad Request
// expect: HTTP/1.1 501 Not Implemented
// expect: HTTP/1.1 400 Bad Request
// expect: HTTP/1.1 400 Bad Request
// expect: HTTP/1.1 400 Bad Request
// expect: HTTP/1.1 414 URI Too Long
// expect: HTTP/1.1 413 Content Too Large
// expect: HTTP/1.1 400 Bad Request
// expect: HTTP/1.1 200 OK
// expect: HTTP/1.1 200 OK
// Two requests in one write, answered in order; HEAD with its length and no body; 100-continue.
val two = raw("GET /users/1 HTTP/1.1\r\nHost: x\r\n\r\nGET /users/2 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
print(two.lines().filter { it.startsWith("HTTP/") or it.startsWith("{") })
// expect: ["HTTP/1.1 200 OK", "{\"id\": \"1\", \"q\": null}HTTP/1.1 200 OK", "{\"id\": \"2\", \"q\": null}"]
val head = raw("HEAD /big HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
print(head.lines().filter { it.startsWith("Content-Length") }, head.endsWith("\r\n\r\n"))
// expect: ["Content-Length: 20000"] true
print(raw("POST /echo HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi").lines().filter { it.startsWith("HTTP/") })
// expect: ["HTTP/1.1 100 Continue", "HTTP/1.1 200 OK"]
print(client.get(base + "/").status)
// expect: 200

// ---- The client given responses by hand ----
// A server of bytes: each connection it takes reads a request (to its empty line) and answers
// with the next of `answers`, closing after those that close it. Gives how many connections it took.
class ByteServer(val answers : List<string>, val closeAfter : List<bool>) {
  val listener = ServerSocket(0, bindAddress = "127.0.0.1")
  var connections = 0
  val job = thread {
    var next = 0
    while (next < answers.size) {
      val s = listener.accept()
      connections++
      s.readTimeout = 5.seconds
      try {
        while (next < answers.size) {
          var line = s.reader.readLine()
          while (line != null and line != "") { line = s.reader.readLine() }
          if (line == null) { break }
          s.writer.write(answers[next].toBytes(Charset.latin1))
          val close = closeAfter[next]
          next++
          if (close) { break }
        }
      } catch (e : IOException) { }
      s.close()
    }
    listener.close()
  }
  val url : string
    get() => "http://127.0.0.1:${listener.localPort}"
}
suspend fun fetch(answers : List<string>, closeAfter : List<bool> = [], times : int = 1) : string {
  val bytes = ByteServer(answers, closeAfter.isEmpty() ? answers.map { true } : closeAfter)
  val c = HttpClient(timeout = 5.seconds)
  var said = ""
  for (i in 0..<times) {
    try {
      val r = c.get(bytes.url + "/x")
      said += "${r.status} '${r.text}' "
    } catch (e : IOException) {
      said += "refused: ${e.message} "
    }
  }
  bytes.job.get()
  c.close()
  return "${said.trim()} (${bytes.connections} connection${bytes.connections == 1 ? "" : "s"})"
}
print(fetch(["HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nto the end"]))
print(fetch(["HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\nLink: </a>\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"]))
print(fetch(["HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2;ext=1\r\nde\r\n0\r\nX-Trailer: t\r\n\r\n"]))
print(fetch(["HTTP/1.1 204 No Content\r\n\r\n"]))
print(fetch(["SPDY/9 200 OK\r\n\r\n"]))
print(fetch(["HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nshort"]))
print(fetch(["HTTP/1.1 200 OK\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"]))
print(fetch((0..<11).map { "HTTP/1.1 302 Found\r\nLocation: /again\r\nContent-Length: 0\r\n\r\n" }, (0..<11).map { false }))
// expect: 200 'to the end' (1 connection)
// expect: 200 'ok' (1 connection)
// expect: 200 'abcde' (1 connection)
// expect: 204 '' (1 connection)
// expect: refused: not an HTTP/1.x status line: 'SPDY/9 200 OK' (1 connection)
// expect: refused: the connection ended 5 bytes before the body's end (1 connection)
// expect: refused: both Transfer-Encoding and Content-Length (1 connection)
// expect: refused: more than 10 redirects, the last to /again (1 connection)
// Kept alive: three requests, one connection. A kept connection the server had closed: sent again.
print(fetch(["HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\na", "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\nb", "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\nc"],
            [false, false, true], 3))
print(fetch(["HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\na", "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\nb"], [true, true], 2))
// expect: 200 'a' 200 'b' 200 'c' (1 connection)
// expect: 200 'a' 200 'b' (2 connections)
server.stop()
