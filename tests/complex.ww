// Complex (2026-11-19): complex numbers as a value of two floats, mixed with ints and floats on
// either side, their functions as C99's and Python's cmath give them (the values below are
// cmath's), branch cuts and signed zeros included.

val z = Complex.of(3, 4)
print(z, Complex(1.5, -2.0), Complex.of(-1, -0.0), Complex.i, Complex.zero, Complex.one)   // expect: 3.0+4.0i 1.5-2.0i -1.0-0.0i 0.0+1.0i 0.0+0.0i 1.0+0.0i
print(z.re, z.im, z.abs(), z.arg(), z.conjugate())   // expect: 3.0 4.0 5.0 0.9272952180016122 3.0-4.0i
print(Complex.fromPolar(2, Math.pi / 2), Complex.fromPolar(1, 0))   // expect: 1.2246467991473532e-16+2.0i 1.0+0.0i

// ---- Arithmetic ----
print(z + Complex.of(1, 1), z - Complex.of(1, 1), z * Complex.of(1, 1), z / Complex.of(1, 1))   // expect: 4.0+5.0i 2.0+3.0i -1.0+7.0i 3.5+0.5i
print(z * Complex.i, -z, z.reciprocal(), 1 / z)   // expect: -4.0+3.0i -3.0-4.0i 0.12-0.16i 0.12-0.16i
print(2 + z, z + 2, 2.5 * z, z * 2, z - 1, 1 - z, z / 2, 1.0 / Complex.i)   // expect: 5.0+4.0i 5.0+4.0i 7.5+10.0i 6.0+8.0i 2.0+4.0i -2.0-4.0i 1.5+2.0i 0.0-1.0i
// Smith's division neither overflows nor underflows where the answer does not.
print(Complex(1.0e300, 1.0e300) / Complex(1.0e300, 1.0e300), Complex(1.0e-300, 1.0e-300) / Complex(1.0e-300, 2.0e-300))   // expect: 1.0+0.0i 0.6000000000000001-0.2i
print((Complex.one / Complex.zero).isNaN() or (Complex.one / Complex.zero).isInfinite())   // expect: true

// ---- Powers ----
print(Complex.i.pow(2), Complex.i.pow(3), Complex.i.pow(-1), Complex.of(1, 2).pow(10), z.pow(-2), z.pow(0))   // expect: -1.0+0.0i -0.0-1.0i 0.0-1.0i 237.0-3116.0i -0.0112-0.0384i 1.0+0.0i
print(z.pow(0.5), z.pow(Complex.of(1, 1)), Complex.zero.pow(Complex.of(2)), Complex.zero.pow(0.0), Complex.of(2).pow(0.5))   // expect: 2.0+1.0i -1.6271590399255338+1.1248463410919416i 0.0+0.0i 1.0+0.0i 1.414213562373095+0.0i

// ---- Functions ----
print(z.sqrt(), z.exp(), z.log())   // expect: 2.0+1.0i -13.128783081462158-15.200784463067954i 1.6094379124341003+0.9272952180016122i
print(z.sin(), z.tan(), z.atanh())   // expect: 3.853738037919377-27.016813258003932i -0.0001873462046294784+0.999355987381473i 0.1175009073114339+1.4099210495965755i
// The cuts: the sign of a zero imaginary part says which side.
print(Complex.of(-4).sqrt(), Complex(-4.0, -0.0).sqrt(), Complex.of(-1).log(), Complex(-1.0, -0.0).log())   // expect: 0.0+2.0i 0.0-2.0i 0.0+3.141592653589793i 0.0-3.141592653589793i
print(Complex.of(2).asin(), Complex(2.0, -0.0).asin(), Complex.of(2).acos())   // expect: 1.5707963267948966+1.3169578969248166i 1.5707963267948966-1.3169578969248166i 0.0-1.3169578969248166i
// Digits kept where the plain formulas lose them: tanh far out, log near 1. All as CPython's cmath
// gives them, to the last digit (tests/cmath_python.ww tries many more).
print(Complex.of(30, 1).tanh(), Complex.of(-500, 2).tanh(), Complex.of(1 + 1.0e-12).log())   // expect: 1.0+1.5924545408982664e-26i -1.0-0.0i 1.0000889005818408e-12+0.0i
// Each function undone by its inverse, at points inside every inverse's principal range.
var off = 0.0
for (w in [Complex.of(0.3, 0.2), Complex.of(0.6, -0.4), Complex.of(1.1, 0.5)]) {
  off = Math.max(off, (w.sin().asin() - w).abs(), (w.cos().acos() - w).abs(), (w.tan().atan() - w).abs())
  off = Math.max(off, (w.sinh().asinh() - w).abs(), (w.cosh().acosh() - w).abs(), (w.tanh().atanh() - w).abs())
  off = Math.max(off, (w.exp().log() - w).abs(), (w.sqrt() * w.sqrt() - w).abs(), (w.log10() * Math.ln(10) - w.log()).abs())
}
print(off < 1.0e-14)   // expect: true

// ---- Equality and keys ----
print(Complex.of(3) == 3, 3 == Complex.of(3), 3.0 == Complex.of(3), Complex.of(3, 1) == 3, z == Complex.of(3, 4), z != z.conjugate())   // expect: true true true false true true
print(Complex(0.0, 0.0) == Complex(-0.0, -0.0), Complex(0.0 / 0.0, 0.0) == Complex(0.0 / 0.0, 0.0), Complex.of(2).hashCode() == 2.hashCode())   // expect: true false true
val keyed : Map<any, string> = mapOf(3 to "three", z to "z")
print(keyed[Complex.of(3)], keyed[Complex.of(3, 4)], setOf(5, Complex.of(5), 5.0).size, [1, 2].indexOf(Complex.of(2)))   // expect: three z 1 1
print(5.toComplex(), 2.5.toComplex(), z.isNaN(), Complex(1.0 / 0.0, 0.0).isInfinite())   // expect: 5.0+0.0i 2.5+0.0i false true
