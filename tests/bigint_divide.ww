var wrong = 0
for (t in quotients) {
  val got = bitsOf(t.first.toBigInt().divideToFloat(t.second.toBigInt()))
  if (got != t.third) {
    wrong += 1
    print("wrong:", t.first, "/", t.second, "gave", got, "not", t.third)
  }
}
