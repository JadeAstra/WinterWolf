// The pieces ww gained so that Snippy could use ww's own versions (U1-U26 of
// docs/snippy-ww-checklist.html), each named as Kotlin or Java names it. The values are Java 21's
// LocalDate and BigInteger and Python's date and int.to_bytes/from_bytes.

// LocalDate: Java's isLeapYear, lengthOfMonth, lengthOfYear; kotlinx-datetime's epoch days.
val d = LocalDate(2024, 2, 10)
print(d.isLeapYear, d.lengthOfMonth, d.lengthOfYear, d.epochDays, LocalDate(1900, 2, 1).isLeapYear, LocalDate(2000, 2, 1).lengthOfMonth, LocalDate(2023, 4, 1).lengthOfMonth)
// expect: true 29 366 19763 false 29 30
print(LocalDate.fromEpochDays(0), LocalDate.fromEpochDays(-1), LocalDate.fromEpochDays(19763), LocalDate(1, 1, 1).epochDays, LocalDate.fromEpochDays(-719162), LocalDate(9999, 12, 31).epochDays)
// expect: 1970-01-01 1969-12-31 2024-02-10 -719162 0001-01-01 2932896
var roundTrip = true
for (n in -800000..800000 step 997) { roundTrip = roundTrip and LocalDate.fromEpochDays(n).epochDays == n }
print(roundTrip, (LocalDate(2024, 3, 1).epochDays - LocalDate(1999, 12, 31).epochDays))   // expect: true 8827

// int.floorDiv: Kotlin's, beside int.mod.
print((-7).floorDiv(2), 7.floorDiv(-2), 7.floorDiv(2), (-8).floorDiv(2), (-7).mod(2), int.minValue.floorDiv(1))
// expect: -4 -4 3 -4 1 -9223372036854775808
for (pair in [Pair(int.minValue, -1), Pair(5, 0)]) {
  try { print(pair.first.floorDiv(pair.second)) } catch (e : ArithmeticException) { print("ArithmeticException") }
}
// expect: ArithmeticException
// expect: ArithmeticException

// split with Kotlin's limit: at most that many parts, the last the rest.
print("a,b,,c".split(",", limit = 2), "a,b,,c".split(","), "a,b".split(",", 1), "abc".split("", 2), "a,b,c".split(',', 2), "".split(",", 3))
// expect: ["a", "b,,c"] ["a", "b", "", "c"] ["a,b"] ["a", "bc"] ["a", "b,c"] [""]
try { print("a".split(",", -1)) } catch (e : IllegalArgumentException) { print("IllegalArgumentException") }
// expect: IllegalArgumentException

// BigInt to and from bytes, as C#'s, Java's and Python's.
print(BigInt.fromBytes(Bytes([1, 0])), BigInt.fromBytes(Bytes([255]), signed = true), BigInt.fromBytes(Bytes([0, 1]), bigEndian = false), BigInt.fromBytes(Bytes([])), BigInt.fromBytes(Bytes([128, 0]), signed = true))
// expect: 256 -1 256 0 -32768
print(BigInt.of(256).toBytes().toList(), BigInt.of(-1).toBytes(signed = true).toList(), BigInt.of(128).toBytes(signed = true).toList(), BigInt.of(0).toBytes().toList(), BigInt.of(-129).toBytes(signed = true).toList(), BigInt.of(258).toBytes(bigEndian = false).toList())
// expect: [1, 0] [255] [0, 128] [0] [255, 127] [2, 1]
val big = BigInt.parse("123456789012345678901234567890123456789")
print(BigInt.fromBytes(big.toBytes()) == big, BigInt.fromBytes((-big).toBytes(signed = true), signed = true) == -big, big.toBytes().toHex())
// expect: true true 5ce0e9a56015fec5aadfa328ae398115
try { print(BigInt.of(-1).toBytes()) } catch (e : ArithmeticException) { print("ArithmeticException") }
// expect: ArithmeticException

// Deck.add(index, item): Kotlin's ArrayDeque.add(index, element).
val q = Deck<int>()
q.addAll([1, 2, 3])
q.add(1, 9)
q.add(0, 7)
q.add(5, 8)
print(q, q.size, q.first(), q.last())   // expect: [7, 1, 9, 2, 3, 8] 6 7 8
try { q.add(9, 0) } catch (e : IndexOutOfBoundsException) { print("IndexOutOfBoundsException") }
// expect: IndexOutOfBoundsException

// List.removeRange: Java's and Kotlin's subList(from, to).clear(), C#'s RemoveRange.
val l = [0, 1, 2, 3, 4, 5, 6]
l.removeRange(1, 3)
l.removeRange(2, 2)
l.removeRange(3, l.size)
print(l)   // expect: [0, 3, 4]
for (r in [Pair(2, 1), Pair(-1, 1), Pair(0, 9)]) {
  try { l.removeRange(r.first, r.second) } catch (e : IndexOutOfBoundsException) { print("IndexOutOfBoundsException") }
}
// expect: IndexOutOfBoundsException
// expect: IndexOutOfBoundsException
// expect: IndexOutOfBoundsException

// LocalDate.dayName and monthName: by number, as C#'s GetDayName and GetMonthName.
print(LocalDate.dayName(1), LocalDate.dayName(7, abbreviated = true), LocalDate.monthName(1), LocalDate.monthName(9, true), LocalDate(2024, 9, 1).format("EEEE MMMM"))
// expect: Monday Sun January Sep Sunday September
try { print(LocalDate.monthName(13)) } catch (e : IllegalArgumentException) { print("IllegalArgumentException") }
// expect: IllegalArgumentException

// string.lineAndColumnAt: lines end at "\n", both counted from 1, as JSON's errors give them.
val text = "ab\ncd\n\nx"
print(text.lineAndColumnAt(0), text.lineAndColumnAt(3), text.lineAndColumnAt(5), text.lineAndColumnAt(7), text.lineAndColumnAt(text.size), "".lineAndColumnAt(0))
// expect: Pair(first=1, second=1) Pair(first=2, second=1) Pair(first=2, second=3) Pair(first=4, second=1) Pair(first=4, second=2) Pair(first=1, second=1)
try { Json.read("{\"a\": 1,\n  \"b\": ]") } catch (e : JsonParseException) { print(e.line, e.column, e.position) }
// expect: 2 8 16
